#. type: Plain text
#: original/man1/cifsiostat.1:153
msgid "I</proc >filesystem must be mounted for B<cifsiostat >to work."
msgstr ""

#. type: Plain text
#: original/man1/cifsiostat.1:157
msgid ""
"Although B<cifsiostat> displays units corresponding to kilobytes (kB), "
"megabytes (MB), gigabytes (GB)..., it actually uses kibibytes (kiB), "
"mebibytes (MiB), gibibytes (GiB)...  A kibibyte is equal to 1024 bytes, a "
"mebibyte is equal to 1024 kibibytes, and a gibibyte is equal to 1024 "
"mebibytes."
msgstr ""

