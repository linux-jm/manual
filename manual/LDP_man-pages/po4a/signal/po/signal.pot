#: build/C/man2/wait.2:19
#, no-wrap
msgid ""
"B<pid_t wait(int *_Nullable >I<wstatus>B<);>\n"
"B<pid_t waitpid(pid_t >I<pid>B<, int *_Nullable >I<wstatus>B<, int "
">I<options>B<);>\n"
msgstr ""

#. type: Plain text
#: build/C/man2/wait.2:24
#, no-wrap
msgid ""
"B<int waitid(idtype_t >I<idtype>B<, id_t >I<id>B<, siginfo_t *>I<infop>B<, "
"int >I<options>B<);>\n"
