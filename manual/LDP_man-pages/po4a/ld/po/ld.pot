#. type: Plain text
#: build/C/man3/dl_iterate_phdr.3:17
#, no-wrap
msgid ""
"B<#define _GNU_SOURCE>         /* See feature_test_macros(7) */\n"
"B<#include E<lt>link.hE<gt>>\n"
msgstr ""

#. type: Plain text
#: build/C/man3/dl_iterate_phdr.3:22
#, no-wrap
msgid ""
"B<int dl_iterate_phdr(>\n"
"B<         typeof(int (struct dl_phdr_info *>I<info>B<, size_t >I<size>B<, "
"void *>I<data>B<))>\n"
"B<             *>I<callback>B<,>\n"
"B<         void *>I<data>B<);>\n"
msgstr ""

#. type: SH
#: build/C/man3/dl_iterate_phdr.3:23 build/C/man3/dladdr.3:23
