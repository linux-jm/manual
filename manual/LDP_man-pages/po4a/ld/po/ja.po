"B<-ex \\[dq]set height 0\\[dq] \\[rs]>\n"
"B<-ex \\[dq]info shared\\[dq] \\[rs]>\n"
"B<-ex \\[dq]quit\\[dq] \\[rs]>\n"
"B<-p $pid \\[rs]>\n"
"B<| grep \\[aq]\\[ha]0x.*0x\\[aq]>;\n"
msgstr ""
"$ B<gdb -ex \"set confirm off\" -ex \"set height 0\" -ex \"info shared\" \\e>\n"
"        B<-ex \"quit\" -p $pid | grep \\(aq\\(ha0x.*0x\\(aq>\n"

