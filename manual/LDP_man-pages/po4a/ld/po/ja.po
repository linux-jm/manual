#. type: Plain text
#: build/C/man5/elf.5:1752
msgid "Size in bytes of PLT relocation entries"
msgstr "PLT 再配置 (relocation) エントリーのサイズ (バイト単位)"

#. type: TP
#: build/C/man5/elf.5:1752
#, no-wrap
msgid "B<DT_PLTGOT>"
msgstr "B<DT_PLTGOT>"

#. type: Plain text
#: build/C/man5/elf.5:1755
msgid "Address of PLT and/or GOT"
msgstr "PLT と GOT (または何れか一方) のアドレス"

#. type: TP
#: build/C/man5/elf.5:1755
#, no-wrap
msgid "B<DT_HASH>"
msgstr "B<DT_HASH>"

#. type: Plain text
#: build/C/man5/elf.5:1758
msgid "Address of symbol hash table"
msgstr "シンボルハッシュテーブルのアドレス"

#. type: TP
#: build/C/man5/elf.5:1758
#, no-wrap
msgid "B<DT_STRTAB>"
msgstr "B<DT_STRTAB>"

#. type: Plain text
#: build/C/man5/elf.5:1761
msgid "Address of string table"
msgstr "文字列テーブルのアドレス"

#. type: TP
#: build/C/man5/elf.5:1761
#, no-wrap
msgid "B<DT_SYMTAB>"
msgstr "B<DT_SYMTAB>"

#. type: Plain text
#: build/C/man5/elf.5:1764
msgid "Address of symbol table"
msgstr "シンボルテーブルのアドレス"

#. type: TP
#: build/C/man5/elf.5:1764
