#: build/C/man5/elf.5:1746
msgid "Marks end of dynamic section"
msgstr "動的セクションの終りのマーク"

#. type: TP
#: build/C/man5/elf.5:1746
#, no-wrap
msgid "B<DT_NEEDED>"
msgstr "B<DT_NEEDED>"

