#. type: Plain text
#: build/C/man1/memusage.1:302
#, no-wrap
msgid ""
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
"\\&\n"
"#define CYCLES 20\n"
"\\&\n"
"int\n"
"main(int argc, char *argv[])\n"
"{\n"
"    int i, j;\n"
"    size_t size;\n"
"    int *p;\n"
"\\&\n"
"    size = sizeof(*p) * 100;\n"
"    printf(\"malloc: %zu\\[rs]n\", size);\n"
"    p = malloc(size);\n"
"\\&\n"
"    for (i = 0; i E<lt> CYCLES; i++) {\n"
"        if (i E<lt> CYCLES / 2)\n"
"            j = i;\n"
"        else\n"
"            j--;\n"
"\\&\n"
"        size = sizeof(*p) * (j * 50 + 110);\n"
"        printf(\"realloc: %zu\\[rs]n\", size);\n"
"        p = realloc(p, size);\n"
"\\&\n"
"        size = sizeof(*p) * ((j + 1) * 150 + 110);\n"
"        printf(\"realloc: %zu\\[rs]n\", size);\n"
"        p = realloc(p, size);\n"
"    }\n"
"\\&\n"
"    free(p);\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"
msgstr ""

