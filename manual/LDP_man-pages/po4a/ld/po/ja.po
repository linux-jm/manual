#, no-wrap
msgid "B<EI_CLASS>"
msgstr "B<EI_CLASS>"

#. type: Plain text
#: build/C/man5/elf.5:198
msgid "The fifth byte identifies the architecture for this binary:"
msgstr "第 5 バイトは、このバイナリのアーキテクチャーを示す:"

#. type: TP
#: build/C/man5/elf.5:199
#, no-wrap
