"(1: \\[aq]E\\[aq])"
msgstr ""
"マジックナンバーの第 2 バイト。 B<ELFMAG1> で埋めなければならない。 (1: "
"\\(aqE\\(aq)"

#. type: TP
#: build/C/man5/elf.5:183
#, no-wrap
msgid "B<EI_MAG2>"
msgstr "B<EI_MAG2>"

