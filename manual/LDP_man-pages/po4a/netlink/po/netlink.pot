#: build/C/man7/rtnetlink.7:508
#, no-wrap
msgid ""
"struct rtvia {\n"
"    unsigned short rtvia_family;\n"
"    unsigned char  rtvia_addr[0];\n"
"};\n"
msgstr ""

#. type: Plain text
#: build/C/man7/rtnetlink.7:515
msgid "I<rtvia_addr> is the address, I<rtvia_family> is its family type."
msgstr ""

