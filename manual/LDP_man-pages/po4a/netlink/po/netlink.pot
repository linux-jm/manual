#, no-wrap
msgid ""
"B<unsigned int RTA_LENGTH(unsigned int >I<size>B<);>\n"
"B<unsigned int RTA_SPACE(unsigned int >I<size>B<);>\n"
msgstr ""

#. type: Plain text
#: build/C/man3/rtnetlink.3:40
msgid ""
"All B<rtnetlink>(7)  messages consist of a B<netlink>(7)  message header and "
"appended attributes.  The attributes should be manipulated only using the "
"macros provided here."
msgstr ""

#. type: Plain text
#: build/C/man3/rtnetlink.3:51
msgid ""
"B<RTA_OK(>I<rta>B<, >I<size>B<)> returns true if I<rta> points to a valid "
"routing attribute; I<size> is the running size of the attribute buffer.  "
"When not true then you must assume there are no more attributes in the "
"message, even if I<size> is nonzero."
msgstr ""

#. type: Plain text
#: build/C/man3/rtnetlink.3:54
msgid ""
"B<RTA_DATA(>I<rta>B<)> returns a pointer to the start of this attribute's "
"data."
msgstr ""

#. type: Plain text
#: build/C/man3/rtnetlink.3:57
msgid "B<RTA_PAYLOAD(>I<rta>B<)> returns the size of this attribute's data."
msgstr ""

#. type: Plain text
#: build/C/man3/rtnetlink.3:66
msgid ""
"B<RTA_NEXT(>I<rta>B<, >I<size>B<)> gets the next attribute after I<rta>.  "
"Calling this macro will update I<size>.  You should use B<RTA_OK> to check "
"the validity of the returned pointer."
msgstr ""

#. type: Plain text
#: build/C/man3/rtnetlink.3:71
msgid ""
"B<RTA_LENGTH(>I<size>B<)> returns the size which is required for I<size> "
"bytes of data plus the header."
msgstr ""

#. type: Plain text
#: build/C/man3/rtnetlink.3:76
msgid ""
"B<RTA_SPACE(>I<size>B<)> returns the amount of space which will be needed in "
"a message with I<size> bytes of data."
msgstr ""

