"I<errno> is set to B<EDOM>.  An invalid floating-point exception "
"(B<FE_INVALID>)  is raised (but see BUGS)."
msgstr ""

#. type: TP
#: build/C/man3/tgamma.3:121
#, no-wrap
msgid "Pole error: \\f[I]x\\fR is +0 or -0"
msgstr ""

