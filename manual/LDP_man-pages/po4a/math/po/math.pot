"B<nearbyint>(),\n"
"B<nearbyintf>(),\n"
"B<nearbyintl>(),\n"
"B<rint>(),\n"
"B<rintf>(),\n"
"B<rintl>()"
msgstr ""

#. type: Plain text
#: build/C/man3/rint.3:139
msgid ""
"If you want to store the rounded value in an integer type, you probably want "
"to use one of the functions described in B<lrint>(3)  instead."
msgstr ""

