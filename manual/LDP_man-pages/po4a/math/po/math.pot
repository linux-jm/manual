"a domain error occurs, and the return value is unspecified."
msgstr ""

#. type: TP
#: build/C/man3/lrint.3:66 build/C/man3/lround.3:69
#, no-wrap
msgid ""
"Domain error: \\f[I]x\\fR is a NaN or infinite, or the rounded value is too "
"large"
msgstr ""

