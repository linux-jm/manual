#. type: Plain text
#: build/C/man3/tgamma.3:50
msgid "Gamma(m+1) = m!"
msgstr ""

#. type: Plain text
#: build/C/man3/tgamma.3:54
msgid "and, more generally, for all I<x>:"
msgstr ""

#. type: Plain text
#: build/C/man3/tgamma.3:57
msgid "Gamma(x+1) = x * Gamma(x)"
msgstr ""

