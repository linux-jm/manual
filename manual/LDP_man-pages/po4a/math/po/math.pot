msgid ""
"isgreater, isgreaterequal, isless, islessequal, islessgreater, isunordered - "
"floating-point relational tests without exception for NaN"
msgstr ""

#. type: Plain text
#: build/C/man3/isgreater.3:24
#, no-wrap
msgid ""
"B<int isgreater(>I<x>B<, >I<y>B<);>\n"
"B<int isgreaterequal(>I<x>B<, >I<y>B<);>\n"
"B<int isless(>I<x>B<, >I<y>B<);>\n"
"B<int islessequal(>I<x>B<, >I<y>B<);>\n"
"B<int islessgreater(>I<x>B<, >I<y>B<);>\n"
"B<int isunordered(>I<x>B<, >I<y>B<);>\n"
msgstr ""

#. type: Plain text
#: build/C/man3/isgreater.3:34
#, no-wrap
msgid ""
"    All functions described here:\n"
"        _ISOC99_SOURCE || _POSIX_C_SOURCE E<gt>= 200112L\n"
msgstr ""

#. type: Plain text
#: build/C/man3/isgreater.3:42
msgid ""
"The normal relational operations (like B<E<lt>>, \"less than\")  fail if one "
"of the operands is NaN.  This will cause an exception.  To avoid this, C99 "
"defines the macros listed below."
msgstr ""

#. type: Plain text
#: build/C/man3/isgreater.3:48
msgid ""
"These macros are guaranteed to evaluate their arguments only once.  The "
"arguments must be of real floating-point type (note: do not pass integer "
"values as arguments to these macros, since the arguments will I<not> be "
"promoted to real-floating types)."
msgstr ""

#. type: TP
#: build/C/man3/isgreater.3:48
#, no-wrap
msgid "B<isgreater>()"
msgstr ""

#. type: Plain text
#: build/C/man3/isgreater.3:58
msgid "determines I<(x)\\ E<gt>\\ (y)> without an exception if I<x> or I<y> is NaN."
msgstr ""

#. type: TP
#: build/C/man3/isgreater.3:58
#, no-wrap
msgid "B<isgreaterequal>()"
msgstr ""

#. type: Plain text
#: build/C/man3/isgreater.3:68
msgid ""
"determines I<(x)\\ E<gt>=\\ (y)> without an exception if I<x> or I<y> is "
"NaN."
msgstr ""

#. type: TP
#: build/C/man3/isgreater.3:68
#, no-wrap
msgid "B<isless>()"
msgstr ""

#. type: Plain text
#: build/C/man3/isgreater.3:78
msgid "determines I<(x)\\ E<lt>\\ (y)> without an exception if I<x> or I<y> is NaN."
msgstr ""

#. type: TP
#: build/C/man3/isgreater.3:78
#, no-wrap
msgid "B<islessequal>()"
msgstr ""

#. type: Plain text
#: build/C/man3/isgreater.3:88
msgid ""
"determines I<(x)\\ E<lt>=\\ (y)> without an exception if I<x> or I<y> is "
"NaN."
msgstr ""

#. type: TP
#: build/C/man3/isgreater.3:88
#, no-wrap
msgid "B<islessgreater>()"
msgstr ""

#. type: Plain text
#: build/C/man3/isgreater.3:105
msgid ""
"determines I<(x)\\ E<lt>\\ (y)\\ ||\\ (x)\\ E<gt>\\ (y)> without an "
"exception if I<x> or I<y> is NaN.  This macro is not equivalent to I<x\\ "
"!=\\ y> because that expression is true if I<x> or I<y> is NaN."
msgstr ""

#. type: TP
#: build/C/man3/isgreater.3:105
#, no-wrap
msgid "B<isunordered>()"
msgstr ""

#. type: Plain text
#: build/C/man3/isgreater.3:109
msgid ""
"determines whether its arguments are unordered, that is, whether at least "
"one of the arguments is a NaN."
msgstr ""

#. type: Plain text
#: build/C/man3/isgreater.3:114
msgid ""
"The macros other than B<isunordered>()  return the result of the relational "
"comparison; these macros return 0 if either argument is a NaN."
msgstr ""

#. type: Plain text
#: build/C/man3/isgreater.3:121
msgid "B<isunordered>()  returns 1 if I<x> or I<y> is NaN and 0 otherwise."
msgstr ""

#. type: tbl table
#: build/C/man3/isgreater.3:140
#, no-wrap
msgid ""
"B<isgreater>(),\n"
"B<isgreaterequal>(),\n"
"B<isless>(),\n"
"B<islessequal>(),\n"
"B<islessgreater>(),\n"
"B<isunordered>()"
msgstr ""

