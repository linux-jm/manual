"        || _XOPEN_SOURCE\n"
"        || /* Since glibc 2.19: */ _DEFAULT_SOURCE\n"
"        || /* glibc E<lt>= 2.19: */ _BSD_SOURCE || _SVID_SOURCE\n"
msgstr ""

#. type: Plain text
#: build/C/man3/fpclassify.3:48
msgid "B<isinf>():"
msgstr ""

#. type: Plain text
#: build/C/man3/fpclassify.3:63
msgid ""
"Floating point numbers can have special values, such as infinite or NaN.  "
"With the macro B<fpclassify(>I<x>B<)> you can find out what type I<x> is.  "
"The macro takes any floating-point expression as argument.  The result is "
"one of the following values:"
msgstr ""

#. type: TP
#: build/C/man3/fpclassify.3:63
#, no-wrap
msgid "B<FP_NAN>"
msgstr ""

#. type: Plain text
#: build/C/man3/fpclassify.3:67
msgid "I<x> is \"Not a Number\"."
msgstr ""

#. type: TP
#: build/C/man3/fpclassify.3:67
#, no-wrap
msgid "B<FP_INFINITE>"
msgstr ""

#. type: Plain text
#: build/C/man3/fpclassify.3:71
msgid "I<x> is either positive infinity or negative infinity."
msgstr ""

#. type: TP
#: build/C/man3/fpclassify.3:71
#, no-wrap
msgid "B<FP_ZERO>"
msgstr ""

#. type: Plain text
#: build/C/man3/fpclassify.3:75
msgid "I<x> is zero."
msgstr ""

#. type: TP
#: build/C/man3/fpclassify.3:75
#, no-wrap
msgid "B<FP_SUBNORMAL>"
msgstr ""

#. type: Plain text
#: build/C/man3/fpclassify.3:79
msgid "I<x> is too small to be represented in normalized format."
msgstr ""

#. type: TP
#: build/C/man3/fpclassify.3:79
#, no-wrap
msgid "B<FP_NORMAL>"
msgstr ""

#. type: Plain text
#: build/C/man3/fpclassify.3:83
msgid ""
"if nothing of the above is correct then it must be a normal floating-point "
"number."
msgstr ""

#. type: Plain text
#: build/C/man3/fpclassify.3:85
msgid "The other macros provide a short answer to some standard questions."
msgstr ""

#. type: TP
#: build/C/man3/fpclassify.3:85
#, no-wrap
msgid "B<isfinite(>I<x>B<)>"
msgstr ""

#. type: Plain text
#: build/C/man3/fpclassify.3:88
msgid "returns a nonzero value if"
msgstr ""

#. type: Plain text
#: build/C/man3/fpclassify.3:90
msgid "(fpclassify(x) != FP_NAN && fpclassify(x) != FP_INFINITE)"
msgstr ""

#. type: TP
#: build/C/man3/fpclassify.3:90
#, no-wrap
msgid "B<isnormal(>I<x>B<)>"
msgstr ""

#. type: Plain text
#: build/C/man3/fpclassify.3:94
msgid "returns a nonzero value if (fpclassify(x) == FP_NORMAL)"
msgstr ""

#. type: TP
#: build/C/man3/fpclassify.3:94
#, no-wrap
msgid "B<isnan(>I<x>B<)>"
msgstr ""

#. type: Plain text
#: build/C/man3/fpclassify.3:98
msgid "returns a nonzero value if (fpclassify(x) == FP_NAN)"
msgstr ""

#. type: TP
#: build/C/man3/fpclassify.3:98
#, no-wrap
msgid "B<isinf(>I<x>B<)>"
msgstr ""

#. type: Plain text
#: build/C/man3/fpclassify.3:105
msgid "returns 1 if I<x> is positive infinity, and -1 if I<x> is negative infinity."
msgstr ""

#. type: tbl table
#: build/C/man3/fpclassify.3:121
#, no-wrap
msgid ""
"B<fpclassify>(),\n"
"B<isfinite>(),\n"
"B<isnormal>(),\n"
"B<isnan>(),\n"
"B<isinf>()"
msgstr ""

#. type: Plain text
#: build/C/man3/fpclassify.3:127 build/C/man3/isgreater.3:151
#: build/C/man3/signbit.3:74
msgid "POSIX.1-2001, C99."
msgstr ""

#. type: Plain text
#: build/C/man3/fpclassify.3:134
msgid ""
"In glibc 2.01 and earlier, B<isinf>()  returns a nonzero value (actually: 1) "
"if I<x> is positive infinity or negative infinity.  (This is all that C99 "
"requires.)"
msgstr ""

#. type: Plain text
#: build/C/man3/fpclassify.3:139
msgid ""
"For B<isinf>(), the standards merely say that the return value is nonzero if "
"and only if the argument has an infinite value."
msgstr ""

#. type: Plain text
#: build/C/man3/fpclassify.3:143
msgid "B<finite>(3), B<INFINITY>(3), B<isgreater>(3), B<signbit>(3)"
msgstr ""

