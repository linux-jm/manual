msgstr ""

#. type: Plain text
#: build/C/man3/strsep.3:85
msgid ""
"The B<strsep>()  function was introduced as a replacement for B<strtok>(3), "
"since the latter cannot handle empty fields."
msgstr ""

#. type: Plain text
#: build/C/man3/strsep.3:88 build/C/man3/strtok.3:127
msgid "Be cautious when using this function.  If you do use it, note that:"
msgstr ""

#. type: Plain text
#: build/C/man3/strsep.3:90
msgid "The identity of the delimiting character is lost."
msgstr ""

#. type: Plain text
#: build/C/man3/strsep.3:94
msgid ""
"The program below is a port of the one found in B<strtok>(3), which, "
"however, doesn't discard multiple delimiters or empty tokens:"
msgstr ""

#. type: Plain text
#: build/C/man3/strsep.3:110
#, no-wrap
msgid ""
"$B< ./a.out \\[aq]a/bbb///cc;xxx:yyy:\\[aq] \\[aq]:;\\[aq] \\[aq]/\\[aq]>\n"
"1: a/bbb///cc\n"
"         --E<gt> a\n"
"         --E<gt> bbb\n"
"         --E<gt>\n"
"         --E<gt>\n"
"         --E<gt> cc\n"
"2: xxx\n"
"         --E<gt> xxx\n"
"3: yyy\n"
"         --E<gt> yyy\n"
"4:\n"
"         --E<gt>\n"
msgstr ""

#. type: Plain text
#: build/C/man3/strsep.3:139
#, no-wrap
msgid ""
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
"#include E<lt>string.hE<gt>\n"
"\\&\n"
"int\n"
"main(int argc, char *argv[])\n"
"{\n"
"    char *token, *subtoken;\n"
"\\&\n"
"    if (argc != 4) {\n"
"        fprintf(stderr, \"Usage: %s string delim subdelim\\[rs]n\", "
"argv[0]);\n"
"        exit(EXIT_FAILURE);\n"
"    }\n"
"\\&\n"
"    for (unsigned int j = 1; (token = strsep(&argv[1], argv[2])); j++) {\n"
"        printf(\"%u: %s\\[rs]n\", j, token);\n"
"\\&\n"
"        while ((subtoken = strsep(&token, argv[3])))\n"
"            printf(\"\\[rs]t --E<gt> %s\\[rs]n\", subtoken);\n"
"    }\n"
"\\&\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"
msgstr ""

