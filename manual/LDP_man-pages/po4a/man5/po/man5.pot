msgstr ""

#.  from Linux 2.5.45 to Linux 2.5.70
#. type: Plain text
#: build/C/man5/slabinfo.5:199
msgid "A format that was briefly present in the Linux 2.5 development series."
msgstr ""

#. type: TP
#: build/C/man5/slabinfo.5:199
#, no-wrap
