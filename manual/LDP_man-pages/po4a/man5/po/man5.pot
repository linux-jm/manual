msgstr ""

#.  First appeared in Linux 2.5.71
#. type: Plain text
#: build/C/man5/slabinfo.5:203
msgid "Present in Linux 2.6.x kernels up to and including Linux 2.6.9."
msgstr ""

#. type: TP
#: build/C/man5/slabinfo.5:203
#, no-wrap
msgid "2.1"
msgstr ""

#. type: Plain text
#: build/C/man5/slabinfo.5:206
msgid "The current format, which first appeared in Linux 2.6.10."
msgstr ""

#. type: Plain text
#: build/C/man5/slabinfo.5:212
msgid ""
"Only root can read and (if the kernel was configured with B<CONFIG_SLAB>)  "
"write the I</proc/slabinfo> file."
msgstr ""

#. type: Plain text
#: build/C/man5/slabinfo.5:217
msgid ""
"The total amount of memory allocated to the SLAB/SLUB cache is shown in the "
"I<Slab> field of I</proc/meminfo>."
msgstr ""

#. type: Plain text
#: build/C/man5/slabinfo.5:219
msgid "B<slabtop>(1)"
msgstr ""

#. type: Plain text
#: build/C/man5/slabinfo.5:223
msgid ""
"The kernel source file I<Documentation/mm/slab.rst> and "
"I<tools/mm/slabinfo.c>."
msgstr ""
