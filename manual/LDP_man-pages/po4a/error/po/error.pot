msgstr ""

#. type: Plain text
#: build/C/man3/static_assert.3:43
msgid "C23."
msgstr ""

#. type: Plain text
#: build/C/man3/static_assert.3:45
msgid "C11."
msgstr ""

#. type: Plain text
#: build/C/man3/static_assert.3:52
msgid ""
"In C11, the second argument (I<msg>)  was mandatory; since C23, it can be "
"omitted."
msgstr ""

#. type: Plain text
#: build/C/man3/static_assert.3:62
msgid ""
"B<static_assert>()  can't be used in some places, like for example at global "
"scope.  For that, a macro B<\\%must_be>()  can be written in terms of "
"B<\\%static_assert>().  The following program uses the macro to get the size "
"of an array safely."
msgstr ""

#. type: Plain text
#: build/C/man3/static_assert.3:116
#, no-wrap
msgid ""
"#include E<lt>assert.hE<gt>\n"
"#include E<lt>stdint.hE<gt>\n"
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
"#include E<lt>string.hE<gt>\n"
"\\&\n"
"/*\n"
" * This macro behaves like static_assert(), failing to\n"
" * compile if its argument is not true.  However, it always\n"
" * returns 0, which allows using it everywhere an expression\n"
" * can be used.\n"
" */\n"
"#define must_be(e)                                        \\[rs]\n"
"(                                                         \\[rs]\n"
"    0 * (int) sizeof(                                     \\[rs]\n"
"        struct {                                          \\[rs]\n"
"            static_assert(e);                             \\[rs]\n"
"            int  ISO_C_forbids_a_struct_with_no_members;  \\[rs]\n"
"        }                                                 \\[rs]\n"
"    )                                                     \\[rs]\n"
")\n"
"\\&\n"
"#define is_same_type(a, b)  \\[rs]\n"
"    __builtin_types_compatible_p(typeof(a), typeof(b))\n"
"\\&\n"
"#define is_array(arr)       (!is_same_type((arr), &*(arr)))\n"
"#define must_be_array(arr)  must_be(is_array(arr))\n"
"\\&\n"
"#define sizeof_array(arr)   (sizeof(arr) + must_be_array(arr))\n"
"#define NITEMS(arr)         (sizeof((arr)) / sizeof((arr)[0]) \\[rs]\n"
"                             + must_be_array(arr))\n"
"\\&\n"
"int     foo[10];\n"
"int8_t  bar[sizeof_array(foo)];\n"
"\\&\n"
"int\n"
"main(void)\n"
"{\n"
"    for (size_t i = 0; i E<lt> NITEMS(foo); i++) {\n"
"        foo[i] = i;\n"
"    }\n"
"\\&\n"
"    memcpy(bar, foo, sizeof_array(bar));\n"
"\\&\n"
"    for (size_t i = 0; i E<lt> NITEMS(bar); i++) {\n"
"        printf(\"%d,\", bar[i]);\n"
"    }\n"
"\\&\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"
msgstr ""

#. type: Plain text
#: build/C/man3/static_assert.3:120
msgid "B<assert>(3)"
msgstr ""
