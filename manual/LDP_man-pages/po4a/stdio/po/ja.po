#~ "        exit(EXIT_SUCCESS);\n"
#~ "    }\n"
#~ "}\n"
#~ msgstr ""
#~ "    } else {            /* 親プロセスは argv[1] をパイプへ書き込む */\n"
#~ "        close(pipefd[0]);          /* 使用しない read 側はクローズする */\n"
#~ "        write(pipefd[1], argv[1], strlen(argv[1]));\n"
#~ "        close(pipefd[1]);          /* 読み込み側が EOF に出会う */\n"
#~ "        wait(NULL);                /* 子プロセスを待つ */\n"
#~ "        exit(EXIT_SUCCESS);\n"
#~ "    }\n"
#~ "}\n"

