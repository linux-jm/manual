#.  getw_unlocked, getwc_unlocked, getwchar_unlocked, putc_unlocked,
#.  putchar_unlocked, puts_unlocked, putws_unlocked, putw_unlocked,
#.  putwc_unlocked, putwchar_unlocked, rewind_unlocked, setvbuf_unlocked,
#.  ungetc_unlocked, ungetwc_unlocked.
#. type: Plain text
#: build/C/man3/fileno.3:78 build/C/man3/flockfile.3:129
#: build/C/man3/fopen.3:299 build/C/man2/pipe.2:212 build/C/man3/popen.3:177
#: build/C/man3/unlocked_stdio.3:205
msgid "POSIX.1-2001."
msgstr ""

#. type: Plain text
#: build/C/man3/fileno.3:82
