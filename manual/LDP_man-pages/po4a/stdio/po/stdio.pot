#. type: TH
#: build/C/man3/getline.3:7
#, no-wrap
msgid "getline"
msgstr ""

#. type: Plain text
#: build/C/man3/getline.3:10
msgid "getline, getdelim - delimited string input"
msgstr ""

#. type: Plain text
#: build/C/man3/getline.3:21
#, no-wrap
msgid ""
"B<ssize_t getline(char **restrict >I<lineptr>B<, size_t *restrict "
">I<n>B<,>\n"
"B<                FILE *restrict >I<stream>B<);>\n"
"B<ssize_t getdelim(char **restrict >I<lineptr>B<, size_t *restrict "
">I<n>B<,>\n"
"B<                int >I<delim>B<, FILE *restrict >I<stream>B<);>\n"
msgstr ""

#. type: Plain text
#: build/C/man3/getline.3:30
msgid "B<getline>(), B<getdelim>():"
msgstr ""

#. type: Plain text
#: build/C/man3/getline.3:44
msgid ""
"B<getline>()  reads an entire line from I<stream>, storing the address of "
"the buffer containing the text into I<*lineptr>.  The buffer is "
"null-terminated and includes the newline character, if one was found."
msgstr ""

#. type: Plain text
#: build/C/man3/getline.3:54
msgid ""
"If I<*lineptr> is set to NULL before the call, then B<getline>()  will "
"allocate a buffer for storing the line.  This buffer should be freed by the "
"user program even if B<getline>()  failed."
msgstr ""

#. type: Plain text
#: build/C/man3/getline.3:72
msgid ""
"Alternatively, before calling B<getline>(), I<*lineptr> can contain a "
"pointer to a B<malloc>(3)-allocated buffer I<*n> bytes in size.  If the "
"buffer is not large enough to hold the line, B<getline>()  resizes it with "
"B<realloc>(3), updating I<*lineptr> and I<*n> as necessary."
msgstr ""

#. type: Plain text
#: build/C/man3/getline.3:78
msgid ""
"In either case, on a successful call, I<*lineptr> and I<*n> will be updated "
"to reflect the buffer address and allocated size respectively."
msgstr ""

#. type: Plain text
#: build/C/man3/getline.3:89
msgid ""
"B<getdelim>()  works like B<getline>(), except that a line delimiter other "
"than newline can be specified as the I<delimiter> argument.  As with "
"B<getline>(), a delimiter character is not added if one was not present in "
"the input before end of file was reached."
msgstr ""

#. type: Plain text
#: build/C/man3/getline.3:98
msgid ""
"On success, B<getline>()  and B<getdelim>()  return the number of characters "
"read, including the delimiter character, but not including the terminating "
"null byte (\\[aq]\\[rs]0\\[aq]).  This value can be used to handle embedded "
"null bytes in the line read."
msgstr ""

#. type: Plain text
#: build/C/man3/getline.3:106
msgid ""
"At end of file, both functions return -1 with the file stream end-of-file "
"indicator set.  On error, both functions return -1 with the file stream "
"error indicator set, and I<errno> is set to indicate the error."
msgstr ""

#. type: Plain text
#: build/C/man3/getline.3:111
msgid ""
"If I<*lineptr> was set to NULL before the call, then the buffer should be "
"freed by the user program even on failure."
msgstr ""

#. type: Plain text
#: build/C/man3/getline.3:121
msgid "Bad arguments (I<n> or I<lineptr> is NULL, or I<stream> is not valid)."
msgstr ""

#. type: TP
#: build/C/man3/getline.3:121 build/C/man2/link.2:217 build/C/man2/open.2:1185
#: build/C/man2/open.2:1193 build/C/man2/readlink.2:170
#: build/C/man2/rename.2:361 build/C/man2/rmdir.2:69 build/C/man3/scanf.3:118
#: build/C/man2/symlink.2:188 build/C/man3/tempnam.3:88
#: build/C/man2/unlink.2:176 build/C/man3/wprintf.3:225
#, no-wrap
msgid "B<ENOMEM>"
msgstr ""

#. type: Plain text
#: build/C/man3/getline.3:124
msgid "Allocation or reallocation of the line buffer failed."
msgstr ""

#. type: tbl table
#: build/C/man3/getline.3:137
#, no-wrap
msgid ""
"B<getline>(),\n"
"B<getdelim>()"
msgstr ""

#. type: Plain text
#: build/C/man3/getline.3:143 build/C/man3/printf.3:933
#: build/C/man3/printf.3:948
msgid "GNU, POSIX.1-2008."
msgstr ""

#. type: Plain text
#: build/C/man3/getline.3:178
#, no-wrap
msgid ""
"#define _GNU_SOURCE\n"
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
"\\&\n"
"int\n"
"main(int argc, char *argv[])\n"
"{\n"
"    FILE *stream;\n"
"    char *line = NULL;\n"
"    size_t size = 0;\n"
"    ssize_t nread;\n"
"\\&\n"
"    if (argc != 2) {\n"
"        fprintf(stderr, \"Usage: %s E<lt>fileE<gt>\\[rs]n\", argv[0]);\n"
"        exit(EXIT_FAILURE);\n"
"    }\n"
"\\&\n"
"    stream = fopen(argv[1], \"r\");\n"
"    if (stream == NULL) {\n"
"        perror(\"fopen\");\n"
"        exit(EXIT_FAILURE);\n"
"    }\n"
"\\&\n"
"    while ((nread = getline(&line, &size, stream)) != -1) {\n"
"        printf(\"Retrieved line of length %zd:\\[rs]n\", nread);\n"
"        fwrite(line, nread, 1, stdout);\n"
"    }\n"
"\\&\n"
"    free(line);\n"
"    fclose(stream);\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"
msgstr ""

#. type: Plain text
#: build/C/man3/getline.3:185
msgid "B<read>(2), B<fgets>(3), B<fopen>(3), B<fread>(3), B<scanf>(3)"
msgstr ""

#. type: TH
#: build/C/man3/gets.3:7
#, no-wrap
msgid "gets"
msgstr ""

#. type: Plain text
#: build/C/man3/gets.3:10
msgid "gets - get a string from standard input (DEPRECATED)"
msgstr ""

#. type: Plain text
#: build/C/man3/gets.3:18
#, no-wrap
msgid "B<[[deprecated]] char *gets(char *>I<s>B<);>\n"
msgstr ""

#. type: Plain text
#: build/C/man3/gets.3:21
msgid "I<Never use this function>."
msgstr ""

#. type: Plain text
#: build/C/man3/gets.3:31
msgid ""
"B<gets>()  reads a line from I<stdin> into the buffer pointed to by I<s> "
"until either a terminating newline or B<EOF>, which it replaces with a null "
"byte (\\[aq]\\[rs]0\\[aq]).  No check for buffer overrun is performed (see "
"BUGS below)."
msgstr ""

#. type: Plain text
#: build/C/man3/gets.3:39
msgid ""
"B<gets>()  returns I<s> on success, and NULL on error or when end of file "
"occurs while no characters have been read.  However, given the lack of "
"buffer overrun checking, there can be no guarantees that the function will "
"even return."
msgstr ""

#. type: tbl table
#: build/C/man3/gets.3:51
#, no-wrap
msgid "B<gets>()"
msgstr ""

#. type: Plain text
#: build/C/man3/gets.3:69
msgid ""
"LSB deprecates B<gets>().  POSIX.1-2008 marks B<gets>()  obsolescent.  ISO "
"C11 removes the specification of B<gets>()  from the C language, and since "
"glibc 2.16, glibc header files don't expose the function declaration if the "
"B<_ISOC11_SOURCE> feature test macro is defined."
msgstr ""

#. type: Plain text
#: build/C/man3/gets.3:83
msgid ""
"Never use B<gets>().  Because it is impossible to tell without knowing the "
"data in advance how many characters B<gets>()  will read, and because "
"B<gets>()  will continue to store characters past the end of the buffer, it "
"is extremely dangerous to use.  It has been used to break computer "
"security.  Use B<fgets>()  instead."
msgstr ""

#. type: Plain text
#: build/C/man3/gets.3:87
msgid ""
"For more information, see CWE-242 (aka \"Use of Inherently Dangerous "
"Function\") at http://cwe.mitre.org/data/definitions/242.html"
msgstr ""

#. type: Plain text
#: build/C/man3/gets.3:104
msgid ""
"B<read>(2), B<write>(2), B<ferror>(3), B<fgetc>(3), B<fgets>(3), "
"B<fgetwc>(3), B<fgetws>(3), B<fopen>(3), B<fread>(3), B<fseek>(3), "
"B<getline>(3), B<getwchar>(3), B<puts>(3), B<scanf>(3), B<ungetwc>(3), "
"B<unlocked_stdio>(3), B<feature_test_macros>(7)"
msgstr ""

#. type: TH
#: build/C/man3/getw.3:7
#, no-wrap
msgid "getw"
msgstr ""

#. type: Plain text
#: build/C/man3/getw.3:10
msgid "getw, putw - input and output of words (ints)"
msgstr ""

#. type: Plain text
#: build/C/man3/getw.3:19
#, no-wrap
msgid ""
"B<int getw(FILE *>I<stream>B<);>\n"
"B<int putw(int >I<w>B<, FILE *>I<stream>B<);>\n"
msgstr ""

#. type: Plain text
#: build/C/man3/getw.3:28
msgid "B<getw>(), B<putw>():"
msgstr ""

#. type: Plain text
#: build/C/man3/getw.3:35
#, no-wrap
msgid ""
"    Since glibc 2.3.3:\n"
"        _XOPEN_SOURCE && ! (_POSIX_C_SOURCE E<gt>= 200112L)\n"
"            || /* glibc E<gt>= 2.19: */ _DEFAULT_SOURCE\n"
"            || /* glibc E<lt>= 2.19: */ _BSD_SOURCE || _SVID_SOURCE\n"
"    Before glibc 2.3.3:\n"
"        _SVID_SOURCE || _BSD_SOURCE || _XOPEN_SOURCE\n"
msgstr ""

#. type: Plain text
#: build/C/man3/getw.3:46
msgid ""
"B<getw>()  reads a word (that is, an I<int>)  from I<stream>.  It's provided "
"for compatibility with SVr4.  We recommend you use B<fread>(3)  instead."
msgstr ""

#. type: Plain text
#: build/C/man3/getw.3:58
msgid ""
"B<putw>()  writes the word I<w> (that is, an I<int>)  to I<stream>.  It is "
"provided for compatibility with SVr4, but we recommend you use B<fwrite>(3)  "
"instead."
msgstr ""

#. type: Plain text
#: build/C/man3/getw.3:66
msgid ""
"Normally, B<getw>()  returns the word read, and B<putw>()  returns 0.  On "
"error, they return B<EOF>."
msgstr ""

#. type: tbl table
#: build/C/man3/getw.3:79
#, no-wrap
msgid ""
"B<getw>(),\n"
"B<putw>()"
msgstr ""

#. type: Plain text
#: build/C/man3/getw.3:85
msgid "SVr4, SUSv2."
msgstr ""

#. type: Plain text
#: build/C/man3/getw.3:89
msgid ""
"The value returned on error is also a legitimate data value.  B<ferror>(3)  "
"can be used to distinguish between the two cases."
msgstr ""

#. type: Plain text
#: build/C/man3/getw.3:94
msgid "B<ferror>(3), B<fread>(3), B<fwrite>(3), B<getc>(3), B<putc>(3)"
msgstr ""

#. type: TH
#: build/C/man2/link.2:8
#, no-wrap
msgid "link"
msgstr ""

#. type: TH
#: build/C/man2/link.2:8 build/C/man2/lseek.2:7
#, no-wrap
msgid "2026-02-11"
msgstr ""

#. type: Plain text
#: build/C/man2/link.2:11
msgid "link, linkat - make a new name for a file"
msgstr ""

#. type: Plain text
#: build/C/man2/link.2:17 build/C/man2/lseek.2:16 build/C/man2/pipe.2:15
#: build/C/man2/pipe.2:28 build/C/man2/read.2:16 build/C/man2/readlink.2:17
#: build/C/man2/rmdir.2:16 build/C/man2/symlink.2:16 build/C/man2/unlink.2:17
#: build/C/man2/write.2:17
#, no-wrap
msgid "B<#include E<lt>unistd.hE<gt>>\n"
msgstr ""

#. type: Plain text
#: build/C/man2/link.2:19
#, no-wrap
msgid "B<int link(const char *>I<oldpath>B<, const char *>I<newpath>B<);>\n"
msgstr ""

#. type: Plain text
#: build/C/man2/link.2:22 build/C/man2/symlink.2:21 build/C/man2/unlink.2:22
#, no-wrap
msgid ""
"B<#include E<lt>fcntl.hE<gt>           >/* Definition of B<AT_*> constants "
"*/\n"
"B<#include E<lt>unistd.hE<gt>>\n"
msgstr ""

#. type: Plain text
#: build/C/man2/link.2:25
#, no-wrap
msgid ""
"B<int linkat(int >I<olddirfd>B<, const char *>I<oldpath>B<,>\n"
"B<           int >I<newdirfd>B<, const char *>I<newpath>B<, int "
">I<flags>B<);>\n"
msgstr ""

#. type: Plain text
#: build/C/man2/link.2:33
msgid "B<linkat>():"
msgstr ""

#. type: Plain text
#: build/C/man2/link.2:38 build/C/man2/open.2:43 build/C/man2/readlink.2:48
#: build/C/man2/symlink.2:44 build/C/man2/unlink.2:37
#, no-wrap
msgid ""
"    Since glibc 2.10:\n"
"        _POSIX_C_SOURCE E<gt>= 200809L\n"
"    Before glibc 2.10:\n"
"        _ATFILE_SOURCE\n"
msgstr ""

#. type: Plain text
#: build/C/man2/link.2:42
msgid ""
"B<link>()  creates a new link (also known as a hard link) to an existing "
"file."
msgstr ""

#. type: Plain text
#: build/C/man2/link.2:48
msgid "If I<newpath> exists, it will I<not> be overwritten."
msgstr ""

#. type: Plain text
#: build/C/man2/link.2:53
msgid ""
"This new name may be used exactly as the old one for any operation; both "
"names refer to the same file (and so have the same permissions and "
"ownership) and it is impossible to tell which name was the \"original\"."
msgstr ""

#. type: SS
#: build/C/man2/link.2:53
#, no-wrap
msgid "linkat()"
msgstr ""

#. type: Plain text
#: build/C/man2/link.2:59
msgid ""
"The B<linkat>()  system call operates in exactly the same way as B<link>(), "
"except for the differences described here."
msgstr ""

#. type: Plain text
#: build/C/man2/link.2:69
msgid ""
"If the pathname given in I<oldpath> is relative, then it is interpreted "
"relative to the directory referred to by the file descriptor I<olddirfd> "
"(rather than relative to the current working directory of the calling "
"process, as is done by B<link>()  for a relative pathname)."
msgstr ""

#. type: Plain text
#: build/C/man2/link.2:81
msgid ""
"If I<oldpath> is relative and I<olddirfd> is the special value B<AT_FDCWD>, "
"then I<oldpath> is interpreted relative to the current working directory of "
"the calling process (like B<link>())."
msgstr ""

#. type: Plain text
#: build/C/man2/link.2:87 build/C/man2/rename.2:132
msgid "If I<oldpath> is absolute, then I<olddirfd> is ignored."
msgstr ""

#. type: Plain text
#: build/C/man2/link.2:95 build/C/man2/rename.2:140
msgid ""
"The interpretation of I<newpath> is as for I<oldpath>, except that a "
"relative pathname is interpreted relative to the directory referred to by "
"the file descriptor I<newdirfd>."
msgstr ""

#. type: Plain text
#: build/C/man2/link.2:98
msgid "The following values can be bitwise ORed in I<flags>:"
msgstr ""

#. type: TP
#: build/C/man2/link.2:98
#, no-wrap
msgid "B<AT_EMPTY_PATH> (since Linux 2.6.39)"
msgstr ""

#.  commit 11a7b371b64ef39fc5fb1b6f2218eef7c4d035e3
#.  Before glibc 2.16, defining _ATFILE_SOURCE sufficed
#. type: Plain text
#: build/C/man2/link.2:126
msgid ""
"If I<oldpath> is an empty string, create a link to the file referenced by "
"I<olddirfd> (which may have been obtained using the B<open>(2)  B<O_PATH> "
"flag).  In this case, I<olddirfd> can refer to any type of file except a "
"directory.  This will generally not work if the file has a link count of "
"zero (files created with B<O_TMPFILE> and without B<O_EXCL> are an "
"exception).  The caller must have the B<CAP_DAC_READ_SEARCH> capability in "
"order to use this flag.  This flag is Linux-specific; define B<_GNU_SOURCE> "
"to obtain its definition."
msgstr ""

#. type: TP
#: build/C/man2/link.2:126
#, no-wrap
msgid "B<AT_SYMLINK_FOLLOW> (since Linux 2.6.18)"
msgstr ""

#. type: Plain text
#: build/C/man2/link.2:145
msgid ""
"By default, B<linkat>(), does not dereference I<oldpath> if it is a symbolic "
"link (like B<link>()).  The flag B<AT_SYMLINK_FOLLOW> can be specified in "
"I<flags> to cause I<oldpath> to be dereferenced if it is a symbolic link.  "
"If procfs is mounted, this can be used as an alternative to "
"B<AT_EMPTY_PATH>, like this:"
msgstr ""

#. type: Plain text
#: build/C/man2/link.2:150
#, no-wrap
msgid ""
"linkat(AT_FDCWD, \"/proc/self/fd/E<lt>fdE<gt>\", newdirfd,\n"
"       newname, AT_SYMLINK_FOLLOW);\n"
msgstr ""

#. type: Plain text
#: build/C/man2/link.2:156
msgid ""
"Before Linux 2.6.18, the I<flags> argument was unused, and had to be "
"specified as 0."
msgstr ""

#. type: Plain text
#: build/C/man2/link.2:161
msgid "See B<openat>(2)  for an explanation of the need for B<linkat>()."
msgstr ""

#. type: Plain text
#: build/C/man2/link.2:166 build/C/man3/remove.3:47 build/C/man2/rename.2:281
#: build/C/man2/rmdir.2:27 build/C/man2/symlink.2:131 build/C/man2/unlink.2:130
msgid ""
"On success, zero is returned.  On error, -1 is returned, and I<errno> is set "
"to indicate the error."
msgstr ""

#. type: TP
#: build/C/man2/link.2:167 build/C/man2/open.2:982 build/C/man2/open.2:991
#: build/C/man2/readlink.2:126 build/C/man2/rename.2:282
#: build/C/man2/rmdir.2:28 build/C/man2/symlink.2:132 build/C/man3/tmpfile.3:36
#: build/C/man2/unlink.2:131
#, no-wrap
msgid "B<EACCES>"
msgstr ""

#. type: Plain text
#: build/C/man2/link.2:178
msgid ""
"Write access to the directory containing I<newpath> is denied, or search "
"permission is denied for one of the directories in the path prefix of "
"I<oldpath> or I<newpath>.  (See also B<path_resolution>(7).)"
msgstr ""

#. type: TP
#: build/C/man2/link.2:178 build/C/man2/open.2:1027 build/C/man2/rename.2:318
#: build/C/man2/symlink.2:150 build/C/man2/write.2:144
#, no-wrap
msgid "B<EDQUOT>"
msgstr ""

#. type: Plain text
#: build/C/man2/link.2:181 build/C/man2/rename.2:321
msgid "The user's quota of disk blocks on the filesystem has been exhausted."
msgstr ""

#. type: TP
#: build/C/man2/link.2:181 build/C/man2/open.2:1033 build/C/man2/rename.2:443
#: build/C/man2/symlink.2:155 build/C/man3/tmpfile.3:39
#, no-wrap
msgid "B<EEXIST>"
msgstr ""

#. type: Plain text
#: build/C/man2/link.2:185
msgid "I<newpath> already exists."
msgstr ""

#. type: TP
