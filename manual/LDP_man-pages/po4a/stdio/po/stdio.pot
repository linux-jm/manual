#. type: TP
#: build/C/man3/fmtmsg.3:130
#, no-wrap
msgid "B<MM_ERROR>"
msgstr ""

#. type: Plain text
#: build/C/man3/fmtmsg.3:133
msgid "This value is printed as ERROR."
msgstr ""

#. type: TP
#: build/C/man3/fmtmsg.3:133
#, no-wrap
msgid "B<MM_WARNING>"
msgstr ""

#. type: Plain text
#: build/C/man3/fmtmsg.3:136
msgid "This value is printed as WARNING."
msgstr ""

#. type: TP
#: build/C/man3/fmtmsg.3:136
#, no-wrap
msgid "B<MM_INFO>"
msgstr ""

#. type: Plain text
#: build/C/man3/fmtmsg.3:139
