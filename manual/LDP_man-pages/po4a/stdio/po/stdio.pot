#: build/C/man2/open.2:300
msgid "00400 user has read permission"
msgstr ""

#. type: TP
#: build/C/man2/open.2:300
#, no-wrap
msgid "B<S_IWUSR>"
msgstr ""

#. type: Plain text
#: build/C/man2/open.2:303
