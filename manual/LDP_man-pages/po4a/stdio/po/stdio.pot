msgstr ""

#. type: TP
#: build/C/man3/fmtmsg.3:92
#, no-wrap
msgid "B<MM_HARD>"
msgstr ""

#. type: Plain text
#: build/C/man3/fmtmsg.3:95
msgid "A hardware error occurred."
msgstr ""

#. type: TP
#: build/C/man3/fmtmsg.3:95
#, no-wrap
