#, no-wrap
msgid ""
"B<int printf(const char *restrict >I<format>B<, ...);>\n"
"B<int fprintf(FILE *restrict >I<stream>B<,>\n"
"B<            const char *restrict >I<format>B<, ...);>\n"
"B<int dprintf(int >I<fd>B<,>\n"
"B<            const char *restrict >I<format>B<, ...);>\n"
msgstr ""

