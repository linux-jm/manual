#: build/C/man2/open.2:620 build/C/man2/open.2:625 build/C/man2/open.2:631
#: build/C/man2/open.2:637 build/C/man2/open.2:643 build/C/man2/open.2:656
#: build/C/man2/open.2:836 build/C/man2/open.2:845 build/C/man2/open.2:908
#: build/C/man2/open.2:914 build/C/man2/open.2:926 build/C/man2/open.2:1681
