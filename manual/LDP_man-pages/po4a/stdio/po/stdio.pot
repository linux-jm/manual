#: build/C/man2/llseek.2:77
msgid "Problem with copying results to user space."
msgstr ""

#. type: Plain text
#: build/C/man2/llseek.2:81
msgid "I<whence> is invalid."
msgstr ""

#. type: Plain text
#: build/C/man2/llseek.2:85
msgid "You probably want to use the B<lseek>(2)  wrapper function instead."
msgstr ""

#. type: Plain text
#: build/C/man2/llseek.2:87 build/C/man2/open.2:1427 build/C/man2/open.2:1436
#: build/C/man2/openat2.2:476 build/C/man2/open_by_handle_at.2:459
#: build/C/man2/readv.2:447 build/C/man2/rename.2:501
msgid "Linux."
msgstr ""

#. type: Plain text
