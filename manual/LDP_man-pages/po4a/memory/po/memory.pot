#. type: SS
#: build/C/man3/mallinfo.3:256 build/C/man3/malloc_info.3:165
#: build/C/man3/mallopt.3:574 build/C/man3/mcheck.3:182 build/C/man2/mmap.2:960
#: build/C/man2/mprotect.2:296 build/C/man7/pkeys.7:164
#, no-wrap
msgid "Program source"
msgstr ""

#. type: Plain text
#: build/C/man3/mallinfo.3:331
#, no-wrap
msgid ""
"#include E<lt>malloc.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
"#include E<lt>string.hE<gt>\n"
"\\&\n"
"#define streq(...)  (strcmp(__VA_ARGS__) == 0)\n"
"\\&\n"
"static void\n"
"display_mallinfo2(void)\n"
"{\n"
"    struct mallinfo2 mi;\n"
"\\&\n"
"    mi = mallinfo2();\n"
"\\&\n"
"    printf(\"Total non-mmapped bytes (arena):       %zu\\[rs]n\", "
"mi.arena);\n"
"    printf(\"# of free chunks (ordblks):            %zu\\[rs]n\", "
"mi.ordblks);\n"
"    printf(\"# of free fastbin blocks (smblks):     %zu\\[rs]n\", "
"mi.smblks);\n"
"    printf(\"# of mapped regions (hblks):           %zu\\[rs]n\", "
"mi.hblks);\n"
"    printf(\"Bytes in mapped regions (hblkhd):      %zu\\[rs]n\", "
"mi.hblkhd);\n"
"    printf(\"Max.\\& total allocated space (usmblks):  %zu\\[rs]n\", "
"mi.usmblks);\n"
"    printf(\"Free bytes held in fastbins (fsmblks): %zu\\[rs]n\", "
"mi.fsmblks);\n"
"    printf(\"Total allocated space (uordblks):      %zu\\[rs]n\", "
"mi.uordblks);\n"
"    printf(\"Total free space (fordblks):           %zu\\[rs]n\", "
"mi.fordblks);\n"
"    printf(\"Topmost releasable block (keepcost):   %zu\\[rs]n\", "
"mi.keepcost);\n"
"}\n"
"\\&\n"
"int\n"
"main(int argc, char *argv[])\n"
"{\n"
"#define MAX_ALLOCS 500000\n"
"    char *alloc[MAX_ALLOCS];\n"
"    size_t blockSize, numBlocks, freeBegin, freeEnd, freeStep;\n"
"\\&\n"
"    if (argc E<lt> 3 || streq(argv[1], \"--help\")) {\n"
"        fprintf(stderr, \"%s num-blocks block-size [free-step \"\n"
"                \"[start-free [end-free]]]\\[rs]n\", argv[0]);\n"
"        exit(EXIT_FAILURE);\n"
"    }\n"
"\\&\n"
"    numBlocks = atoi(argv[1]);\n"
"    blockSize = atoi(argv[2]);\n"
"    freeStep = (argc E<gt> 3) ? atoi(argv[3]) : 1;\n"
"    freeBegin = (argc E<gt> 4) ? atoi(argv[4]) : 0;\n"
"    freeEnd = (argc E<gt> 5) ? atoi(argv[5]) : numBlocks;\n"
"\\&\n"
"    printf(\"============== Before allocating blocks "
"==============\\[rs]n\");\n"
"    display_mallinfo2();\n"
"\\&\n"
"    for (size_t j = 0; j E<lt> numBlocks; j++) {\n"
"        if (numBlocks E<gt>= MAX_ALLOCS) {\n"
"            fprintf(stderr, \"Too many allocations\\[rs]n\");\n"
"            exit(EXIT_FAILURE);\n"
"        }\n"
"\\&\n"
"        alloc[j] = malloc(blockSize);\n"
"        if (alloc[j] == NULL) {\n"
"            perror(\"malloc\");\n"
"            exit(EXIT_FAILURE);\n"
"        }\n"
"    }\n"
"\\&\n"
"    printf(\"\\[rs]n============== After allocating blocks "
"==============\\[rs]n\");\n"
"    display_mallinfo2();\n"
"\\&\n"
"    for (size_t j = freeBegin; j E<lt> freeEnd; j += freeStep)\n"
"        free(alloc[j]);\n"
"\\&\n"
"    printf(\"\\[rs]n============== After freeing blocks "
"==============\\[rs]n\");\n"
"    display_mallinfo2();\n"
"\\&\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"
msgstr ""

