#: build/C/man1/grepc.1:60
#, no-wrap
msgid "B<-l>"
msgstr ""

#. type: Plain text
#: build/C/man1/grepc.1:66
msgid ""
"Suppress normal output; instead print the name of each input file from which "
"output would normally have been printed.  Each file is only printed once."
msgstr ""

