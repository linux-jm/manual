#.  ----- DESCRIPTION :: Functions :: strcpy(3), strcat(3) ------------/
#. type: Plain text
#: build/C/man7/string_copying.7:378
msgid ""
"Copy the input string into a destination string.  The programmer is "
"responsible for allocating a buffer large enough.  It returns a pointer "
"suitable for chaining."
msgstr ""

#. type: TP
#: build/C/man7/string_copying.7:378 build/C/man7/string_copying.7:525
#: build/C/man7/string_copying.7:626
#, no-wrap
msgid "B<strcpy>(3)"
msgstr ""

#. type: TQ
#: build/C/man7/string_copying.7:380 build/C/man7/string_copying.7:527
#: build/C/man7/string_copying.7:628
#, no-wrap
msgid "B<strcat>(3)"
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:385
msgid ""
"Copy and catenate the input string into a destination string.  The "
"programmer is responsible for allocating a buffer large enough.  The return "
"value is useless."
msgstr ""

#.  ----- DESCRIPTION :: Functions :: stpecpy() -----------------------/
#. type: Plain text
#: build/C/man7/string_copying.7:389
msgid "B<stpcpy>(3)  is a faster alternative to these functions."
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:399
msgid ""
"Chain-copy the input string into a destination string.  If the destination "
"buffer, limited by a pointer to its end, isn't large enough to hold the "
"copy, the resulting string is truncated (but it is guaranteed to be "
"null-terminated).  It returns a pointer suitable for chaining.  Truncation "
"needs to be detected only once after the last chained call."
msgstr ""

#.  ----- DESCRIPTION :: Functions :: strlcpy(3bsd), strlcat(3bsd) ----/
#. type: Plain text
#: build/C/man7/string_copying.7:403 build/C/man7/string_copying.7:415
msgid ""
"This function is not provided by any library; see EXAMPLES for a reference "
"implementation."
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:411
msgid ""
"Copy the input string into a destination string.  If the destination buffer "
"isn't large enough to hold the copy, the resulting string is truncated (but "
"it is guaranteed to be null-terminated).  It returns the length of the "
"string, or -1 if it truncated."
msgstr ""

#. type: TP
#: build/C/man7/string_copying.7:415 build/C/man7/string_copying.7:519
#: build/C/man7/string_copying.7:663
#, no-wrap
msgid "B<strlcpy>(3bsd)"
msgstr ""

#. type: TQ
#: build/C/man7/string_copying.7:417 build/C/man7/string_copying.7:521
#: build/C/man7/string_copying.7:665
#, no-wrap
msgid "B<strlcat>(3bsd)"
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:426
msgid ""
"Copy and catenate the input string into a destination string.  If the "
"destination buffer, limited by its size, isn't large enough to hold the "
"copy, the resulting string is truncated (but it is guaranteed to be "
"null-terminated).  They return the length of the total string they tried to "
"create."
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:428
msgid "Check BUGS before using these functions."
msgstr ""

#.  ----- DESCRIPTION :: Functions :: stpncpy(3) ----------------------/
#. type: Plain text
#: build/C/man7/string_copying.7:434
msgid "B<strtcpy>()  and B<stpecpy>()  are better alternatives to these functions."
msgstr ""

#.  ----- DESCRIPTION :: Functions :: strncpy(3) ----------------------/
#. type: Plain text
#: build/C/man7/string_copying.7:450
msgid ""
"Copy the input string into a destination null-padded character sequence in a "
"fixed-size buffer.  If the destination buffer, limited by its size, isn't "
"large enough to hold the copy, the resulting character sequence is "
"truncated.  Since it creates a character sequence, it doesn't need to write "
"a terminating null character.  It's impossible to distinguish truncation by "
"the result of the call, from a character sequence that just fits the "
"destination buffer; truncation should be detected by comparing the length of "
"the input string with the size of the destination buffer."
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:455
msgid ""
"This function is identical to B<stpncpy>(3)  except for the useless return "
"value."
msgstr ""

#.  ----- DESCRIPTION :: Functions :: strncat(3) ----------------------/
#. type: Plain text
#: build/C/man7/string_copying.7:459
msgid "B<stpncpy>(3)  is a more useful alternative to this function."
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:466
msgid ""
"Catenate the input character sequence, contained in a null-padded fixed-size "
"buffer, into a destination string.  The programmer is responsible for "
"allocating a buffer large enough.  The return value is useless."
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:470
msgid ""
"Do not confuse this function with B<strncpy>(3); they are not related at "
"all."
msgstr ""

#.  ----- DESCRIPTION :: Functions :: strndup(3) ----------------------/
#. type: Plain text
#: build/C/man7/string_copying.7:474
msgid ""
"I<\\%stpcpy(mempcpy(dst,\\ src,\\ strnlen(src,\\ countof(src))),\\ "
"\\[dq]\\[dq])> is a faster alternative to this function."
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:479
msgid ""
"Duplicate the input character sequence, contained in a null-padded "
"fixed-size buffer, into a newly allocated destination string."
msgstr ""

#.  ----- DESCRIPTION :: Functions :: mempcpy(3) ----------------------/
#. type: Plain text
#: build/C/man7/string_copying.7:483
msgid "The string must be freed with B<free>(3)."
msgstr ""

#.  ----- RETURN VALUE :: ---------------------------------------------/
#. type: Plain text
#: build/C/man7/string_copying.7:491
msgid ""
"Copy the input character sequence, limited by its length, into a destination "
"character sequence.  The programmer is responsible for allocating a buffer "
"large enough.  It returns a pointer suitable for chaining."
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:495
msgid "A pointer to the terminating null character in the destination string."
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:504
msgid ""
"A pointer to the terminating null character in the destination string, on "
"success.  On error, NULL is returned, and I<errno> is set to indicate the "
"error."
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:510
msgid ""
"A pointer to one after the last character in the destination character "
"sequence."
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:519
msgid ""
"The length of the string, on success.  On error, -1 is returned, and "
"I<errno> is set to indicate the error."
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:525
msgid ""
"The length of the total string that they tried to create (as if truncation "
"didn't occur)."
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:537
msgid "The I<dst> pointer, which is useless."
msgstr ""

#.  ----- ERRORS ------------------------------------------------------/
#. type: Plain text
#: build/C/man7/string_copying.7:541
msgid "The newly allocated string."
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:544
msgid "Most of these functions don't set I<errno>."
msgstr ""

#. type: TP
#: build/C/man7/string_copying.7:549
#, no-wrap
msgid "B<ENOBUFS>"
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:554
msgid "I<dsize> was B<0>."
msgstr ""

#. type: TP
#: build/C/man7/string_copying.7:554
#, no-wrap
msgid "B<E2BIG>"
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:557
msgid "The string has been truncated."
msgstr ""

#. type: TP
#: build/C/man7/string_copying.7:561
#, no-wrap
msgid "B<ENOMEM>"
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:564
msgid "Insufficient memory available to allocate duplicate string."
msgstr ""

#.  ----- CAVEATS :: --------------------------------------------------/
#. type: Plain text
#: build/C/man7/string_copying.7:577
msgid ""
"The Linux kernel has an internal function for copying strings, "
"B<strscpy>(9), which is identical to B<strtcpy>(), except that it returns "
"B<-E2BIG> instead of -1 and it doesn't set I<errno>."
msgstr ""

#.  ----- BUGS :: -----------------------------------------------------/
#. type: Plain text
#: build/C/man7/string_copying.7:586
msgid ""
"Don't mix chain calls to truncating and non-truncating functions.  It is "
"conceptually wrong unless you know that the first part of a copy will always "
"fit.  Anyway, the performance difference will probably be negligible, so it "
"will probably be more clear if you use consistent semantics: either "
"truncating or non-truncating.  Calling a non-truncating function after a "
"truncating one is necessarily wrong."
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:597
msgid ""
"All catenation functions share the same performance problem: E<.UR "
"https:\\://www.joelonsoftware.com/\\:2001/12/11/\\:back-to-basics/> Shlemiel "
"the painter E<.UE .> As a mitigation, compilers are able to transform some "
"calls to catenation functions into normal copy functions, since "
"I<strlen(dst)> is usually a byproduct of the previous copy."
msgstr ""

#.  ----- EXAMPLES :: -------------------------------------------------/
#. type: Plain text
#: build/C/man7/string_copying.7:612
msgid ""
"B<strlcpy>(3)  and B<strlcat>(3)  need to read the entire I<src> string, "
"even if the destination buffer is small.  This makes them vulnerable to "
"Denial of Service (DoS) attacks if an attacker can control the length of the "
"I<src> string.  And if not, they're still unnecessarily slow."
msgstr ""

#.  ----- EXAMPLES :: stpcpy(3) ---------------------------------------/
#. type: Plain text
#: build/C/man7/string_copying.7:615
msgid "The following are examples of correct use of each of these functions."
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:624
#, no-wrap
msgid ""
"p = buf;\n"
"p = stpcpy(p, \"Hello \");\n"
"p = stpcpy(p, \"world\");\n"
"p = stpcpy(p, \"!\");\n"
"len = p - buf;\n"
"puts(buf);\n"
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:636
#, no-wrap
msgid ""
"strcpy(buf, \"Hello \");\n"
"strcat(buf, \"world\");\n"
"strcat(buf, \"!\");\n"
"len = strlen(buf);\n"
"puts(buf);\n"
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:652
#, no-wrap
msgid ""
"end = buf + countof(buf);\n"
"p = buf;\n"
"p = stpecpy(p, end, \"Hello \");\n"
"p = stpecpy(p, end, \"world\");\n"
"p = stpecpy(p, end, \"!\");\n"
"if (p == NULL) {\n"
"    len = countof(buf) - 1;\n"
"    goto toolong;\n"
"}\n"
"len = p - buf;\n"
"puts(buf);\n"
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:661
#, no-wrap
msgid ""
"len = strtcpy(buf, \"Hello world!\", countof(buf));\n"
"if (len == -1)\n"
"    goto toolong;\n"
"puts(buf);\n"
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:676
#, no-wrap
msgid ""
"if (strlcpy(buf, \"Hello \", countof(buf)) E<gt>= countof(buf))\n"
"    goto toolong;\n"
"if (strlcat(buf, \"world\", countof(buf)) E<gt>= countof(buf))\n"
"    goto toolong;\n"
"len = strlcat(buf, \"!\", countof(buf));\n"
"if (len E<gt>= countof(buf))\n"
"    goto toolong;\n"
"puts(buf);\n"
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:686
#, no-wrap
msgid ""
"p = stpncpy(u-E<gt>ut_user, \"alx\", countof(u-E<gt>ut_user));\n"
"if (countof(u-E<gt>ut_user) E<lt> strlen(\"alx\"))\n"
"    goto toolong;\n"
"len = p - u-E<gt>ut_user;\n"
"fwrite(u-E<gt>ut_user, 1, len, stdout);\n"
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:696
#, no-wrap
msgid ""
"strncpy(u-E<gt>ut_user, \"alx\", countof(u-E<gt>ut_user));\n"
"if (countof(u-E<gt>ut_user) E<lt> strlen(\"alx\"))\n"
"    goto toolong;\n"
"len = strnlen(u-E<gt>ut_user, countof(u-E<gt>ut_user));\n"
"fwrite(u-E<gt>ut_user, 1, len, stdout);\n"
msgstr ""

#. type: TP
#: build/C/man7/string_copying.7:698
#, no-wrap
msgid "I<mempcpy(dst, src, strnlen(src, countof(src)))>"
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:706
#, no-wrap
msgid ""
"char  buf[countof(u-E<gt>ut_user)];\n"
"p = buf;\n"
"p = mempcpy(p, u-E<gt>ut_user, strnlen(u-E<gt>ut_user, "
"countof(u-E<gt>ut_user)));\n"
"len = p - buf;\n"
"fwrite(buf, 1, len, stdout);\n"
msgstr ""

#. type: TP
#: build/C/man7/string_copying.7:708
#, no-wrap
msgid "I<stpcpy(mempcpy(dst, src, strnlen(src, countof(src))), \\[dq]\\[dq])>"
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:717
#, no-wrap
msgid ""
"char  buf[countof(u-E<gt>ut_user) + 1];\n"
"p = buf;\n"
"p = mempcpy(p, u-E<gt>ut_user, strnlen(u-E<gt>ut_user, "
"countof(u-E<gt>ut_user)));\n"
"p = stpcpy(p, \"\");\n"
"len = p - buf;\n"
"puts(buf);\n"
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:727
#, no-wrap
msgid ""
"char  buf[countof(u-E<gt>ut_user) + 1];\n"
"strcpy(buf, \"\");\n"
"strncat(buf, u-E<gt>ut_user, countof(u-E<gt>ut_user));\n"
"len = strlen(buf);\n"
"puts(buf);\n"
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:736
#, no-wrap
msgid ""
"buf = strndup(u-E<gt>ut_user, countof(u-E<gt>ut_user));\n"
"len = strlen(buf);\n"
"puts(buf);\n"
"free(buf);\n"
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:747
#, no-wrap
msgid ""
"p = buf;\n"
"p = mempcpy(p, \"Hello \", 6);\n"
"p = mempcpy(p, \"world\", 5);\n"
"p = mempcpy(p, \"!\", 1);\n"
"len = p - buf;\n"
"fwrite(buf, 1, len, stdout);\n"
msgstr ""

#. type: TP
#: build/C/man7/string_copying.7:749
#, no-wrap
msgid "I<stpcpy(mempcpy(dst, src, len), \\[dq]\\[dq])>"
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:759
#, no-wrap
msgid ""
"p = buf;\n"
"p = mempcpy(p, \"Hello \", 6);\n"
"p = mempcpy(p, \"world\", 5);\n"
"p = mempcpy(p, \"!\", 1);\n"
"p = stpcpy(p, \"\");\n"
"len = p - buf;\n"
"puts(buf);\n"
msgstr ""

#.  ----- EXAMPLES :: Implementations :: ------------------------------/
#. type: SS
#: build/C/man7/string_copying.7:761
#, no-wrap
msgid "Implementations"
msgstr ""

#. type: Plain text
#: build/C/man7/string_copying.7:763
msgid "Here are reference implementations for functions not provided by libc."
msgstr ""

#.  ----- EXAMPLES :: Implementations :: stpecpy() --------------------/
#.  ----- EXAMPLES :: Implementations :: strtcpy() --------------------/
#.  ----- SEE ALSO :: -------------------------------------------------/
#. type: Plain text
#: build/C/man7/string_copying.7:803
#, no-wrap
msgid ""
"/* This code is in the public domain.  */\n"
"\\&\n"
"char *\n"
"I<stpecpy>(char *dst, char end[0], const char *restrict src)\n"
"{\n"
"    size_t  dlen;\n"
"\\&\n"
"    if (dst == NULL)\n"
"        return NULL;\n"
"\\&\n"
"    dlen = strtcpy(dst, src, end - dst);\n"
"    return (dlen == -1) ? NULL : dst + dlen;\n"
"}\n"
"\\&\n"
"ssize_t\n"
"I<strtcpy>(char *restrict dst, const char *restrict src, size_t dsize)\n"
"{\n"
"    bool    trunc;\n"
"    size_t  dlen, slen;\n"
"\\&\n"
"    if (dsize == 0) {\n"
"        errno = ENOBUFS;\n"
"        return -1;\n"
"    }\n"
"\\&\n"
"    slen = strnlen(src, dsize);\n"
"    trunc = (slen == dsize);\n"
"    dlen = slen - trunc;\n"
"\\&\n"
"    stpcpy(mempcpy(dst, src, dlen), \"\");\n"
"    if (trunc)\n"
"        errno = E2BIG;\n"
"    return trunc ? -1 : slen;\n"
"}\n"
msgstr ""

