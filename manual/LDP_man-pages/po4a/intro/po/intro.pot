#: build/C/man1/grepc.1:44
msgid "Print I<n> lines of leading context before a match."
msgstr ""

#. type: TP
#: build/C/man1/grepc.1:44
#, no-wrap
msgid "B<-C>I<\\~n>"
msgstr ""

