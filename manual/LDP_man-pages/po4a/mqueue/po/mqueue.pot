#. type: Plain text
#: build/C/man3/mq_getattr.3:142
msgid ""
"On Linux, B<mq_getattr>()  and B<mq_setattr>()  are library functions "
"layered on top of the B<mq_getsetattr>(2)  system call."
msgstr ""

#. type: SH
#: build/C/man3/mq_getattr.3:146 build/C/man3/mq_notify.3:198
#: build/C/man7/mq_overview.7:375 build/C/man2/msgop.2:535
#, no-wrap
msgid "EXAMPLES"
msgstr ""

#. type: Plain text
#: build/C/man3/mq_getattr.3:157
msgid ""
"The program below can be used to show the default I<mq_maxmsg> and "
"I<mq_msgsize> values that are assigned to a message queue that is created "
"with a call to B<mq_open>(3)  in which the I<attr> argument is NULL.  Here "
"is an example run of the program:"
msgstr ""

#. type: Plain text
#: build/C/man3/mq_getattr.3:163
#, no-wrap
msgid ""
"$B< ./a.out /testq>;\n"
"Maximum # of messages on queue:   10\n"
"Maximum message size:             8192\n"
msgstr ""

#. type: Plain text
#: build/C/man3/mq_getattr.3:171
msgid ""
"Since Linux 3.5, the following I</proc> files (described in "
"B<mq_overview>(7))  can be used to control the defaults:"
msgstr ""

#. type: Plain text
#: build/C/man3/mq_getattr.3:180
#, no-wrap
msgid ""
"$B< uname -sr>;\n"
"Linux 3.8.0\n"
"$B< cat /proc/sys/fs/mqueue/msg_default>;\n"
"10\n"
"$B< cat /proc/sys/fs/mqueue/msgsize_default>;\n"
"8192\n"
msgstr ""

#. type: SS
#: build/C/man3/mq_getattr.3:182 build/C/man3/mq_notify.3:204
#: build/C/man2/msgop.2:559
#, no-wrap
msgid "Program source"
msgstr ""

#. type: Plain text
#: build/C/man3/mq_getattr.3:220
#, no-wrap
msgid ""
"#include E<lt>err.hE<gt>\n"
"#include E<lt>fcntl.hE<gt>\n"
"#include E<lt>mqueue.hE<gt>\n"
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
"#include E<lt>sys/stat.hE<gt>\n"
"#include E<lt>unistd.hE<gt>\n"
"\\&\n"
"int\n"
"main(int argc, char *argv[])\n"
"{\n"
"    mqd_t mqd;\n"
"    struct mq_attr attr;\n"
"\\&\n"
"    if (argc != 2) {\n"
"        fprintf(stderr, \"Usage: %s mq-name\\[rs]n\", argv[0]);\n"
"        exit(EXIT_FAILURE);\n"
"    }\n"
"\\&\n"
"    mqd = mq_open(argv[1], O_CREAT | O_EXCL, 0600, NULL);\n"
"    if (mqd == (mqd_t) -1)\n"
"        err(EXIT_FAILURE, \"mq_open\");\n"
"\\&\n"
"    if (mq_getattr(mqd, &attr) == -1)\n"
"        err(EXIT_FAILURE, \"mq_getattr\");\n"
"\\&\n"
"    printf(\"Maximum # of messages on queue:   %ld\\[rs]n\", "
"attr.mq_maxmsg);\n"
"    printf(\"Maximum message size:             %ld\\[rs]n\", "
"attr.mq_msgsize);\n"
"\\&\n"
"    if (mq_unlink(argv[1]) == -1)\n"
"        err(EXIT_FAILURE, \"mq_unlink\");\n"
"\\&\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"
msgstr ""

