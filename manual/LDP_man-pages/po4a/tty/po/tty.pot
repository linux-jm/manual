"These functions provide an interface to the file B<_PATH_TTYS> (e.g., "
"I</etc/ttys>)."
msgstr ""

#. type: Plain text
#: build/C/man3/getttyent.3:32
msgid "The function B<setttyent>()  opens the file or rewinds it if already open."
msgstr ""

#. type: Plain text
