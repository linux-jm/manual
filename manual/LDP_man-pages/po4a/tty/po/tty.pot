"B<int openpty(int *>I<amaster>B<, int *>I<aslave>B<, char *>I<name>B<,>\n"
"B<              const struct termios *>I<termp>B<,>\n"
"B<              const struct winsize *>I<winp>B<);>\n"
"B<pid_t forkpty(int *>I<amaster>B<, char *>I<name>B<,>\n"
"B<              const struct termios *>I<termp>B<,>\n"
"B<              const struct winsize *>I<winp>B<);>\n"
msgstr ""

