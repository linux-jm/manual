#: build/C/man3/posix_openpt.3:10
msgid "posix_openpt - open a pseudoterminal device"
msgstr ""

#. type: Plain text
#: build/C/man3/posix_openpt.3:17
#, no-wrap
msgid ""
"B<#include E<lt>stdlib.hE<gt>>\n"
"B<#include E<lt>fcntl.hE<gt>>\n"
msgstr ""

