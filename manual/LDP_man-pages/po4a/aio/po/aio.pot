msgstr ""

#. type: Plain text
#: build/C/man2/io_setup.2:9 build/C/man3/io_setup.3:8
msgid "io_setup - create an asynchronous I/O context"
msgstr ""

#. type: Plain text
#: build/C/man2/io_setup.2:17 build/C/man2/io_submit.2:17
#, no-wrap
msgid ""
"B<#include E<lt>linux/aio_abi.hE<gt>>\n"
"B<#include E<lt>sys/syscall.hE<gt>>    /* Definition of SYS_* constants */\n"
"B<#include E<lt>unistd.hE<gt>>\n"
msgstr ""

#. type: Plain text
#: build/C/man2/io_setup.2:19
#, no-wrap
msgid ""
"B<long\\~syscall(SYS_io_setup, unsigned int >I<n>B<, aio_context_t "
"*>I<ctx_idp>B<);>\n"
msgstr ""

#. type: Plain text
#: build/C/man2/io_setup.2:27 build/C/man2/io_submit.2:28
msgid ""
"I<Note>: you probably want to use the B<io_setup>(3)  wrapper function "
"provided by I<libaio>; see VERSIONS."
msgstr ""

#. type: Plain text
#: build/C/man2/io_setup.2:42
msgid ""
"The B<io_setup>()  system call creates an asynchronous I/O context suitable "
"for concurrently processing I<n> operations.  The I<ctx_idp> argument must "
"not point to an AIO context that already exists, and must be initialized to "
"0 prior to the call.  On successful creation of the AIO context, I<*ctx_idp> "
"is filled in with the resulting handle."
msgstr ""

#. type: Plain text
#: build/C/man2/io_setup.2:51
msgid ""
"On success, B<io_setup>()  returns 0.  On error, -1 is returned, and "
"I<errno> is set to indicate the error."
msgstr ""

#. type: Plain text
#: build/C/man2/io_setup.2:61
msgid ""
"The specified I<n> exceeds the limit of available events, as defined in "
"I</proc/sys/fs/aio-max-nr> (see B<proc_sys_fs>(5))."
msgstr ""

#. type: Plain text
#: build/C/man2/io_setup.2:65
msgid "An invalid pointer is passed for I<ctx_idp>."
msgstr ""

#. type: Plain text
#: build/C/man2/io_setup.2:69
msgid "I<*ctx_idp> is not initialized to 0."
msgstr ""

#. type: Plain text
#: build/C/man2/io_setup.2:76
msgid "The specified I<n> exceeds internal limits.  I<n> should be greater than 0."
msgstr ""

#. type: TP
#: build/C/man2/io_setup.2:76
#, no-wrap
msgid "B<ENOMEM>"
msgstr ""

#. type: Plain text
#: build/C/man2/io_setup.2:79
msgid "Insufficient kernel resources are available."
msgstr ""

#. type: Plain text
#: build/C/man2/io_setup.2:83
msgid "B<io_setup>()  is not implemented on this architecture."
msgstr ""

#. type: Plain text
#: build/C/man2/io_setup.2:100
msgid ""
"B<io_cancel>(2), B<io_destroy>(2), B<io_getevents>(2), B<io_submit>(2), "
"B<io_setup>(3), B<aio>(7)"
msgstr ""

#. type: TH
#: build/C/man2/io_submit.2:6
#, no-wrap
msgid "io_submit"
msgstr ""

#. type: Plain text
#: build/C/man2/io_submit.2:9
msgid "io_submit - submit asynchronous I/O blocks for processing"
msgstr ""

#. type: Plain text
#: build/C/man2/io_submit.2:20
#, no-wrap
msgid ""
"B<int\\~syscall(SYS_io_submit, aio_context_t\\~>I<ctx_id>B<,>\n"
"B<            long\\~>I<n>B<, struct\\~iocb\\~*>I<iocbpp>B<[>I<n>B<]);>\n"
msgstr ""

#. type: Plain text
#: build/C/man2/io_submit.2:44
msgid ""
"The B<io_submit>()  system call queues I<n> I/O request blocks for "
"processing in the AIO context I<ctx_id>.  The I<iocbpp> argument should be "
"an array of I<n> AIO control blocks, which will be submitted to context "
"I<ctx_id>."
msgstr ""

#. type: Plain text
#: build/C/man2/io_submit.2:50
msgid ""
"The I<iocb> (I/O control block) structure defined in I<linux/aio_abi.h> "
"defines the parameters that control the I/O operation."
msgstr ""

#. type: Plain text
#: build/C/man2/io_submit.2:68
#, no-wrap
msgid ""
"#include E<lt>linux/aio_abi.hE<gt>\n"
"\\&\n"
"struct iocb {\n"
"    __u64   aio_data;\n"
"    __u32   PADDED(aio_key, aio_rw_flags);\n"
"    __u16   aio_lio_opcode;\n"
"    __s16   aio_reqprio;\n"
"    __u32   aio_fildes;\n"
"    __u64   aio_buf;\n"
"    __u64   aio_nbytes;\n"
"    __s64   aio_offset;\n"
"    __u64   aio_reserved2;\n"
"    __u32   aio_flags;\n"
"    __u32   aio_resfd;\n"
"};\n"
msgstr ""

#. type: TP
#: build/C/man2/io_submit.2:72
#, no-wrap
msgid "I<aio_data>"
msgstr ""

#. type: Plain text
#: build/C/man2/io_submit.2:80
msgid ""
"This data is copied into the I<data> field of the I<io_event> structure upon "
"I/O completion (see B<io_getevents>(2))."
msgstr ""

#. type: TP
#: build/C/man2/io_submit.2:80
#, no-wrap
msgid "I<aio_key>"
msgstr ""

#. type: Plain text
#: build/C/man2/io_submit.2:86
msgid ""
"This is an internal field used by the kernel.  Do not modify this field "
"after an B<io_submit>()  call."
msgstr ""

#. type: TP
#: build/C/man2/io_submit.2:86
#, no-wrap
msgid "I<aio_rw_flags>"
msgstr ""

#. type: Plain text
#: build/C/man2/io_submit.2:90
msgid "This defines the R/W flags passed with structure.  The valid values are:"
msgstr ""

#. type: TP
#: build/C/man2/io_submit.2:91
#, no-wrap
msgid "B<RWF_APPEND> (since Linux 4.16)"
msgstr ""

#.  commit e1fc742e14e01d84d9693c4aca4ab23da65811fb
#. type: Plain text
#: build/C/man2/io_submit.2:105
msgid ""
"Append data to the end of the file.  See the description of the flag of the "
"same name in B<pwritev2>(2)  as well as the description of B<O_APPEND> in "
"B<open>(2).  The I<aio_offset> field is ignored.  The file offset is not "
"changed."
msgstr ""

#. type: TP
#: build/C/man2/io_submit.2:105
#, no-wrap
msgid "B<RWF_DSYNC> (since Linux 4.13)"
msgstr ""

#. type: Plain text
#: build/C/man2/io_submit.2:115
msgid ""
"Write operation complete according to requirement of synchronized I/O data "
"integrity.  See the description of the flag of the same name in "
"B<pwritev2>(2)  as well the description of B<O_DSYNC> in B<open>(2)."
msgstr ""

#. type: TP
#: build/C/man2/io_submit.2:115
#, no-wrap
msgid "B<RWF_HIPRI> (since Linux 4.13)"
msgstr ""

#. type: Plain text
#: build/C/man2/io_submit.2:118
msgid "High priority request, poll if possible"
msgstr ""

#. type: TP
#: build/C/man2/io_submit.2:118
#, no-wrap
msgid "B<RWF_NOWAIT> (since Linux 4.14)"
msgstr ""

#. type: Plain text
#: build/C/man2/io_submit.2:132
msgid ""
"Don't wait if the I/O will block for operations such as file block "
"allocations, dirty page flush, mutex locks, or a congested block device "
"inside the kernel.  If any of these conditions are met, the control block is "
"returned immediately with a return value of B<-EAGAIN> in the I<res> field "
"of the I<io_event> structure (see B<io_getevents>(2))."
msgstr ""

#. type: TP
#: build/C/man2/io_submit.2:132
#, no-wrap
msgid "B<RWF_SYNC> (since Linux 4.13)"
msgstr ""

#. type: Plain text
#: build/C/man2/io_submit.2:142
msgid ""
"Write operation complete according to requirement of synchronized I/O file "
"integrity.  See the description of the flag of the same name in "
"B<pwritev2>(2)  as well the description of B<O_SYNC> in B<open>(2)."
msgstr ""

#. type: TP
#: build/C/man2/io_submit.2:142
#, no-wrap
msgid "B<RWF_NOAPPEND> (since Linux 6.9)"
msgstr ""

#. type: Plain text
#: build/C/man2/io_submit.2:152
msgid ""
"Do not honor B<O_APPEND> B<open>(2)  flag.  See the description of "
"B<RWF_NOAPPEND> in B<pwritev2>(2)."
msgstr ""

#. type: TP
#: build/C/man2/io_submit.2:152
#, no-wrap
msgid "B<RWF_ATOMIC> (since Linux 6.11)"
msgstr ""

#. type: Plain text
#: build/C/man2/io_submit.2:171
msgid ""
"Write a block of data such that a write will never be torn from power fail "
"or similar.  See the description of B<RWF_ATOMIC> in B<pwritev2>(2).  For "
"usage with B<IOCB_CMD_PWRITEV>, the upper vector limit is "
"I<stx_atomic_write_segments_max.> See B<STATX_WRITE_ATOMIC> and "
"I<stx_atomic_write_segments_max> description in B<statx>(2)."
msgstr ""

#. type: Plain text
#: build/C/man2/io_submit.2:180
msgid ""
"This defines the type of I/O to be performed by the I<iocb> structure.  The "
"valid values are defined by the enum defined in I<linux/aio_abi.h>:"
msgstr ""

#. type: Plain text
#: build/C/man2/io_submit.2:193
#, no-wrap
msgid ""
"enum {\n"
"    IOCB_CMD_PREAD = 0,\n"
"    IOCB_CMD_PWRITE = 1,\n"
"    IOCB_CMD_FSYNC = 2,\n"
"    IOCB_CMD_FDSYNC = 3,\n"
"    IOCB_CMD_POLL = 5,\n"
"    IOCB_CMD_NOOP = 6,\n"
"    IOCB_CMD_PREADV = 7,\n"
"    IOCB_CMD_PWRITEV = 8,\n"
"};\n"
msgstr ""

#. type: Plain text
#: build/C/man2/io_submit.2:198
msgid "This defines the requests priority."
msgstr ""

#. type: TP
#: build/C/man2/io_submit.2:211
#, no-wrap
msgid "I<aio_flags>"
msgstr ""

#. type: Plain text
#: build/C/man2/io_submit.2:217
msgid ""
"This is the set of flags associated with the I<iocb> structure.  The valid "
"values are:"
msgstr ""

#. type: TP
#: build/C/man2/io_submit.2:218
#, no-wrap
msgid "B<IOCB_FLAG_RESFD>"
msgstr ""

#. type: Plain text
#: build/C/man2/io_submit.2:224
msgid ""
"Asynchronous I/O control must signal the file descriptor mentioned in "
"I<aio_resfd> upon completion."
msgstr ""

#. type: TP
#: build/C/man2/io_submit.2:224
