msgstr ""

#. type: Plain text
#: build/C/man2/io_destroy.2:9 build/C/man3/io_destroy.3:8
msgid "io_destroy - destroy an asynchronous I/O context"
msgstr ""

#. type: Plain text
#: build/C/man2/io_destroy.2:17
#, no-wrap
msgid ""
"B<#include E<lt>linux/aio_abi.hE<gt>>    /* Definition of B<aio_context_t> "
"*/\n"
"B<#include E<lt>sys/syscall.hE<gt>>      /* Definition of B<SYS_*> constants "
"*/\n"
"B<#include E<lt>unistd.hE<gt>>\n"
msgstr ""

#. type: Plain text
#: build/C/man2/io_destroy.2:19
#, no-wrap
msgid "B<int syscall(SYS_io_destroy, aio_context_t >I<ctx_id>B<);>\n"
msgstr ""

#. type: Plain text
#: build/C/man2/io_destroy.2:27
msgid ""
"I<Note>: you probably want to use the B<io_destroy>(3)  wrapper function "
"provided by I<libaio>; see VERSIONS."
msgstr ""

#. type: Plain text
#: build/C/man2/io_destroy.2:36 build/C/man3/io_destroy.3:27
msgid ""
"The B<io_destroy>()  system call will attempt to cancel all outstanding "
"asynchronous I/O operations against I<ctx_id>, will block on the completion "
"of all operations that could not be canceled, and will destroy the "
"I<ctx_id>."
msgstr ""

#. type: Plain text
#: build/C/man2/io_destroy.2:45
msgid ""
"On success, B<io_destroy>()  returns 0.  On error, -1 is returned, and "
"I<errno> is set to indicate the error."
msgstr ""

#. type: Plain text
#: build/C/man2/io_destroy.2:50
msgid "I<ctx_id> was not a valid address."
msgstr ""

#. type: Plain text
#: build/C/man2/io_destroy.2:59
