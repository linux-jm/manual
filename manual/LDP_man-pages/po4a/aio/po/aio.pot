msgstr ""

#. type: TH
#: build/C/man2/io_cancel.2:6 build/C/man2/io_destroy.2:6
#: build/C/man2/io_getevents.2:6 build/C/man2/io_setup.2:6
#: build/C/man2/io_submit.2:6 build/C/man3/io_destroy.3:5
#: build/C/man3/io_setup.3:5
#, no-wrap
msgid "2026-04-11"
msgstr ""

#. type: Plain text
#: build/C/man2/io_cancel.2:9
msgid "io_cancel - cancel an outstanding asynchronous I/O operation"
