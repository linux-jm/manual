msgstr ""

#. type: TP
#: build/C/man2/io_submit.2:298
#, no-wrap
msgid "B<EPERM>"
msgstr ""

#. type: Plain text
#: build/C/man2/io_submit.2:307
msgid ""
"The I<aio_reqprio> field is set with the class B<IOPRIO_CLASS_RT>, but the "
"submitting context does not have the B<CAP_SYS_ADMIN> capability."
