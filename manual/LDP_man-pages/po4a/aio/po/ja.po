#. type: Plain text
#: build/C/man7/aio.7:9
msgid "aio - POSIX asynchronous I/O overview"
msgstr "aio - POSIX 非同期 I/O の概要"

#. type: SH
#: build/C/man7/aio.7:9 build/C/man3/aio_cancel.3:19
#: build/C/man3/aio_error.3:19 build/C/man3/aio_fsync.3:19
