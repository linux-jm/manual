#. type: Plain text
#: build/C/man2/getgroups.2:269
#, no-wrap
msgid ""
"#include E<lt>err.hE<gt>\n"
"#include E<lt>stddef.hE<gt>\n"
"#include E<lt>stdint.hE<gt>\n"
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
"#include E<lt>sys/types.hE<gt>\n"
"#include E<lt>unistd.hE<gt>\n"
"\\&\n"
"#define MALLOC(n, T)  ((T *) reallocarray(NULL, n, sizeof(T)))\n"
"\\&\n"
"static gid_t *agetgroups(size_t *ngids);\n"
"\\&\n"
"int\n"
"main(void)\n"
"{\n"
"    gid_t   *gids;\n"
"    size_t  n;\n"
"\\&\n"
"    gids = agetgroups(&n);\n"
"    if (gids == NULL)\n"
"        err(EXIT_FAILURE, \"agetgroups\");\n"
"\\&\n"
"    if (n != 0) {\n"
"        printf(\"%jd\", (intmax_t) gids[0]);\n"
"        for (size_t i = 1; i E<lt> n; i++)\n"
"            printf(\" %jd\", (intmax_t) gids[i]);\n"
"    }\n"
"    puts(\"\");\n"
"\\&\n"
"    free(gids);\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"
"\\&\n"
"static gid_t *\n"
"agetgroups(size_t *ngids)\n"
"{\n"
"    int    n;\n"
"    gid_t  *gids;\n"
"\\&\n"
"    n = getgroups(0, NULL);\n"
"    if (n == -1)\n"
"        return NULL;\n"
"\\&\n"
"    gids = MALLOC(n, gid_t);\n"
"    if (gids == NULL)\n"
"        return NULL;\n"
"\\&\n"
"    n = getgroups(n, gids);\n"
"    if (n == -1) {\n"
"        free(gids);\n"
"        return NULL;\n"
"    }\n"
"\\&\n"
"    *ngids = n;\n"
"    return gids;\n"
"}\n"
msgstr ""

