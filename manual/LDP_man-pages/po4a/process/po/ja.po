#, no-wrap
#~ msgid ""
#~ "    if (!(argc == 2 || argc == 4)) {\n"
#~ "        fprintf(stderr, \"Usage: %s E<lt>pidE<gt> [E<lt>new-soft-limitE<gt> \"\n"
