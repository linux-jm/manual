#~ "    /* Set CPU time limit of target process; retrieve and display\n"
#~ "       previous limit */\n"

#, no-wrap
#~ msgid ""
#~ "    if (prlimit(pid, RLIMIT_CPU, newp, &old) == -1)\n"
#~ "        errExit(\"prlimit-1\");\n"
#~ "    printf(\"Previous limits: soft=%jd; hard=%jd\\en\",\n"
#~ "            (intmax_t) old.rlim_cur, (intmax_t) old.rlim_max);\n"
