#, no-wrap
#~ msgid ""
#~ "    if (uid_map != NULL || map_zero) {\n"
#~ "        snprintf(map_path, PATH_MAX, \"/proc/%jd/uid_map\",\n"
#~ "                (intmax_t) child_pid);\n"
