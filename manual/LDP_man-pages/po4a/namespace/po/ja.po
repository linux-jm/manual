#. type: SS
#: build/C/man7/mount_namespaces.7:769
#, fuzzy, no-wrap
#| msgid "Mount points"
msgid "Mount semantics"
msgstr "マウントポイント"

#. type: Plain text
#: build/C/man7/mount_namespaces.7:771
msgid "Suppose that we use the following command to create a mount:"
msgstr ""

#. type: Plain text
#: build/C/man7/mount_namespaces.7:775
#, no-wrap
msgid "mount device B/b\n"
msgstr ""

#. type: Plain text
#: build/C/man7/mount_namespaces.7:790
msgid ""
