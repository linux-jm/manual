#, no-wrap
msgid "mbsinit"
msgstr ""

#. type: Plain text
#: build/C/man3/mbsinit.3:12
msgid "mbsinit - test for initial shift state"
msgstr ""

#. type: Plain text
#: build/C/man3/mbsinit.3:20
#, no-wrap
msgid "B<int mbsinit(const mbstate_t *>I<ps>B<);>\n"
msgstr ""

#. type: Plain text
#: build/C/man3/mbsinit.3:28
msgid ""
"The function B<mbsinit>()  tests whether I<*ps> corresponds to an initial "
"shift state."
msgstr ""

#. type: Plain text
#: build/C/man3/mbsinit.3:36
msgid ""
"B<mbsinit>()  returns nonzero if I<*ps> is an initial shift state, or if "
"I<ps> is NULL.  Otherwise, it returns 0."
msgstr ""

