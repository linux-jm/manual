msgstr ""

#. type: Plain text
#: build/C/man3/wcspbrk.3:64
msgid "B<strpbrk>(3), B<wcschr>(3), B<wcscspn>(3)"
msgstr ""

#. type: TH
#: build/C/man3/wcsrchr.3:7
#, no-wrap
msgid "wcsrchr"
msgstr ""

#. type: Plain text
#: build/C/man3/wcsrchr.3:10
msgid "wcsrchr - search a wide character in a wide-character string"
msgstr ""

#. type: Plain text
#: build/C/man3/wcsrchr.3:18
#, no-wrap
