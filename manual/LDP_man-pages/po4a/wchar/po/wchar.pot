#. type: TH
#: build/C/man3/wcsncmp.3:7
#, no-wrap
msgid "wcsncmp"
msgstr ""

#. type: Plain text
#: build/C/man3/wcsncmp.3:10
msgid "wcsncmp - compare two fixed-size wide-character strings"
