msgstr ""

#. type: Plain text
#: build/C/man3/towlower.3:103 build/C/man3/towupper.3:102
msgid "C11, POSIX.1-2008 (XSI)."
msgstr ""

#. type: Plain text
#: build/C/man3/towlower.3:111 build/C/man3/towupper.3:110
msgid "C99, POSIX.1-2001 (XSI).  Obsolete in POSIX.1-2008 (XSI)."
msgstr ""

#. type: Plain text
#: build/C/man3/towlower.3:115
msgid "glibc 2.3.  POSIX.1-2008."
msgstr ""

#. type: Plain text
#: build/C/man3/towlower.3:119 build/C/man3/towupper.3:118
msgid ""
"The behavior of these functions depends on the B<LC_CTYPE> category of the "
"locale."
msgstr ""

#. type: Plain text
#: build/C/man3/towlower.3:122 build/C/man3/towupper.3:121
msgid ""
"These functions are not very appropriate for dealing with Unicode "
"characters, because Unicode knows about three cases: upper, lower, and title "
"case."
msgstr ""

#. type: Plain text
#: build/C/man3/towlower.3:126
