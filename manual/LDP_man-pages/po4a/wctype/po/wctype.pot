#: build/C/man3/towctrans.3:61
#, no-wrap
msgid "B<towctrans>()"
msgstr ""

#. type: Plain text
#: build/C/man3/towctrans.3:74
msgid ""
"The behavior of B<towctrans>()  depends on the B<LC_CTYPE> category of the "
"current locale."
