#: build/C/man5/shells.5:22 build/C/man2/syscall.2:337
#: build/C/man2/sysctl.2:111 build/C/man3/get_nprocs.3:70
#: build/C/man3/get_phys_pages.3:67
#, no-wrap
msgid "EXAMPLES"
msgstr ""

#. type: Plain text
#: build/C/man2/_syscall.2:142
#, no-wrap
msgid ""
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
"#include E<lt>errno.hE<gt>\n"
"#include E<lt>linux/unistd.hE<gt>       /* for _syscallX macros/related "
"stuff */\n"
"#include E<lt>linux/kernel.hE<gt>       /* for struct sysinfo */\n"
"\\&\n"
"_syscall1(int, sysinfo, struct sysinfo *, info);\n"
"\\&\n"
"int\n"
"main(void)\n"
"{\n"
"    struct sysinfo s_info;\n"
"    int error;\n"
"\\&\n"
"    error = sysinfo(&s_info);\n"
"    printf(\"code error = %d\\[rs]n\", error);\n"
"    printf(\"Uptime = %lds\\[rs]nLoad: 1 min %lu / 5 min %lu / 15 min "
"%lu\\[rs]n\"\n"
"           \"RAM: total %lu / free %lu / shared %lu\\[rs]n\"\n"
"           \"Memory in buffers = %lu\\[rs]nSwap: total %lu / free "
"%lu\\[rs]n\"\n"
"           \"Number of processes = %d\\[rs]n\",\n"
"           s_info.uptime, s_info.loads[0],\n"
"           s_info.loads[1], s_info.loads[2],\n"
"           s_info.totalram, s_info.freeram,\n"
"           s_info.sharedram, s_info.bufferram,\n"
"           s_info.totalswap, s_info.freeswap,\n"
"           s_info.procs);\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"
msgstr ""

