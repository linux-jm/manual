msgstr ""

#. type: Plain text
#: build/C/man2/chown.2:235
msgid "(B<fchown>())  A low-level I/O error occurred while modifying the inode."
msgstr ""

#. type: Plain text
#: build/C/man2/chown.2:259
msgid ""
"(B<fchownat>())  I<path> is relative and I<dirfd> is a file descriptor "
"referring to a file other than a directory."
msgstr ""

