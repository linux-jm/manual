msgstr ""

#. type: Plain text
#: build/C/man3/getopt_long.3:10
msgid "getopt_long - parse command-line options"
msgstr ""

#. type: Plain text
#: build/C/man3/getopt_long.3:17 build/C/man3/getopt_long_only.3:17
#, no-wrap
msgid ""
"B<#define _GNU_SOURCE>\n"
"B<#include E<lt>getopt.hE<gt>>\n"
msgstr ""

#. type: Plain text
#: build/C/man3/getopt_long.3:21
#, no-wrap
msgid ""
"B<int getopt_long(int >I<argc>B<, char *>I<argv>B<[],>\n"
"B<           const char *>I<optstring>B<,>\n"
"B<           const struct option *>I<longopts>B<, int *>I<longindex>B<);>\n"
msgstr ""

#. type: Plain text
#: build/C/man3/getopt_long.3:38
msgid ""
"The B<getopt_long>()  function works like B<getopt>(3)  except that it also "
"accepts long options, started with two dashes.  (If the program accepts only "
"long options, then I<optstring> should be specified as an empty string "
"(\"\"), not NULL.)  Long option names may be abbreviated if the abbreviation "
"is unique or is an exact match for some defined option.  A long option may "
"take a parameter, of the form B<--arg=param> or B<--arg param>."
msgstr ""

#. type: Plain text
#: build/C/man3/getopt_long.3:45
msgid ""
"I<longopts> is a pointer to the first element of an array of I<struct "
"option> declared in I<E<lt>getopt.hE<gt>> as"
msgstr ""

#. type: Plain text
#: build/C/man3/getopt_long.3:54
#, no-wrap
msgid ""
"struct option {\n"
"    const char *name;\n"
"    int         has_arg;\n"
"    int        *flag;\n"
"    int         val;\n"
"};\n"
msgstr ""

#. type: Plain text
#: build/C/man3/getopt_long.3:58
msgid "The meanings of the different fields are:"
msgstr ""

#. type: TP
#: build/C/man3/getopt_long.3:58
#, no-wrap
msgid "I<name>"
msgstr ""

#. type: Plain text
#: build/C/man3/getopt_long.3:61
msgid "is the name of the long option."
msgstr ""

#. type: TP
#: build/C/man3/getopt_long.3:61
#, no-wrap
msgid "I<has_arg>"
msgstr ""

#. type: Plain text
#: build/C/man3/getopt_long.3:71
msgid ""
"is: B<no_argument> (or 0) if the option does not take an argument; "
"B<required_argument> (or 1) if the option requires an argument; or "
"B<optional_argument> (or 2) if the option takes an optional argument."
msgstr ""

#. type: TP
#: build/C/man3/getopt_long.3:71
#, no-wrap
msgid "I<flag>"
msgstr ""

#. type: Plain text
#: build/C/man3/getopt_long.3:92
msgid ""
"specifies how results are returned for a long option.  If I<flag> is NULL, "
"then B<getopt_long>()  returns I<val>.  (For example, the calling program "
"may set I<val> to the equivalent short option character.)  Otherwise, "
"B<getopt_long>()  returns 0, and I<flag> points to a variable which is set "
"to I<val> if the option is found, but left unchanged if the option is not "
"found."
msgstr ""

#. type: TP
#: build/C/man3/getopt_long.3:92
#, no-wrap
msgid "I<val>"
msgstr ""

#. type: Plain text
#: build/C/man3/getopt_long.3:97
msgid "is the value to return, or to load into the variable pointed to by I<flag>."
msgstr ""

#. type: Plain text
#: build/C/man3/getopt_long.3:99
msgid "The last element of the array has to be filled with zeros."
msgstr ""

#. type: Plain text
#: build/C/man3/getopt_long.3:105
msgid ""
"If I<longindex> is not NULL, it points to a variable which is set to the "
"index of the long option relative to I<longopts>."
msgstr ""

#. type: Plain text
#: build/C/man3/getopt_long.3:111
msgid ""
"Its analogue to B<getopt>(3)'s I<optopt> is \\[lq]I<argv[(optind - "
"1)]>\\[rq]."
msgstr ""

#. type: Plain text
#: build/C/man3/getopt_long.3:114 build/C/man3/getopt_long.3:131
msgid "See B<getopt>(3)."
msgstr ""

#. type: Plain text
#: build/C/man3/getopt_long.3:128
msgid ""
"B<getopt_long>()  also returns the option character when a short option is "
"recognized.  For a long option, it returns I<val> if I<flag> is NULL, and 0 "
"otherwise.  Error and -1 returns are the same as for B<getopt>(3), plus "
"\\[aq]?\\[aq] for an ambiguous match or an extraneous parameter."
msgstr ""

#. type: tbl table
#: build/C/man3/getopt_long.3:143
#, no-wrap
msgid "B<getopt_long>()"
msgstr ""

#. type: Plain text
#: build/C/man3/getopt_long.3:155
msgid ""
"The following example program illustrates the use of B<getopt_long>()  with "
"most of its features."
msgstr ""

#. type: Plain text
#: build/C/man3/getopt_long.3:237
#, no-wrap
msgid ""
"#include E<lt>getopt.hE<gt>\n"
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
"#include E<lt>unistd.hE<gt>\n"
"\\&\n"
"int\n"
"main(int argc, char *argv[])\n"
"{\n"
"    int c;\n"
"    int digit_optind = 0;\n"
"\\&\n"
"    for (;;) {\n"
"        int this_option_optind = optind ? optind : 1;\n"
"        int option_index = 0;\n"
"        static struct option long_options[] = {\n"
"            {\"add\",     required_argument, 0,  0 },\n"
"            {\"append\",  no_argument,       0,  0 },\n"
"            {\"delete\",  required_argument, 0,  0 },\n"
"            {\"verbose\", no_argument,       0,  0 },\n"
"            {\"create\",  required_argument, 0, \\[aq]c\\[aq]},\n"
"            {\"file\",    required_argument, 0,  0 },\n"
"            {0,         0,                 0,  0 }\n"
"        };\n"
"\\&\n"
"        c = getopt_long(argc, argv, \"abc:d:012\",\n"
"                        long_options, &option_index);\n"
"        if (c == -1)\n"
"            break;\n"
"\\&\n"
"        switch (c) {\n"
"        case 0:\n"
"            printf(\"option %s\", long_options[option_index].name);\n"
"            if (optarg)\n"
"                printf(\" with arg %s\", optarg);\n"
"            printf(\"\\[rs]n\");\n"
"            break;\n"
"\\&\n"
"        case \\[aq]0\\[aq]:\n"
"        case \\[aq]1\\[aq]:\n"
"        case \\[aq]2\\[aq]:\n"
"            if (digit_optind != 0 && digit_optind != this_option_optind)\n"
"              printf(\"digits occur in two different "
"argv-elements.\\[rs]n\");\n"
"            digit_optind = this_option_optind;\n"
"            printf(\"option %c\\[rs]n\", c);\n"
"            break;\n"
"\\&\n"
"        case \\[aq]a\\[aq]:\n"
"            printf(\"option a\\[rs]n\");\n"
"            break;\n"
"\\&\n"
"        case \\[aq]b\\[aq]:\n"
"            printf(\"option b\\[rs]n\");\n"
"            break;\n"
"\\&\n"
"        case \\[aq]c\\[aq]:\n"
"            printf(\"option c with value \\[aq]%s\\[aq]\\[rs]n\", optarg);\n"
"            break;\n"
"\\&\n"
"        case \\[aq]d\\[aq]:\n"
"            printf(\"option d with value \\[aq]%s\\[aq]\\[rs]n\", optarg);\n"
"            break;\n"
"\\&\n"
"        case \\[aq]?\\[aq]:\n"
"            break;\n"
"\\&\n"
"        default:\n"
"            printf(\"?? getopt returned character code 0%o ??\\[rs]n\", "
"c);\n"
"        }\n"
"    }\n"
"\\&\n"
"    if (optind E<lt> argc) {\n"
"        printf(\"non-option ARGV-elements: \");\n"
"        while (optind E<lt> argc)\n"
"            printf(\"%s \", argv[optind++]);\n"
"        printf(\"\\[rs]n\");\n"
"    }\n"
"\\&\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"
msgstr ""

#. type: Plain text
#: build/C/man3/getopt_long.3:243
msgid "B<getopt>(1), B<getopt>(3), B<getopt_long_only>(3), B<getsubopt>(3)"
msgstr ""

#. type: TH
#: build/C/man3/getopt_long_only.3:6
#, no-wrap
msgid "getopt_long_only"
msgstr ""

#. type: TH
#: build/C/man3/getopt_long_only.3:6
#, no-wrap
msgid "2025-12-07"
msgstr ""

#. type: Plain text
#: build/C/man3/getopt_long_only.3:10
msgid "getopt_long_only - parse long command-line options"
msgstr ""

#. type: Plain text
#: build/C/man3/getopt_long_only.3:21
#, no-wrap
msgid ""
"B<int getopt_long_only(int >I<argc>B<, char *>I<argv>B<[],>\n"
"B<           const char *>I<optstring>B<,>\n"
"B<           const struct option *>I<longopts>B<, int *>I<longindex>B<);>\n"
msgstr ""

#. type: Plain text
#: build/C/man3/getopt_long_only.3:31
msgid ""
"B<getopt_long_only>()  is like B<getopt_long>(3), but \\[aq]-\\[aq] as well "
"as \"--\" can indicate a long option.  If an option that starts with "
"\\[aq]-\\[aq] (not \"--\") doesn't match a long option, but does match a "
"short option, it is parsed as a short option instead."
msgstr ""

#. type: tbl table
#: build/C/man3/getopt_long_only.3:43
#, no-wrap
msgid "B<getopt_long_only>()"
msgstr ""

#. type: Plain text
#: build/C/man3/getopt_long_only.3:55
msgid "B<getopt>(1), B<getopt>(3), B<getopt_long>(3), B<getsubopt>(3)"
msgstr ""

#. type: TH
#: build/C/man2/getpagesize.2:6
#, no-wrap
msgid "getpagesize"
msgstr ""

#. type: Plain text
#: build/C/man2/getpagesize.2:9
msgid "getpagesize - get memory page size"
msgstr ""

#. type: Plain text
#: build/C/man2/getpagesize.2:17
#, no-wrap
msgid "B<int getpagesize(void);>\n"
msgstr ""

#. type: Plain text
#: build/C/man2/getpagesize.2:25
msgid "B<getpagesize>():"
msgstr ""

#. type: Plain text
#: build/C/man2/getpagesize.2:41
msgid ""
"The function B<getpagesize>()  returns the number of bytes in a memory page, "
"where \"page\" is a fixed-length block, the unit for memory allocation and "
"file mapping performed by B<mmap>(2)."
msgstr ""

#. type: Plain text
#: build/C/man2/getpagesize.2:47
msgid ""
"A user program should not hard-code a page size, neither as a literal nor "
"using the B<PAGE_SIZE> macro, because some architectures support multiple "
"page sizes."
msgstr ""

#. type: Plain text
#: build/C/man2/getpagesize.2:54
msgid ""
"This manual page is in section 2 because Alpha, SPARC, and SPARC64 all have "
"a Linux system call B<getpagesize>()  though other architectures do not, and "
"use the ELF auxiliary vector instead."
msgstr ""

#. type: Plain text
#: build/C/man2/getpagesize.2:64
msgid ""
"4.2BSD, SVr4, SUSv1.  In SUSv2 the B<getpagesize>()  call was labeled "
"LEGACY, and it was removed in POSIX.1-2001."
msgstr ""

#. type: Plain text
#: build/C/man2/getpagesize.2:67
msgid ""
"glibc 2.0 returned a constant even on architectures with multiple page "
"sizes."
msgstr ""

#. type: Plain text
#: build/C/man2/getpagesize.2:69
msgid "B<mmap>(2), B<sysconf>(3)"
msgstr ""

#. type: TH
#: build/C/man2/gettid.2:7
#, no-wrap
msgid "gettid"
msgstr ""

#. type: Plain text
#: build/C/man2/gettid.2:10
msgid "gettid - get thread identification"
msgstr ""

#. type: Plain text
#: build/C/man2/gettid.2:17
#, no-wrap
msgid ""
"B<#define _GNU_SOURCE>\n"
"B<#include E<lt>unistd.hE<gt>>\n"
msgstr ""

#. type: Plain text
#: build/C/man2/gettid.2:19
#, no-wrap
msgid "B<pid_t gettid(void);>\n"
msgstr ""

#. type: Plain text
#: build/C/man2/gettid.2:32
msgid ""
"B<gettid>()  returns the caller's thread ID (TID).  In a single-threaded "
"process, the thread ID is equal to the process ID (PID, as returned by "
"B<getpid>(2)).  In a multithreaded process, all threads have the same PID, "
"but each one has a unique TID.  For further details, see the discussion of "
"B<CLONE_THREAD> in B<clone>(2)."
msgstr ""

#. type: Plain text
#: build/C/man2/gettid.2:34
msgid "On success, returns the thread ID of the calling thread."
msgstr ""

#. type: Plain text
#: build/C/man2/gettid.2:36
msgid "This call is always successful."
msgstr ""

#. type: Plain text
#: build/C/man2/gettid.2:41
msgid "Linux 2.4.11, glibc 2.30."
msgstr ""

#. type: Plain text
#: build/C/man2/gettid.2:45
msgid ""
"The thread ID returned by this call is not the same thing as a POSIX thread "
"ID (i.e., the opaque value returned by B<pthread_self>(3))."
msgstr ""

#. type: Plain text
#: build/C/man2/gettid.2:57
msgid ""
"In a new thread group created by a B<clone>(2)  call that does not specify "
"the B<CLONE_THREAD> flag (or, equivalently, a new process created by "
"B<fork>(2)), the new process is a thread group leader, and its thread group "
"ID (the value returned by B<getpid>(2))  is the same as its thread ID (the "
"value returned by B<gettid>())."
msgstr ""

#.  .BR kcmp (2),
#.  .BR move_pages (2),
#.  .BR migrate_pages (2),
#.  .BR process_vm_readv (2),
#.  .BR ptrace (2),
#. type: Plain text
#: build/C/man2/gettid.2:75
msgid ""
"B<capget>(2), B<clone>(2), B<fcntl>(2), B<fork>(2), B<get_robust_list>(2), "
"B<getpid>(2), B<ioprio_set>(2), B<perf_event_open>(2), "
"B<sched_setaffinity>(2), B<sched_setparam>(2), B<sched_setscheduler>(2), "
"B<tgkill>(2), B<timer_create>(2)"
msgstr ""

#. type: TH
#: build/C/man3/getusershell.3:7
#, no-wrap
msgid "getusershell"
msgstr ""

#. type: Plain text
#: build/C/man3/getusershell.3:10
msgid "getusershell, setusershell, endusershell - get permitted user shells"
msgstr ""

#. type: Plain text
#: build/C/man3/getusershell.3:20
#, no-wrap
msgid ""
"B<char *getusershell(void);>\n"
"B<void setusershell(void);>\n"
"B<void endusershell(void);>\n"
msgstr ""

#. type: Plain text
#: build/C/man3/getusershell.3:30
msgid "B<getusershell>(), B<setusershell>(), B<endusershell>():"
msgstr ""

#. type: Plain text
#: build/C/man3/getusershell.3:57
msgid ""
"The B<getusershell>()  function returns the next line from the file "
"I</etc/shells>, opening the file if necessary.  The line should contain the "
"pathname of a valid user shell.  If I</etc/shells> does not exist or is "
"unreadable, B<getusershell>()  behaves as if I</bin/sh> and I</bin/csh> were "
"listed in the file."
msgstr ""

#. type: Plain text
#: build/C/man3/getusershell.3:62
msgid "The B<setusershell>()  function rewinds I</etc/shells>."
msgstr ""

#. type: Plain text
#: build/C/man3/getusershell.3:67
msgid "The B<endusershell>()  function closes I</etc/shells>."
msgstr ""

#. type: Plain text
#: build/C/man3/getusershell.3:71
msgid "The B<getusershell>()  function returns NULL on end-of-file."
msgstr ""

#. type: Plain text
#: build/C/man3/getusershell.3:73 build/C/man5/shells.5:22
msgid "I</etc/shells>"
msgstr ""

#. type: tbl table
#: build/C/man3/getusershell.3:87
#, no-wrap
msgid ""
"B<getusershell>(),\n"
"B<setusershell>(),\n"
"B<endusershell>()"
msgstr ""

#. type: tbl table
#: build/C/man3/getusershell.3:87
#, no-wrap
msgid "MT-Unsafe"
msgstr ""

#. type: Plain text
#: build/C/man3/getusershell.3:93
msgid "4.3BSD."
msgstr ""

#. type: Plain text
#: build/C/man3/getusershell.3:94
msgid "B<shells>(5)"
msgstr ""

#. type: TH
#: build/C/man2/idle.2:6
#, no-wrap
msgid "idle"
msgstr ""

#. type: Plain text
#: build/C/man2/idle.2:9
msgid "idle - make process 0 idle"
msgstr ""

#. type: Plain text
#: build/C/man2/idle.2:14
#, no-wrap
msgid "B<[[deprecated]] int idle(void);>\n"
msgstr ""

#. type: Plain text
#: build/C/man2/idle.2:22
msgid ""
"B<idle>()  is an internal system call used during bootstrap.  It marks the "
"process's pages as swappable, lowers its priority, and enters the main "
"scheduling loop.  B<idle>()  never returns."
msgstr ""

#. type: Plain text
#: build/C/man2/idle.2:28
msgid ""
"Only process 0 may call B<idle>().  Any user process, even a process with "
"superuser permission, will receive B<EPERM>."
msgstr ""

#. type: Plain text
#: build/C/man2/idle.2:31
msgid ""
"B<idle>()  never returns for process 0, and always returns -1 for a user "
"process."
msgstr ""

#. type: Plain text
#: build/C/man2/idle.2:35 build/C/man2/setup.2:37
msgid "Always, for a user process."
msgstr ""

#. type: Plain text
#: build/C/man2/idle.2:38
msgid "Removed in Linux 2.3.13."
msgstr ""

#. type: TH
#: build/C/man2/ioperm.2:5
#, no-wrap
msgid "ioperm"
msgstr ""

#. type: Plain text
#: build/C/man2/ioperm.2:8
msgid "ioperm - set port input/output permissions"
msgstr ""

#. type: Plain text
#: build/C/man2/ioperm.2:14
#, no-wrap
msgid "B<#include E<lt>sys/io.hE<gt>>\n"
msgstr ""

#. type: Plain text
#: build/C/man2/ioperm.2:16
#, no-wrap
msgid ""
"B<int ioperm(unsigned long >I<from>B<, unsigned long >I<num>B<, int "
">I<turn_on>B<);>\n"
msgstr ""

#. type: Plain text
#: build/C/man2/ioperm.2:31
msgid ""
"B<ioperm>()  sets the port access permission bits for the calling thread for "
"I<num> bits starting from port address I<from>.  If I<turn_on> is nonzero, "
"then permission for the specified bits is enabled; otherwise it is "
"disabled.  If I<turn_on> is nonzero, the calling thread must be privileged "
"(B<CAP_SYS_RAWIO>)."
msgstr ""

#. type: Plain text
#: build/C/man2/ioperm.2:40
msgid ""
"Before Linux 2.6.8, only the first 0x3ff I/O ports could be specified in "
"this manner.  For more ports, the B<iopl>(2)  system call had to be used "
"(with a I<level> argument of 3).  Since Linux 2.6.8, 65,536 I/O ports can be "
"specified."
msgstr ""

#. type: Plain text
#: build/C/man2/ioperm.2:48
msgid ""
"Permissions are inherited by the child created by B<fork>(2)  (but see "
"HISTORY).  Permissions are preserved across B<execve>(2); this is useful for "
"giving port access permissions to unprivileged programs."
msgstr ""

#. type: Plain text
#: build/C/man2/ioperm.2:52
msgid ""
"This call is mostly for the i386 architecture.  On many other architectures "
"it does not exist or will always return an error."
msgstr ""

#. type: Plain text
#: build/C/man2/ioperm.2:64
msgid "Invalid values for I<from> or I<num>."
msgstr ""

#. type: Plain text
#: build/C/man2/ioperm.2:67
msgid "(on PowerPC) This call is not supported."
msgstr ""

#. type: Plain text
#: build/C/man2/ioperm.2:74
msgid "The calling thread has insufficient privilege."
msgstr ""

#. type: Plain text
#: build/C/man2/ioperm.2:82
msgid ""
"glibc has an B<ioperm>()  prototype both in I<E<lt>sys/io.hE<gt>> and in "
"I<E<lt>sys/perm.hE<gt>>.  Avoid the latter, it is available on i386 only."
msgstr ""

#. type: Plain text
#: build/C/man2/ioperm.2:88
msgid ""
"Before Linux 2.4, permissions were not inherited by a child created by "
"B<fork>(2)."
msgstr ""

#. type: Plain text
#: build/C/man2/ioperm.2:92
msgid ""
"The I</proc/ioports> file shows the I/O ports that are currently allocated "
"on the system."
msgstr ""

#. type: Plain text
#: build/C/man2/ioperm.2:95
msgid "B<iopl>(2), B<outb>(2), B<capabilities>(7)"
msgstr ""

#. type: TH
#: build/C/man3/lockf.3:7
#, no-wrap
msgid "lockf"
msgstr ""

#. type: Plain text
#: build/C/man3/lockf.3:10
msgid "lockf - apply, test or remove a POSIX lock on an open file"
msgstr ""

#. type: Plain text
#: build/C/man3/lockf.3:18
#, no-wrap
msgid "B<int lockf(int >I<fd>B<, int >I<op>B<, off_t >I<size>B<);>\n"
msgstr ""

#. type: Plain text
#: build/C/man3/lockf.3:26
msgid "B<lockf>():"
msgstr ""

#.     || _XOPEN_SOURCE && _XOPEN_SOURCE_EXTENDED
#. type: Plain text
#: build/C/man3/lockf.3:31
#, no-wrap
msgid ""
"    _XOPEN_SOURCE E<gt>= 500\n"
"        || /* glibc E<gt>= 2.19: */ _DEFAULT_SOURCE\n"
"        || /* glibc E<lt>= 2.19: */ _BSD_SOURCE || _SVID_SOURCE\n"
msgstr ""

#. type: Plain text
#: build/C/man3/lockf.3:53
msgid ""
"Apply, test, or remove a POSIX lock on a section of an open file.  The file "
"is specified by I<fd>, a file descriptor open for writing, the action by "
"I<op>, and the section consists of byte positions I<pos>..I<pos>+I<size>-1 "
"if I<size> is positive, and I<pos>-I<size>..I<pos>-1 if I<size> is negative, "
"where I<pos> is the current file position, and if I<size> is zero, the "
"section extends from the current file position to infinity, encompassing the "
"present and future end-of-file positions.  In all cases, the section may "
"extend past current end-of-file."
msgstr ""

#. type: Plain text
#: build/C/man3/lockf.3:68
msgid ""
"On Linux, B<lockf>()  is just an interface on top of B<fcntl>(2)  locking.  "
"Many other systems implement B<lockf>()  in this way, but note that POSIX.1 "
"leaves the relationship between B<lockf>()  and B<fcntl>(2)  locks "
"unspecified.  A portable application should probably avoid mixing calls to "
"these interfaces."
msgstr ""

#. type: Plain text
#: build/C/man3/lockf.3:70
msgid "Valid operations are given below:"
msgstr ""

#. type: TP
#: build/C/man3/lockf.3:70
#, no-wrap
msgid "B<F_LOCK>"
msgstr ""

#. type: Plain text
#: build/C/man3/lockf.3:80
msgid ""
"Set an exclusive lock on the specified section of the file.  If (part of) "
"this section is already locked, the call blocks until the previous lock is "
"released.  If this section overlaps an earlier locked section, both are "
"merged.  File locks are released as soon as the process holding the locks "
"closes some file descriptor for the file.  A child process does not inherit "
"these locks."
msgstr ""

#. type: TP
#: build/C/man3/lockf.3:80
#, no-wrap
msgid "B<F_TLOCK>"
msgstr ""

#. type: Plain text
#: build/C/man3/lockf.3:86
msgid ""
"Same as B<F_LOCK> but the call never blocks and returns an error instead if "
"the file is already locked."
msgstr ""

#. type: TP
#: build/C/man3/lockf.3:86
#, no-wrap
msgid "B<F_ULOCK>"
msgstr ""

#. type: Plain text
#: build/C/man3/lockf.3:90
msgid ""
"Unlock the indicated section of the file.  This may cause a locked section "
"to be split into two locked sections."
msgstr ""

#. type: TP
#: build/C/man3/lockf.3:90
#, no-wrap
msgid "B<F_TEST>"
msgstr ""

#. type: Plain text
#: build/C/man3/lockf.3:101
msgid ""
"Test the lock: return 0 if the specified section is unlocked or locked by "
"this process; return -1, set I<errno> to B<EAGAIN> (B<EACCES> on some other "
"systems), if another process holds a lock."
msgstr ""

#. type: Plain text
#: build/C/man3/lockf.3:115
msgid ""
"The file is locked and B<F_TLOCK> or B<F_TEST> was specified, or the "
"operation is prohibited because the file has been memory-mapped by another "
"process."
msgstr ""

#. type: Plain text
#: build/C/man3/lockf.3:128
msgid ""
"I<fd> is not an open file descriptor; or I<op> is B<F_LOCK> or B<F_TLOCK> "
"and I<fd> is not a writable file descriptor."
msgstr ""

#. type: Plain text
#: build/C/man3/lockf.3:134
msgid "I<op> was B<F_LOCK> and this lock operation would cause a deadlock."
msgstr ""

#. type: Plain text
#: build/C/man3/lockf.3:144
