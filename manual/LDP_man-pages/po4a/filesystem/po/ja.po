#. type: Plain text
#: build/C/man2/move_mount.2:527
msgid ""
"B<move_mount>()  can be used to move attached mounts like the following:"
msgstr ""

#. type: Plain text
#: build/C/man2/move_mount.2:531
#, no-wrap
msgid "move_mount(AT_FDCWD, \"/a\", AT_FDCWD, \"/b\", 0);\n"
msgstr ""

#. type: Plain text
#: build/C/man2/move_mount.2:542
msgid ""
"This would move the mount object mounted on I</a> to I</b>.  The above "
"procedure is functionally equivalent to the following mount operation using "
"B<mount>(2):"
msgstr ""

#. type: Plain text
#: build/C/man2/move_mount.2:546
#, no-wrap
msgid "mount(\"/a\", \"/b\", NULL, MS_MOVE, NULL);\n"
msgstr ""

#. type: Plain text
#: build/C/man2/move_mount.2:554
msgid ""
"B<move_mount>()  can also be used in conjunction with file descriptors "
"returned from B<open_tree>(2)  or B<open>(2):"
msgstr ""

#. type: Plain text
#: build/C/man2/move_mount.2:561
#, no-wrap
msgid ""
"int fd = open_tree(AT_FDCWD, \"/mnt\", 0); /* open(\"/mnt\", O_PATH); */\n"
"move_mount(fd, \"\", AT_FDCWD, \"/mnt2\", MOVE_MOUNT_F_EMPTY_PATH);\n"
"move_mount(fd, \"\", AT_FDCWD, \"/mnt3\", MOVE_MOUNT_F_EMPTY_PATH);\n"
"move_mount(fd, \"\", AT_FDCWD, \"/mnt4\", MOVE_MOUNT_F_EMPTY_PATH);\n"
msgstr ""

#. type: Plain text
#: build/C/man2/move_mount.2:572
msgid ""
"This would move the mount object mounted at I</mnt> to I</mnt2>, then I</"
"mnt3>, and then I</mnt4>."
msgstr ""

#. type: Plain text
#: build/C/man2/move_mount.2:581
msgid ""
"If the source mount object indicated by I<from_dirfd> and I<from_path> is a "
"detached mount object, B<move_mount>()  can be used to attach it to a mount "
"point:"
msgstr ""

#. type: Plain text
#: build/C/man2/move_mount.2:592
#, no-wrap
msgid ""
"int fsfd, mntfd;\n"
"\\&\n"
"fsfd = fsopen(\"ext4\", FSOPEN_CLOEXEC);\n"
"fsconfig(fsfd, FSCONFIG_SET_STRING, \"source\", \"/dev/sda1\", 0);\n"
"fsconfig(fsfd, FSCONFIG_SET_FLAG, \"user_xattr\", NULL, 0);\n"
"fsconfig(fsfd, FSCONFIG_CMD_CREATE, NULL, NULL, 0);\n"
"mntfd = fsmount(fsfd, FSMOUNT_CLOEXEC, MOUNT_ATTR_NODEV);\n"
"move_mount(mntfd, \"\", AT_FDCWD, \"/home\", MOVE_MOUNT_F_EMPTY_PATH);\n"
msgstr ""

#. type: Plain text
#: build/C/man2/move_mount.2:604
msgid ""
"This would create a new filesystem configuration context for ext4, configure "
"it, create a detached mount object, and then attach it to I</home>.  The "
"above procedure is functionally equivalent to the following mount operation "
"using B<mount>(2):"
msgstr ""

#. type: Plain text
#: build/C/man2/move_mount.2:608
#, no-wrap
msgid "mount(\"/dev/sda1\", \"/home\", \"ext4\", MS_NODEV, \"user_xattr\");\n"
msgstr ""

#. type: Plain text
#: build/C/man2/move_mount.2:615
msgid ""
"The same operation also works with detached bind-mounts created with "
"B<open_tree>(2)  with B<OPEN_TREE_CLONE>:"
msgstr ""

#. type: Plain text
#: build/C/man2/move_mount.2:620
#, no-wrap
msgid ""
"int mntfd = open_tree(AT_FDCWD, \"/home/cyphar\", OPEN_TREE_CLONE);\n"
"move_mount(mntfd, \"\", AT_FDCWD, \"/root\", MOVE_MOUNT_F_EMPTY_PATH);\n"
msgstr ""

#. type: Plain text
#: build/C/man2/move_mount.2:632
msgid ""
"This would create a new bind-mount of I</home/cyphar> as a detached mount "
"object, and then attach it to I</root>.  The above procedure is functionally "
"equivalent to the following mount operation using B<mount>(2):"
msgstr ""

#. type: Plain text
#: build/C/man2/move_mount.2:636
#, no-wrap
msgid "mount(\"/home/cyphar\", \"/root\", NULL, MS_BIND, NULL);\n"
msgstr ""

