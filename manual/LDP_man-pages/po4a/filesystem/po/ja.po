msgstr "B<uid=E<lt>uidE<gt>>"

#. type: Plain text
#: build/C/man7/spufs.7:33
msgid "Set the user owning the mount point; the default is 0 (root)."
msgstr ""
"マウントポイントを所有するユーザーを設定する。 デフォルトは 0 (root) である。"

#. type: TP
#: build/C/man7/spufs.7:33
#, no-wrap
