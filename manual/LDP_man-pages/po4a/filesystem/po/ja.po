#, no-wrap
msgid "B<FTS_SLNONE>"
msgstr "B<FTS_SLNONE>"

#.  .El
#. type: Plain text
#: build/C/man3/fts.3:219
msgid ""
"A symbolic link with a nonexistent target.  The contents of the I<fts_statp> "
