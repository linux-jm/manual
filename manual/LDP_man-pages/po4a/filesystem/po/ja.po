#. type: Plain text
#: build/C/man2/fsconfig.2:661
msgid ""
"To illustrate the different kinds of flags that can be configured with "
"B<fsconfig>(), here are a few examples of some different filesystems being "
"created:"
msgstr ""

#. type: Plain text
#: build/C/man2/fsconfig.2:682
#, no-wrap
msgid ""
"int fsfd, mntfd;\n"
"\\&\n"
"fsfd = fsopen(\"tmpfs\", FSOPEN_CLOEXEC);\n"
"fsconfig(fsfd, FSCONFIG_SET_FLAG, \"inode64\", NULL, 0);\n"
"fsconfig(fsfd, FSCONFIG_SET_STRING, \"uid\", \"1234\", 0);\n"
"fsconfig(fsfd, FSCONFIG_SET_STRING, \"huge\", \"never\", 0);\n"
"fsconfig(fsfd, FSCONFIG_SET_FLAG, \"casefold\", NULL, 0);\n"
"fsconfig(fsfd, FSCONFIG_CMD_CREATE, NULL, NULL, 0);\n"
"mntfd = fsmount(fsfd, FSMOUNT_CLOEXEC, MOUNT_ATTR_NOEXEC);\n"
"move_mount(mntfd, \"\", AT_FDCWD, \"/tmp\", MOVE_MOUNT_F_EMPTY_PATH);\n"
"\\&\n"
"fsfd = fsopen(\"erofs\", FSOPEN_CLOEXEC);\n"
"fsconfig(fsfd, FSCONFIG_SET_STRING, \"source\", \"/dev/loop0\", 0);\n"
"fsconfig(fsfd, FSCONFIG_SET_FLAG, \"acl\", NULL, 0);\n"
"fsconfig(fsfd, FSCONFIG_SET_FLAG, \"user_xattr\", NULL, 0);\n"
"fsconfig(fsfd, FSCONFIG_CMD_CREATE_EXCL, NULL, NULL, 0);\n"
"mntfd = fsmount(fsfd, FSMOUNT_CLOEXEC, MOUNT_ATTR_NOSUID);\n"
"move_mount(mntfd, \"\", AT_FDCWD, \"/mnt\", MOVE_MOUNT_F_EMPTY_PATH);\n"
msgstr ""

#. type: Plain text
#: build/C/man2/fsconfig.2:692
msgid ""
"Usually, specifying the same parameter named by I<key> multiple times with "
"B<fsconfig>()  causes the parameter value to be replaced.  However, some "
"filesystems may have unique behavior:"
msgstr ""

#.  fsconfig(fsfd, FSCONFIG_SET_PATH, "lowerdir+", "/o/ctr/lower5", AT_FDCWD);
#.  fsconfig(fsfd, FSCONFIG_SET_PATH_EMPTY, "lowerdir+", "", lowerdirfd);
#.  Aleksa Sarai: Hopefully these will also be supported in the future.
#. type: Plain text
#: build/C/man2/fsconfig.2:713
#, no-wrap
msgid ""
"\\&\n"
"int fsfd, mntfd;\n"
"int lowerdirfd = open(\"/o/ctr/lower1\", O_DIRECTORY | O_CLOEXEC);\n"
"\\&\n"
"fsfd = fsopen(\"overlay\", FSOPEN_CLOEXEC);\n"
"/* \"lowerdir+\" appends to the lower dir stack each time */\n"
"fsconfig(fsfd, FSCONFIG_SET_FD, \"lowerdir+\", NULL, lowerdirfd);\n"
"fsconfig(fsfd, FSCONFIG_SET_STRING, \"lowerdir+\", \"/o/ctr/lower2\", 0);\n"
"fsconfig(fsfd, FSCONFIG_SET_STRING, \"lowerdir+\", \"/o/ctr/lower3\", 0);\n"
"fsconfig(fsfd, FSCONFIG_SET_STRING, \"lowerdir+\", \"/o/ctr/lower4\", 0);\n"
"fsconfig(fsfd, FSCONFIG_SET_STRING, \"xino\", \"auto\", 0);\n"
"fsconfig(fsfd, FSCONFIG_SET_STRING, \"nfs_export\", \"off\", 0);\n"
"fsconfig(fsfd, FSCONFIG_CMD_CREATE, NULL, NULL, 0);\n"
"mntfd = fsmount(fsfd, FSMOUNT_CLOEXEC, 0);\n"
"move_mount(mntfd, \"\", AT_FDCWD, \"/mnt\", MOVE_MOUNT_F_EMPTY_PATH);\n"
msgstr ""

#. type: Plain text
#: build/C/man2/fsconfig.2:724
msgid ""
"And here is an example of how B<fspick>(2)  can be used with B<fsconfig>()  "
"to reconfigure the parameters of an extant filesystem instance attached to "
"I</proc>:"
msgstr ""

#. type: Plain text
#: build/C/man2/fsconfig.2:731
#, no-wrap
msgid ""
"int fsfd = fspick(AT_FDCWD, \"/proc\", FSPICK_CLOEXEC);\n"
"fsconfig(fsfd, FSCONFIG_SET_STRING, \"hidepid\", \"ptraceable\", 0);\n"
"fsconfig(fsfd, FSCONFIG_SET_STRING, \"subset\", \"pid\", 0);\n"
"fsconfig(fsfd, FSCONFIG_CMD_RECONFIGURE, NULL, NULL, 0);\n"
msgstr ""

