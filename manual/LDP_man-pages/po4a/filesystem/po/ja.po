#. type: Plain text
#: build/C/man2/fsopen.2:304
msgid ""
"To illustrate the workflow for creating a new mount, the following is an "
"example of how to mount an B<ext4>(5)  filesystem stored on I</dev/sdb1> "
"onto I</mnt>."
msgstr ""

#. type: Plain text
#: build/C/man2/fsopen.2:319
#, no-wrap
msgid ""
"int fsfd, mntfd;\n"
"\\&\n"
"fsfd = fsopen(\"ext4\", FSOPEN_CLOEXEC);\n"
"fsconfig(fsfd, FSCONFIG_SET_FLAG, \"ro\", NULL, 0);\n"
"fsconfig(fsfd, FSCONFIG_SET_PATH, \"source\", \"/dev/sdb1\", AT_FDCWD);\n"
"fsconfig(fsfd, FSCONFIG_SET_FLAG, \"noatime\", NULL, 0);\n"
"fsconfig(fsfd, FSCONFIG_SET_FLAG, \"acl\", NULL, 0);\n"
"fsconfig(fsfd, FSCONFIG_SET_FLAG, \"user_xattr\", NULL, 0);\n"
"fsconfig(fsfd, FSCONFIG_SET_FLAG, \"iversion\", NULL, 0)\n"
"fsconfig(fsfd, FSCONFIG_CMD_CREATE, NULL, NULL, 0);\n"
"mntfd = fsmount(fsfd, FSMOUNT_CLOEXEC, MOUNT_ATTR_RELATIME);\n"
"move_mount(mntfd, \"\", AT_FDCWD, \"/mnt\", MOVE_MOUNT_F_EMPTY_PATH);\n"
msgstr ""

#. type: Plain text
#: build/C/man2/fsopen.2:336
msgid ""
"First, an ext4 configuration context is created and attached to the file "
"descriptor I<fsfd>.  Then, a series of parameters (such as the source of the "
"filesystem)  are provided using B<fsconfig>(2), followed by the filesystem "
"instance being created with B<\\%FSCONFIG_CMD_CREATE>.  B<fsmount>(2)  is "
"then used to create a new mount object attached to the file descriptor "
"I<mntfd>, which is then attached to the intended mount point using "
"B<move_mount>(2)."
msgstr ""

#. type: Plain text
#: build/C/man2/fsopen.2:340 build/C/man2/open_tree.2:573
#: build/C/man2/open_tree.2:598
msgid ""
"The above procedure is functionally equivalent to the following mount "
"operation using B<mount>(2):"
msgstr ""

#. type: Plain text
#: build/C/man2/fsopen.2:345
#, no-wrap
msgid ""
"mount(\"/dev/sdb1\", \"/mnt\", \"ext4\", MS_RELATIME,\n"
"      \"ro,noatime,acl,user_xattr,iversion\");\n"
msgstr ""

#. type: Plain text
#: build/C/man2/fsopen.2:354
msgid ""
"And here's an example of creating a mount object of an NFS server share and "
"setting a Smack security module label.  However, instead of attaching it to "
"a mount point, the program uses the mount object directly to open a file "
"from the NFS share."
msgstr ""

#. type: Plain text
#: build/C/man2/fsopen.2:369
#, no-wrap
msgid ""
"int fsfd, mntfd, fd;\n"
"\\&\n"
"fsfd = fsopen(\"nfs\", 0);\n"
"fsconfig(fsfd, FSCONFIG_SET_STRING, \"source\", \"example.com/pub\", 0);\n"
"fsconfig(fsfd, FSCONFIG_SET_STRING, \"nfsvers\", \"3\", 0);\n"
"fsconfig(fsfd, FSCONFIG_SET_STRING, \"rsize\", \"65536\", 0);\n"
"fsconfig(fsfd, FSCONFIG_SET_STRING, \"wsize\", \"65536\", 0);\n"
"fsconfig(fsfd, FSCONFIG_SET_STRING, \"smackfsdef\", \"foolabel\", 0);\n"
"fsconfig(fsfd, FSCONFIG_SET_FLAG, \"rdma\", NULL, 0);\n"
"fsconfig(fsfd, FSCONFIG_CMD_CREATE, NULL, NULL, 0);\n"
"mntfd = fsmount(fsfd, 0, MOUNT_ATTR_NODEV);\n"
"fd = openat(mntfd, \"src/linux-5.2.tar.xz\", O_RDONLY);\n"
msgstr ""

#. type: Plain text
#: build/C/man2/fsopen.2:377
msgid ""
