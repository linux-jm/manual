#. type: TP
#: build/C/man5/locale.5:117
#, no-wrap
msgid "%b"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:120
msgid "Building name."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:120 build/C/man5/locale.5:902
#, no-wrap
msgid "%s"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:123
msgid "Street or block (e.g., Japanese) name."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:123
#, no-wrap
msgid "%h"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:126
msgid "House number or designation."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:126
#, no-wrap
msgid "%N"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:132
msgid ""
"Insert an end-of-line if the previous descriptor's value was not an empty "
"string; otherwise, ignore."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:132 build/C/man5/locale.5:920
#: build/C/man5/locale.5:1024
#, no-wrap
msgid "%t"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:137
msgid ""
"Insert a space if the previous descriptor's value was not an empty string; "
"otherwise, ignore."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:137
#, no-wrap
msgid "%r"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:140
msgid "Room number, door designation."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:140 build/C/man5/locale.5:1015
#, no-wrap
msgid "%e"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:143
msgid "Floor number."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:143 build/C/man5/locale.5:1021
#, no-wrap
msgid "%C"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:148
msgid "Country designation, from the I<country_post> keyword."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:148 build/C/man5/locale.5:887
#: build/C/man5/locale.5:1012
#, no-wrap
msgid "%l"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:151
msgid "Local township within town or city (since glibc 2.24)."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:151
#, no-wrap
msgid "%z"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:154
msgid "Zip number, postal code."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:154
#, no-wrap
msgid "%T"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:157
msgid "Town, city."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:157 build/C/man5/locale.5:905
#, no-wrap
msgid "%S"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:160
msgid "State, province, or prefecture."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:160 build/C/man5/locale.5:1018
#, no-wrap
msgid "%c"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:163
msgid "Country, as taken from data record."
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:168
msgid ""
"Each field descriptor may have an \\[aq]R\\[aq] after the \\[aq]%\\[aq] to "
"specify that the information is taken from a Romanized version string of the "
"entity."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:169
#, no-wrap
msgid "I<country_name>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:175
msgid ""
"followed by the country name in the language of the current document (e.g., "
"\"Deutschland\" for the B<de_DE> locale)."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:175
#, no-wrap
msgid "I<country_post>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:179
msgid ""
"followed by the abbreviation of the country (for example, CEPT-MAILCODE "
"codes)."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:179
#, no-wrap
msgid "I<country_ab2>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:182
msgid "followed by the two-letter abbreviation of the country (ISO\\~3166)."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:182
#, no-wrap
msgid "I<country_ab3>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:185
msgid "followed by the three-letter abbreviation of the country (ISO\\~3166)."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:185
#, no-wrap
msgid "I<country_num>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:188
msgid "followed by the numeric country code (ISO\\~3166)."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:188
#, no-wrap
msgid "I<country_car>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:191
msgid "followed by the international license plate country code."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:191
#, no-wrap
msgid "I<country_isbn>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:194
msgid "followed by the ISBN code (for books)."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:194
#, no-wrap
msgid "I<lang_name>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:197
msgid "followed by the language name in the language of the current document."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:197
#, no-wrap
msgid "I<lang_ab>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:200
msgid "followed by the two-letter abbreviation of the language (ISO\\~639)."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:200
#, no-wrap
msgid "I<lang_term>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:203
msgid "followed by the three-letter abbreviation of the language (ISO\\~639-2/T)."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:203
#, no-wrap
msgid "I<lang_lib>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:211
msgid ""
"followed by the three-letter abbreviation of the language for library use "
"(ISO\\~639-2/B).  Applications should in general prefer I<lang_term> over "
"I<lang_lib>."
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:216
msgid "The B<LC_ADDRESS> definition ends with the string I<END LC_ADDRESS>."
msgstr ""

#. type: tbl table
#: build/C/man5/locale.5:216 build/C/man3/setlocale.3:42
#, no-wrap
msgid "LC_CTYPE"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:220
msgid "The definition starts with the string I<LC_CTYPE> in the first column."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:222
#, no-wrap
msgid "I<upper>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:237
msgid ""
"followed by a list of uppercase letters.  The letters B<A> through B<Z> are "
"included automatically.  Characters also specified as B<cntrl>, B<digit>, "
"B<punct>, or B<space> are not allowed."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:237
#, no-wrap
msgid "I<lower>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:252
msgid ""
"followed by a list of lowercase letters.  The letters B<a> through B<z> are "
"included automatically.  Characters also specified as B<cntrl>, B<digit>, "
"B<punct>, or B<space> are not allowed."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:252
#, no-wrap
msgid "I<alpha>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:267
msgid ""
"followed by a list of letters.  All character specified as either B<upper> "
"or B<lower> are automatically included.  Characters also specified as "
"B<cntrl>, B<digit>, B<punct>, or B<space> are not allowed."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:267
#, no-wrap
msgid "I<digit>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:277
msgid ""
"followed by the characters classified as numeric digits.  Only the digits "
"B<0> through B<9> are allowed.  They are included by default in this class."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:277
#, no-wrap
msgid "I<space>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:299
msgid ""
"followed by a list of characters defined as white-space characters.  "
"Characters also specified as B<upper>, B<lower>, B<alpha>, B<digit>, "
"B<graph>, or B<xdigit> are not allowed.  The characters B<E<lt>spaceE<gt>>, "
"B<E<lt>form-feedE<gt>>, B<E<lt>newlineE<gt>>, B<E<lt>carriage-returnE<gt>>, "
"B<E<lt>tabE<gt>>, and B<E<lt>vertical-tabE<gt>> are automatically included."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:299
#, no-wrap
msgid "I<cntrl>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:313
msgid ""
"followed by a list of control characters.  Characters also specified as "
"B<upper>, B<lower>, B<alpha>, B<digit>, B<punct>, B<graph>, B<print>, or "
"B<xdigit> are not allowed."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:313
#, no-wrap
msgid "I<punct>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:327
msgid ""
"followed by a list of punctuation characters.  Characters also specified as "
"B<upper>, B<lower>, B<alpha>, B<digit>, B<cntrl>, B<xdigit>, or the "
"B<E<lt>spaceE<gt>> character are not allowed."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:327
#, no-wrap
msgid "I<graph>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:344
msgid ""
"followed by a list of printable characters, not including the "
"B<E<lt>spaceE<gt>> character.  The characters defined as B<upper>, B<lower>, "
"B<alpha>, B<digit>, B<xdigit>, and B<punct> are automatically included.  "
"Characters also specified as B<cntrl> are not allowed."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:344
#, no-wrap
msgid "I<print>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:362
msgid ""
"followed by a list of printable characters, including the B<E<lt>spaceE<gt>> "
"character.  The characters defined as B<upper>, B<lower>, B<alpha>, "
"B<digit>, B<xdigit>, B<punct>, and the B<E<lt>spaceE<gt>> character are "
"automatically included.  Characters also specified as B<cntrl> are not "
"allowed."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:362
#, no-wrap
msgid "I<xdigit>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:379
msgid ""
"followed by a list of characters classified as hexadecimal digits.  The "
"decimal digits must be included followed by one or more set of six "
"characters in ascending order.  The following characters are included by "
"default: B<0> through B<9>, B<a> through B<f>, B<A> through B<F>."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:379
#, no-wrap
msgid "I<blank>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:388
msgid ""
"followed by a list of characters classified as B<blank>.  The characters "
"B<E<lt>spaceE<gt>> and B<E<lt>tabE<gt>> are automatically included."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:388
#, no-wrap
msgid "I<charclass>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:392
msgid ""
"followed by a list of locale-specific character class names which are then "
"to be defined in the locale."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:392
#, no-wrap
msgid "I<toupper>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:400
msgid ""
"followed by a list of mappings from lowercase to uppercase letters.  Each "
"mapping is a pair of a lowercase and an uppercase letter separated with a "
"B<,> and enclosed in parentheses."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:400
#, no-wrap
msgid "I<tolower>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:406
msgid ""
"followed by a list of mappings from uppercase to lowercase letters.  If the "
"keyword tolower is not present, the reverse of the toupper list is used."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:406
#, no-wrap
msgid "I<map totitle>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:411
msgid ""
"followed by a list of mapping pairs of characters and letters to be used in "
"titles (headings)."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:411
#, no-wrap
msgid "I<class>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:416
msgid ""
"followed by a locale-specific character class definition, starting with the "
"class name followed by the characters belonging to the class."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:416
#, no-wrap
msgid "I<charconv>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:420
msgid ""
"followed by a list of locale-specific character mapping names which are then "
"to be defined in the locale."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:420
#, no-wrap
msgid "I<outdigit>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:423
msgid "followed by a list of alternate output digits for the locale."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:423
#, no-wrap
msgid "I<map to_inpunct>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:428
msgid ""
"followed by a list of mapping pairs of alternate digits and separators for "
"input digits for the locale."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:428
#, no-wrap
msgid "I<map to_outpunct>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:433
msgid ""
"followed by a list of mapping pairs of alternate separators for output for "
"the locale."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:433
#, no-wrap
msgid "I<translit_start>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:445
msgid ""
"marks the start of the transliteration rules section.  The section can "
"contain the I<include> keyword in the beginning followed by locale-specific "
"rules and overrides.  Any rule specified in the locale file will override "
"any rule copied or included from other files.  In case of duplicate rule "
"definitions in the locale file, only the first rule is used."
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:452
msgid ""
"A transliteration rule consist of a character to be transliterated followed "
"by a list of transliteration targets separated by semicolons.  The first "
"target which can be presented in the target character set is used, if none "
"of them can be used the I<default_missing> character will be used instead."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:452
#, no-wrap
msgid "I<include>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:457
msgid ""
"in the transliteration rules section includes a transliteration rule file "
"(and optionally a repertoire map file)."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:457
#, no-wrap
msgid "I<default_missing>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:463
msgid ""
"in the transliteration rules section defines the default character to be "
"used for transliteration where none of the targets cannot be presented in "
"the target character set."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:463
#, no-wrap
msgid "I<translit_end>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:466
msgid "marks the end of the transliteration rules."
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:471
msgid "The B<LC_CTYPE> definition ends with the string I<END LC_CTYPE>."
msgstr ""

#. type: tbl table
#: build/C/man5/locale.5:471 build/C/man3/setlocale.3:41
#, no-wrap
msgid "LC_COLLATE"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:474
msgid ""
"Note that glibc does not support all POSIX-defined options, only the options "
"described below are supported (as of glibc 2.23)."
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:478
msgid "The definition starts with the string I<LC_COLLATE> in the first column."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:480
#, no-wrap
msgid "I<coll_weight_max>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:484
msgid ""
"followed by the number representing used collation levels.  This keyword is "
"recognized but ignored by glibc."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:484
#, no-wrap
msgid "I<collating-element>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:488
msgid ""
"followed by the definition of a collating-element symbol representing a "
"multicharacter collating element."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:488
#, no-wrap
msgid "I<collating-symbol>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:492
msgid ""
"followed by the definition of a collating symbol that can be used in "
"collation order statements."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:492
#, no-wrap
msgid "I<define>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:504
msgid ""
"followed by B<string> to be evaluated in an I<ifdef> B<string> / I<else> / "
"I<endif> construct."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:504
#, no-wrap
msgid "I<reorder-after>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:507
msgid "followed by a redefinition of a collation rule."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:507
#, no-wrap
msgid "I<reorder-end>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:510
msgid "marks the end of the redefinition of a collation rule."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:510
#, no-wrap
msgid "I<reorder-sections-after>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:513
msgid "followed by a script name to reorder listed scripts after."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:513
#, no-wrap
msgid "I<reorder-sections-end>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:516
msgid "marks the end of the reordering of sections."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:516
#, no-wrap
msgid "I<script>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:519
msgid "followed by a declaration of a script."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:519
#, no-wrap
msgid "I<symbol-equivalence>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:523
msgid ""
"followed by a collating-symbol to be equivalent to another defined "
"collating-symbol."
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:525
msgid "The collation rule definition starts with a line:"
msgstr ""

#. type: TP
#: build/C/man5/locale.5:525
#, no-wrap
msgid "I<order_start>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:535
msgid ""
"followed by a list of keywords chosen from B<forward>, B<backward>, or "
"B<position>.  The order definition consists of lines that describe the "
"collation order and is terminated with the keyword I<order_end>."
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:540
msgid "The B<LC_COLLATE> definition ends with the string I<END LC_COLLATE>."
msgstr ""

#. type: tbl table
#: build/C/man5/locale.5:540 build/C/man3/setlocale.3:43
#, no-wrap
msgid "LC_IDENTIFICATION"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:544
msgid ""
"The definition starts with the string I<LC_IDENTIFICATION> in the first "
"column."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:546
#, no-wrap
msgid "I<title>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:550
msgid ""
"followed by the title of the locale document (e.g., \"Maori language locale "
"for New Zealand\")."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:550
#, no-wrap
msgid "I<source>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:553
msgid "followed by the name of the organization that maintains this document."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:553
#, no-wrap
msgid "I<address>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:556
msgid "followed by the address of the organization that maintains this document."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:556
#, no-wrap
msgid "I<contact>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:560
msgid ""
"followed by the name of the contact person at the organization that "
"maintains this document."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:560
#, no-wrap
msgid "I<email>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:564
msgid ""
"followed by the email address of the person or organization that maintains "
"this document."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:564
#, no-wrap
msgid "I<tel>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:570
msgid ""
"followed by the telephone number (in international format)  of the "
"organization that maintains this document.  As of glibc 2.24, this keyword "
"is deprecated in favor of other contact methods."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:570
#, no-wrap
msgid "I<fax>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:576
msgid ""
"followed by the fax number (in international format)  of the organization "
"that maintains this document.  As of glibc 2.24, this keyword is deprecated "
"in favor of other contact methods."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:576
#, no-wrap
msgid "I<language>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:579
msgid "followed by the name of the language to which this document applies."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:579
#, no-wrap
msgid "I<territory>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:583
msgid ""
"followed by the name of the country/geographic extent to which this document "
"applies."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:583
#, no-wrap
msgid "I<audience>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:587
msgid ""
"followed by a description of the audience for which this document is "
"intended."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:587
#, no-wrap
msgid "I<application>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:591
msgid ""
"followed by a description of any special application for which this document "
"is intended."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:591
#, no-wrap
msgid "I<abbreviation>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:594
msgid "followed by the short name for provider of the source of this document."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:594
#, no-wrap
msgid "I<revision>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:597
msgid "followed by the revision number of this document."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:597
#, no-wrap
msgid "I<date>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:600
msgid "followed by the revision date of this document."
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:605
msgid ""
"In addition, for each of the categories defined by the document, there "
"should be a line starting with the keyword I<category>, followed by:"
msgstr ""

#. type: IP
#: build/C/man5/locale.5:605 build/C/man7/locale.7:217
#: build/C/man3/newlocale.3:211
#, no-wrap
msgid "(1)"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:607
msgid "a string that identifies this locale category definition,"
msgstr ""

#. type: IP
#: build/C/man5/locale.5:607 build/C/man7/locale.7:223
#: build/C/man3/newlocale.3:219
#, no-wrap
msgid "(2)"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:609
msgid "a semicolon, and"
msgstr ""

#. type: IP
#: build/C/man5/locale.5:609 build/C/man7/locale.7:226
#, no-wrap
msgid "(3)"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:613
msgid "one of the B<LC_*> identifiers."
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:618
msgid ""
"The B<LC_IDENTIFICATION> definition ends with the string I<END "
"LC_IDENTIFICATION>."
msgstr ""

#. type: tbl table
#: build/C/man5/locale.5:618 build/C/man3/setlocale.3:50
#, no-wrap
msgid "LC_MESSAGES"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:622
msgid "The definition starts with the string I<LC_MESSAGES> in the first column."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:624
#, no-wrap
msgid "I<yesexpr>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:628
msgid "followed by a regular expression that describes possible yes-responses."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:628
#, no-wrap
msgid "I<noexpr>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:632
msgid "followed by a regular expression that describes possible no-responses."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:632
#, no-wrap
msgid "I<yesstr>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:635
msgid "followed by the output string corresponding to \"yes\"."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:635
#, no-wrap
msgid "I<nostr>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:638
msgid "followed by the output string corresponding to \"no\"."
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:643
msgid "The B<LC_MESSAGES> definition ends with the string I<END LC_MESSAGES>."
msgstr ""

#. type: tbl table
#: build/C/man5/locale.5:643 build/C/man3/setlocale.3:46
#, no-wrap
msgid "LC_MEASUREMENT"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:647
msgid "The definition starts with the string I<LC_MEASUREMENT> in the first column."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:649
#, no-wrap
msgid "I<measurement>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:653
msgid ""
"followed by number identifying the standard used for measurement.  The "
"following values are recognized:"
msgstr ""

#. type: TP
#: build/C/man5/locale.5:654 build/C/man5/locale.5:724
#: build/C/man5/locale.5:738 build/C/man5/locale.5:775
#: build/C/man5/locale.5:1226 build/C/man1/localedef.1:305
#, no-wrap
msgid "B<1>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:657
msgid "Metric."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:657 build/C/man5/locale.5:743
#: build/C/man5/locale.5:781 build/C/man5/locale.5:1229
#, no-wrap
msgid "B<2>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:660
msgid "US customary measurements."
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:666
msgid "The B<LC_MEASUREMENT> definition ends with the string I<END LC_MEASUREMENT>."
msgstr ""

#. type: tbl table
#: build/C/man5/locale.5:666 build/C/man3/setlocale.3:53
#, no-wrap
msgid "LC_MONETARY"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:670
msgid "The definition starts with the string I<LC_MONETARY> in the first column."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:672
#, no-wrap
msgid "I<int_curr_symbol>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:679
msgid ""
"followed by the international currency symbol.  This must be a 4-character "
"string containing the international currency symbol as defined by the "
"ISO\\~4217 standard (three characters) followed by a separator."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:679
#, no-wrap
msgid "I<currency_symbol>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:682
msgid "followed by the local currency symbol."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:682
#, no-wrap
msgid "I<mon_decimal_point>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:686
msgid ""
"followed by the single-character string that will be used as the decimal "
"delimiter when formatting monetary quantities."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:686
#, no-wrap
msgid "I<mon_thousands_sep>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:690
msgid ""
"followed by the single-character string that will be used as a group "
"separator when formatting monetary quantities."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:690
#, no-wrap
msgid "I<mon_grouping>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:697
msgid ""
"followed by a sequence of integers separated by semicolons that describe the "
"formatting of monetary quantities.  See I<grouping> below for details."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:697
#, no-wrap
msgid "I<positive_sign>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:701
msgid ""
"followed by a string that is used to indicate a positive sign for monetary "
"quantities."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:701
#, no-wrap
msgid "I<negative_sign>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:705
msgid ""
"followed by a string that is used to indicate a negative sign for monetary "
"quantities."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:705
#, no-wrap
msgid "I<int_frac_digits>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:710
msgid ""
"followed by the number of fractional digits that should be used when "
"formatting with the I<int_curr_symbol>."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:710
#, no-wrap
msgid "I<frac_digits>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:715
msgid ""
"followed by the number of fractional digits that should be used when "
"formatting with the I<currency_symbol>."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:715
#, no-wrap
msgid "I<p_cs_precedes>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:720
msgid ""
"followed by an integer that indicates the placement of I<currency_symbol> "
"for a nonnegative formatted monetary quantity:"
msgstr ""

#. type: TP
#: build/C/man5/locale.5:721 build/C/man5/locale.5:735
#: build/C/man5/locale.5:769 build/C/man1/localedef.1:302
#, no-wrap
msgid "B<0>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:724
msgid "the symbol succeeds the value."
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:727
msgid "the symbol precedes the value."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:728
#, no-wrap
msgid "I<p_sep_by_space>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:734
msgid ""
