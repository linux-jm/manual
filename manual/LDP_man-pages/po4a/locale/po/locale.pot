#. type: Plain text
#: build/C/man5/repertoiremap.5:42
msgid "The mapping section ends with the string I<END CHARIDS>."
msgstr ""

#. type: Plain text
#: build/C/man5/repertoiremap.5:50
msgid "Repertoire maps are deprecated in favor of Unicode code points."
