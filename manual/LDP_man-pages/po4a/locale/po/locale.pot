#. type: Plain text
#: build/C/man3/nl_langinfo.3:335
msgid ""
"The following program sets the character type and the numeric locale "
"according to the environment and queries the terminal character set and the "
"radix character."
msgstr ""

#. type: Plain text
#: build/C/man3/nl_langinfo.3:354
#, no-wrap
msgid ""
"#include E<lt>langinfo.hE<gt>\n"
"#include E<lt>locale.hE<gt>\n"
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
"\\&\n"
"int\n"
"main(void)\n"
"{\n"
"    setlocale(LC_CTYPE, \"\");\n"
"    setlocale(LC_NUMERIC, \"\");\n"
"\\&\n"
"    printf(\"%s\\[rs]n\", nl_langinfo(CODESET));\n"
"    printf(\"%s\\[rs]n\", nl_langinfo(RADIXCHAR));\n"
"\\&\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"
msgstr ""

