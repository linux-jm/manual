#. type: Plain text
#: build/C/man3/nl_langinfo.3:286
msgid "If I<item> is not valid, a pointer to an empty string is returned."
msgstr ""

#. type: Plain text
#: build/C/man3/nl_langinfo.3:302
msgid ""
