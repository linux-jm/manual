msgid ""
"When invoked without arguments, B<locale> displays the current locale "
"settings for each locale category (see B<locale>(5)), based on the settings "
"of the environment variables that control the locale (see B<locale>(7)).  "
"Values for variables set in the environment are printed without double "
"quotes, implied values are printed with double quotes."
msgstr ""

#. type: Plain text
#: build/C/man1/locale.1:47
msgid ""
"If either the B<-a> or the B<-m> option (or one of their long-format "
"equivalents) is specified, the behavior is as follows:"
msgstr ""

#. type: TP
#: build/C/man1/locale.1:47
#, no-wrap
msgid "B<--all-locales>"
msgstr ""

#. type: TQ
#: build/C/man1/locale.1:49
#, no-wrap
msgid "B<-a>"
msgstr ""

#. type: Plain text
#: build/C/man1/locale.1:57
msgid ""
"Display a list of all available locales.  The B<-v> option causes the "
"B<LC_IDENTIFICATION> metadata about each locale to be included in the "
"output."
msgstr ""

#. type: TP
#: build/C/man1/locale.1:57
#, no-wrap
msgid "B<--charmaps>"
msgstr ""

#. type: TQ
#: build/C/man1/locale.1:59
#, no-wrap
msgid "B<-m>"
msgstr ""

#. type: Plain text
#: build/C/man1/locale.1:64
msgid ""
"Display the available charmaps (character set description files).  To "
"display the current character set for the locale, use I<locale\\ -c\\ "
"charmap>."
msgstr ""

#. type: Plain text
#: build/C/man1/locale.1:79
msgid ""
"The B<locale> command can also be provided with one or more arguments, which "
"are the names of locale keywords (for example, I<date_fmt>, "
"I<ctype-class-names>, I<yesexpr>, or I<decimal_point>)  or locale categories "
"(for example, B<LC_CTYPE> or B<LC_TIME>).  For each argument, the following "
"is displayed:"
msgstr ""

#. type: Plain text
#: build/C/man1/locale.1:81
msgid "For a locale keyword, the value of that keyword to be displayed."
msgstr ""

#. type: Plain text
#: build/C/man1/locale.1:84
msgid ""
"For a locale category, the values of all keywords in that category are "
"displayed."
msgstr ""

#. type: Plain text
#: build/C/man1/locale.1:86
msgid "When arguments are supplied, the following options are meaningful:"
msgstr ""

#. type: TP
#: build/C/man1/locale.1:86
#, no-wrap
msgid "B<--category-name>"
msgstr ""

#. type: Plain text
#: build/C/man1/locale.1:93
msgid ""
"For a category name argument, write the name of the locale category on a "
"separate line preceding the list of keyword values for that category."
msgstr ""

#. type: Plain text
#: build/C/man1/locale.1:97
msgid ""
"For a keyword name argument, write the name of the locale category for this "
"keyword on a separate line preceding the keyword value."
msgstr ""

#. type: Plain text
#: build/C/man1/locale.1:102
msgid ""
"This option improves readability when multiple name arguments are "
"specified.  It can be combined with the B<-k> option."
msgstr ""

#. type: TP
#: build/C/man1/locale.1:102
#, no-wrap
msgid "B<--keyword-name>"
msgstr ""

#. type: TQ
#: build/C/man1/locale.1:104
#, no-wrap
msgid "B<-k>"
msgstr ""

#. type: Plain text
#: build/C/man1/locale.1:109
msgid ""
"For each keyword whose value is being displayed, include also the name of "
"that keyword, so that the output has the format:"
msgstr ""

#. type: Plain text
#: build/C/man1/locale.1:113
#, no-wrap
msgid "I<keyword>=\\[dq]I<value>\\[dq]\n"
msgstr ""

#. type: Plain text
#: build/C/man1/locale.1:119
msgid "The B<locale> command also knows about the following options:"
msgstr ""

#. type: TQ
#: build/C/man1/locale.1:121 build/C/man1/localedef.1:217
#, no-wrap
msgid "B<-v>"
msgstr ""

#. type: Plain text
#: build/C/man1/locale.1:125
msgid ""
"Display additional information for some command-line option and argument "
"combinations."
msgstr ""

#. type: Plain text
#: build/C/man1/locale.1:130
msgid "Display a summary of command-line options and arguments and exit."
msgstr ""

#. type: Plain text
#: build/C/man1/locale.1:133
msgid "Display a short usage message and exit."
msgstr ""

#. type: Plain text
#: build/C/man1/locale.1:138
msgid "Display the program version and exit."
msgstr ""

#. type: TP
#: build/C/man1/locale.1:139 build/C/man5/locale.5:1248
#: build/C/man7/locale.7:341 build/C/man1/localedef.1:332
#, no-wrap
msgid "I</usr/lib/locale/locale-archive>"
msgstr ""

#. type: Plain text
#: build/C/man1/locale.1:142 build/C/man5/locale.5:1251
#: build/C/man7/locale.7:344 build/C/man1/localedef.1:335
msgid "Usual default locale archive location."
msgstr ""

#. type: TP
#: build/C/man1/locale.1:142 build/C/man5/locale.5:1251
#: build/C/man1/localedef.1:326
#, no-wrap
msgid "I</usr/share/i18n/locales>"
msgstr ""

#. type: Plain text
#: build/C/man1/locale.1:145 build/C/man5/locale.5:1254
#: build/C/man1/localedef.1:329
msgid "Usual default path for locale definition files."
msgstr ""

#. type: Plain text
#: build/C/man1/locale.1:166
#, no-wrap
msgid ""
"$B< locale>;\n"
"LANG=en_US.UTF-8\n"
"LC_CTYPE=\"en_US.UTF-8\"\n"
"LC_NUMERIC=\"en_US.UTF-8\"\n"
"LC_TIME=\"en_US.UTF-8\"\n"
"LC_COLLATE=\"en_US.UTF-8\"\n"
"LC_MONETARY=\"en_US.UTF-8\"\n"
"LC_MESSAGES=\"en_US.UTF-8\"\n"
"LC_PAPER=\"en_US.UTF-8\"\n"
"LC_NAME=\"en_US.UTF-8\"\n"
"LC_ADDRESS=\"en_US.UTF-8\"\n"
"LC_TELEPHONE=\"en_US.UTF-8\"\n"
"LC_MEASUREMENT=\"en_US.UTF-8\"\n"
"LC_IDENTIFICATION=\"en_US.UTF-8\"\n"
"LC_ALL=\n"
msgstr ""

#. type: Plain text
#: build/C/man1/locale.1:169
#, no-wrap
msgid ""
"$B< locale date_fmt>;\n"
"%a %b %e %H:%M:%S %Z %Y\n"
msgstr ""

#. type: Plain text
#: build/C/man1/locale.1:172
#, no-wrap
msgid ""
"$B< locale -k date_fmt>;\n"
"date_fmt=\"%a %b %e %H:%M:%S %Z %Y\"\n"
msgstr ""

#. type: Plain text
#: build/C/man1/locale.1:176
#, no-wrap
msgid ""
"$B< locale -ck date_fmt>;\n"
"LC_TIME\n"
"date_fmt=\"%a %b %e %H:%M:%S %Z %Y\"\n"
msgstr ""

#. type: Plain text
#: build/C/man1/locale.1:183
#, no-wrap
msgid ""
"$B< locale LC_TELEPHONE>;\n"
"+%c (%a) %l\n"
"(%a) %l\n"
"11\n"
"1\n"
"UTF-8\n"
msgstr ""

#. type: Plain text
#: build/C/man1/locale.1:190
#, no-wrap
msgid ""
"$B< locale -k LC_TELEPHONE>;\n"
"tel_int_fmt=\"+%c (%a) %l\"\n"
"tel_dom_fmt=\"(%a) %l\"\n"
"int_select=\"11\"\n"
"int_prefix=\"1\"\n"
"telephone-codeset=\"UTF-8\"\n"
msgstr ""

#. type: Plain text
#: build/C/man1/locale.1:206
msgid ""
"The following example compiles a custom locale from the I<./wrk> directory "
"with the B<localedef>(1)  utility under the I<$HOME/.locale> directory, then "
"tests the result with the B<date>(1)  command, and then sets the environment "
"variables B<LOCPATH> and B<LANG> in the shell profile file so that the "
"custom locale will be used in the subsequent user sessions:"
msgstr ""

#. type: Plain text
#: build/C/man1/locale.1:213
#, no-wrap
msgid ""
"$B< mkdir -p $HOME/.locale>;\n"
"$B< I18NPATH=./wrk/ localedef -f UTF-8 -i fi_SE "
"$HOME/.locale/fi_SE.UTF-8>;\n"
"$B< LOCPATH=$HOME/.locale LC_ALL=fi_SE.UTF-8 date>;\n"
"$B< echo \\[dq]export LOCPATH=\\[rs]$HOME/.locale\\[dq] E<gt>E<gt> "
"$HOME/.bashrc>;\n"
"$B< echo \\[dq]export LANG=fi_SE.UTF-8\\[dq] E<gt>E<gt> $HOME/.bashrc>;\n"
msgstr ""

#. type: Plain text
#: build/C/man1/locale.1:218
msgid "B<localedef>(1), B<charmap>(5), B<locale>(5), B<locale>(7)"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:11
msgid "locale - describes a locale definition file"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:17
msgid ""
"The B<locale> definition file contains all the information that the "
"B<localedef>(1)  command needs to convert it into the binary locale "
"database."
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:23
msgid ""
"The definition files consist of sections which each describe a locale "
"category in detail.  See B<locale>(7)  for additional details for these "
"categories."
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:26
msgid ""
"The locale definition file starts with a header that may consist of the "
"following keywords:"
msgstr ""

#. type: TP
#: build/C/man5/locale.5:26 build/C/man5/repertoiremap.5:22
#, no-wrap
msgid "I<escape_char>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:32
msgid ""
"is followed by a character that should be used as the escape-character for "
"the rest of the file to mark characters that should be interpreted in a "
"special way.  It defaults to the backslash (\\[rs])."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:32 build/C/man5/repertoiremap.5:17
#, no-wrap
msgid "I<comment_char>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:37
msgid ""
"is followed by a character that will be used as the comment-character for "
"the rest of the file.  It defaults to the number sign (#)."
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:53
msgid ""
"The locale definition has one part for each locale category.  Each part can "
"be copied from another existing locale or can be defined from scratch.  If "
"the category should be copied, the only valid keyword in the definition is "
"I<copy> followed by the name of the locale in double quotes which should be "
"copied.  The exceptions for this rule are B<LC_COLLATE> and B<LC_CTYPE> "
"where a I<copy> statement can be followed by locale-specific rules and "
"selected overrides."
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:57
msgid ""
"When defining a locale or a category from scratch, an existing system- "
"provided locale definition file should be used as a reference to follow "
"common glibc conventions."
msgstr ""

#. type: SS
#: build/C/man5/locale.5:57
#, no-wrap
msgid "Locale category sections"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:59
msgid "The following category sections are defined by POSIX:"
msgstr ""

#. type: TQ
#: build/C/man5/locale.5:61 build/C/man7/locale.7:68
#: build/C/man3/setlocale.3:197 build/C/man3/setlocale.3:219
#, no-wrap
msgid "B<LC_CTYPE>"
msgstr ""

#. type: TQ
#: build/C/man5/locale.5:63 build/C/man7/locale.7:55
#: build/C/man3/setlocale.3:195 build/C/man3/setlocale.3:217
#, no-wrap
msgid "B<LC_COLLATE>"
msgstr ""

#. type: TQ
#: build/C/man5/locale.5:67 build/C/man7/locale.7:103
#: build/C/man3/setlocale.3:199 build/C/man3/setlocale.3:221
#, no-wrap
msgid "B<LC_MONETARY>"
msgstr ""

#. type: TQ
#: build/C/man5/locale.5:69 build/C/man7/locale.7:158
#: build/C/man3/setlocale.3:201 build/C/man3/setlocale.3:223
#, no-wrap
msgid "B<LC_NUMERIC>"
msgstr ""

#. type: TQ
#: build/C/man5/locale.5:71 build/C/man7/locale.7:199
#: build/C/man3/setlocale.3:203 build/C/man3/setlocale.3:225
#, no-wrap
msgid "B<LC_TIME>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:74
msgid ""
"In addition, since glibc 2.2, the GNU C library supports the following "
"nonstandard categories:"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:76
msgid "B<LC_ADDRESS>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:78
msgid "B<LC_IDENTIFICATION>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:80
msgid "B<LC_MEASUREMENT>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:82
msgid "B<LC_NAME>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:84
msgid "B<LC_PAPER>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:86
msgid "B<LC_TELEPHONE>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:90
msgid "See B<locale>(7)  for a more detailed description of each category."
msgstr ""

#. type: tbl table
#: build/C/man5/locale.5:90 build/C/man3/setlocale.3:37
#, no-wrap
msgid "LC_ADDRESS"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:94
msgid "The definition starts with the string I<LC_ADDRESS> in the first column."
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:96 build/C/man5/locale.5:222 build/C/man5/locale.5:480
#: build/C/man5/locale.5:546 build/C/man5/locale.5:624
#: build/C/man5/locale.5:649 build/C/man5/locale.5:672
#: build/C/man5/locale.5:951 build/C/man5/locale.5:983
#: build/C/man5/locale.5:1000 build/C/man5/locale.5:1052
msgid "The following keywords are allowed:"
msgstr ""

#. type: TP
#: build/C/man5/locale.5:96
#, no-wrap
msgid "I<postal_fmt>"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:101
msgid ""
"followed by a string containing field descriptors that define the format "
"used for postal addresses in the locale.  The following field descriptors "
"are recognized:"
msgstr ""

#. type: TP
#: build/C/man5/locale.5:102
#, no-wrap
msgid "%n"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:108
msgid ""
"Person's name, possibly constructed with the B<LC_NAME> I<name_fmt> keyword "
"(since glibc 2.24)."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:108 build/C/man5/locale.5:1006
#, no-wrap
msgid "%a"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:111
msgid "Care of person, or organization."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:111 build/C/man5/locale.5:875
#, no-wrap
msgid "%f"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:114
msgid "Firm name."
msgstr ""

#. type: TP
#: build/C/man5/locale.5:114 build/C/man5/locale.5:908
#, no-wrap
msgid "%d"
msgstr ""

#. type: Plain text
#: build/C/man5/locale.5:117
msgid "Department name."
