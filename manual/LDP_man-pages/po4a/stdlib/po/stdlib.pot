"B<strtoull>(),\n"
"B<strtouq>()"
msgstr ""

#. type: Plain text
#: build/C/man3/strtoul.3:170
msgid ""
"In locales other than the \"C\" locale, other strings may be accepted.  (For "
"example, the thousands separator of the current locale may be supported.)"
msgstr ""

