#. type: Plain text
#: build/C/man3/getentropy.3:18
#, no-wrap
msgid ""
"B<int getentropy(>size_t length;\n"
"B<               void >I<buffer>B<[>I<length>B<], size_t >I<length>B<);>\n"
msgstr ""

