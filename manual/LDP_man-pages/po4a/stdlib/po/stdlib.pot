"B<             int32_t *restrict >I<result>B<);>\n"
"B<int srandom_r(unsigned int >I<seed>B<, struct random_data *>I<buf>B<);>\n"
msgstr ""

#. type: Plain text
#: build/C/man3/random_r.3:27
#, no-wrap
msgid ""
