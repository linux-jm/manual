msgstr ""

#. type: Plain text
#: build/C/man3/getloadavg.3:18
#, no-wrap
msgid "B<int getloadavg(double >I<loadavg[]>B<, int >I<n>B<);>\n"
msgstr ""

#. type: Plain text
#: build/C/man3/getloadavg.3:26
