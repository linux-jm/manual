#: build/C/man3/rewinddir.3:55
msgid ""
"B<closedir>(3), B<opendir>(3), B<readdir>(3), B<scandir>(3), B<seekdir>(3), "
"B<telldir>(3)"
msgstr ""

#. type: TH
#: build/C/man3/scandir.3:15
#, no-wrap
msgid "scandir"
msgstr ""

#. type: Plain text
#: build/C/man3/scandir.3:19
msgid ""
"scandir, scandirat, alphasort, versionsort - scan a directory for matching "
"entries"
msgstr ""

#. type: Plain text
#: build/C/man3/scandir.3:31
#, no-wrap
msgid ""
"B<int scandir(const char *restrict >I<dirp>B<,>\n"
"B<            struct dirent ***restrict >I<namelist>B<,>\n"
"B<            typeof(int (const struct dirent *)) *>I<filter>B<,>\n"
"B<typeof(int (const struct dirent **, const struct dirent **))>\n"
"B<                *>I<compar>B<);>\n"
msgstr ""

#. type: Plain text
#: build/C/man3/scandir.3:34
#, no-wrap
msgid ""
"B<int alphasort(const struct dirent **>I<a>B<, const struct dirent "
"**>I<b>B<);>\n"
"B<int versionsort(const struct dirent **>I<a>B<, const struct dirent "
"**>I<b>B<);>\n"
msgstr ""

#. type: Plain text
#: build/C/man3/scandir.3:37
#, no-wrap
msgid ""
"B<#include E<lt>fcntl.hE<gt>>          /* Definition of AT_* constants */\n"
"B<#include E<lt>dirent.hE<gt>>\n"
msgstr ""

#. type: Plain text
#: build/C/man3/scandir.3:43
#, no-wrap
msgid ""
"B<int scandirat(int >I<dirfd>B<, const char *restrict >I<dirp>B<,>\n"
"B<            struct dirent ***restrict >I<namelist>B<,>\n"
"B<            typeof(int (const struct dirent *)) *>I<filter>B<,>\n"
"B<typeof(int (const struct dirent **, const struct dirent **))>\n"
"B<                *>I<compar>B<);>\n"
msgstr ""

#. type: Plain text
#: build/C/man3/scandir.3:52
msgid "B<scandir>(), B<alphasort>():"
msgstr ""

#. type: Plain text
#: build/C/man3/scandir.3:58
msgid "B<versionsort>():"
msgstr ""

#. type: Plain text
#: build/C/man3/scandir.3:60 build/C/man3/scandir.3:65
#, no-wrap
msgid "    _GNU_SOURCE\n"
msgstr ""

#. type: Plain text
#: build/C/man3/scandir.3:63
msgid "B<scandirat>():"
msgstr ""

#. type: Plain text
#: build/C/man3/scandir.3:90
msgid ""
"The B<scandir>()  function scans the directory I<dirp>, calling I<filter>()  "
"on each directory entry.  Entries for which I<filter>()  returns nonzero are "
"stored in strings allocated via B<malloc>(3), sorted using B<qsort>(3)  with "
"the comparison function I<compar>(), and collected in array I<namelist> "
"which is allocated via B<malloc>(3).  If I<filter> is NULL, all entries are "
"selected."
msgstr ""

#. type: Plain text
#: build/C/man3/scandir.3:105
msgid ""
"The B<alphasort>()  and B<versionsort>()  functions can be used as the "
"comparison function I<compar>().  The former sorts directory entries using "
"B<strcoll>(3), the latter using B<strverscmp>(3)  on the strings "
"I<(*a)-E<gt>d_name> and I<(*b)-E<gt>d_name>."
msgstr ""

#. type: SS
#: build/C/man3/scandir.3:105
#, no-wrap
msgid "scandirat()"
msgstr ""

#. type: Plain text
#: build/C/man3/scandir.3:111
msgid ""
"The B<scandirat>()  function operates in exactly the same way as "
"B<scandir>(), except for the differences described here."
msgstr ""

#. type: Plain text
#: build/C/man3/scandir.3:121
msgid ""
"If I<dirp> is relative, then it is interpreted relative to the directory "
"referred to by the file descriptor I<dirfd> (rather than relative to the "
"current working directory of the calling process, as is done by B<scandir>()  "
"for a relative pathname)."
msgstr ""

#. type: Plain text
#: build/C/man3/scandir.3:133
msgid ""
"If I<dirp> is relative and I<dirfd> is the special value B<AT_FDCWD>, then "
"I<dirp> is interpreted relative to the current working directory of the "
"calling process (like B<scandir>())."
msgstr ""

#. type: Plain text
#: build/C/man3/scandir.3:139
msgid "If I<dirp> is absolute, then I<dirfd> is ignored."
msgstr ""

#. type: Plain text
#: build/C/man3/scandir.3:144
msgid "See B<openat>(2)  for an explanation of the need for B<scandirat>()."
msgstr ""

#. type: Plain text
#: build/C/man3/scandir.3:152
msgid ""
"The B<scandir>()  function returns the number of directory entries "
"selected.  On error, -1 is returned, with I<errno> set to indicate the "
"error."
msgstr ""

#. type: Plain text
#: build/C/man3/scandir.3:160
msgid ""
"The B<alphasort>()  and B<versionsort>()  functions return an integer less "
"than, equal to, or greater than zero if the first argument is considered to "
"be respectively less than, equal to, or greater than the second."
msgstr ""

#. type: Plain text
#: build/C/man3/scandir.3:170
msgid ""
"(B<scandirat>())  I<dirp> is relative but I<dirfd> is neither B<AT_FDCWD> "
"nor a valid file descriptor."
msgstr ""

#. type: Plain text
#: build/C/man3/scandir.3:175
msgid "The path in I<dirp> does not exist."
msgstr ""

#. type: Plain text
#: build/C/man3/scandir.3:183
msgid "The path in I<dirp> is not a directory."
msgstr ""

#. type: Plain text
#: build/C/man3/scandir.3:190
msgid ""
"(B<scandirat>())  I<dirp> is relative and I<dirfd> is a file descriptor "
"referring to a file other than a directory."
msgstr ""

