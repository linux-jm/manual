#. type: Plain text
#: build/C/man2/kexec_load.2:11
msgid "kexec_load, kexec_file_load - load a new kernel for later execution"
msgstr ""
"kexec_load, kexec_file_load - 新しいカーネルを後で実行するためにロードする"

#. type: Plain text
#: build/C/man2/kexec_load.2:19
#, fuzzy, no-wrap
#| msgid ""
#| "B<#include E<lt>linux/futex.hE<gt>>\n"
#| "B<#include E<lt>sys/types.hE<gt>>\n"
