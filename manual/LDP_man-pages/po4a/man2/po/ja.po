"    { u64 time;     }   /* if PERF_SAMPLE_TIME set */\n"
"    { u64 id;       }   /* if PERF_SAMPLE_ID set */\n"
"    { u64 stream_id;}   /* if PERF_SAMPLE_STREAM_ID set  */\n"
