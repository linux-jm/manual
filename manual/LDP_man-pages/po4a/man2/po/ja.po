#.  commit a43eec304259a6c637f4014a6d4767159b6a3aa3
#. type: Plain text
#: build/C/man2/perf_event_open.2:571
msgid ""
"This is used to generate raw sample data from BPF.  BPF programs can write "
"to this event using B<bpf_perf_event_output> helper."
msgstr ""

#. type: TP
#: build/C/man2/perf_event_open.2:571
#, fuzzy, no-wrap
#| msgid "B<PERF_COUNT_HW_REF_CPU_CYCLES> (since Linux 3.3)"
msgid "B<PERF_COUNT_SW_CGROUP_SWITCHES> (since Linux 5.13)"
msgstr "B<PERF_COUNT_HW_REF_CPU_CYCLES> (Linux 3.3 以降)"

#.  commit d0d1dd628527c77db2391ce0293c1ed344b2365f
#. type: Plain text
#: build/C/man2/perf_event_open.2:577
msgid ""
"This counts context switches to a task in a different cgroup.  In other "
"words, if the next task is in the same cgroup, it won't count the switch."
msgstr ""

#. type: Plain text
#: build/C/man2/perf_event_open.2:590
msgid ""
"If I<type> is B<PERF_TYPE_TRACEPOINT>, then we are measuring kernel "
"tracepoints.  The value to use in I<config> can be obtained from under "
"debugfs I<tracing/events/*/*/id> if ftrace is enabled in the kernel."
msgstr ""

#. type: Plain text
