#. type: Plain text
#: build/C/man2/splice.2:313
#, no-wrap
msgid ""
"\\&\n"
"#define _GNU_SOURCE\n"
"#define _FILE_OFFSET_BITS 64\n"
"#include E<lt>err.hE<gt>\n"
"#include E<lt>fcntl.hE<gt>\n"
"#include E<lt>stdint.hE<gt>\n"
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
"#include E<lt>sys/types.hE<gt>\n"
"#include E<lt>unistd.hE<gt>\n"
"\\&\n"
"int\n"
"main(void)\n"
"{\n"
"        int         fd;\n"
"        int         pfd[2];\n"
"        off_t       off;\n"
"        [[gnu::nonstring]]\n"
"\tconst char  s[12] = \"Hello, world\";\n"
"\\&\n"
"        fd = open(\"out\", O_WRONLY | O_CREAT | O_EXCL, 0666);\n"
"        if (fd == -1)\n"
"                err(EXIT_FAILURE, \"open\");\n"
"\\&\n"
"        if (pipe(pfd) == -1)\n"
"                err(EXIT_FAILURE, \"pipe\");\n"
"\\&\n"
"        if (write(pfd[1], s, sizeof(s)) != sizeof(s))\n"
"                err(EXIT_FAILURE, \"write\");\n"
"        if (close(pfd[1]) == -1)\n"
"                err(EXIT_FAILURE, \"close\");\n"
"\\&\n"
"        off = 10;\n"
"        if (splice(pfd[0], NULL, fd, &off, sizeof(s), 0) != sizeof(s))\n"
"                err(EXIT_FAILURE, \"splice\");\n"
"        if (close(pfd[0]) == -1)\n"
"                err(EXIT_FAILURE, \"close\");\n"
"\\&\n"
"        printf(\"New offset is %jd\\[rs]n\", (intmax_t) off);\n"
"\\&\n"
"        if (close(fd) == -1)\n"
"                err(EXIT_FAILURE, \"close\");\n"
"        exit(EXIT_SUCCESS);\n"
"}\n"
msgstr ""

