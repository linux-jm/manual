#. type: TH
#: build/C/man5/group.5:5
#, no-wrap
msgid "group"
msgstr ""

#. type: TH
#: build/C/man5/group.5:5
#, no-wrap
msgid "2025-05-17"
msgstr ""

#. type: Plain text
#: build/C/man5/group.5:8
msgid "group - user group file"
msgstr ""

#. type: Plain text
#: build/C/man5/group.5:13
msgid ""
"The I</etc/group> file is a text file that defines the groups on the "
"system.  There is one entry per line, with the following format:"
msgstr ""

#. type: Plain text
#: build/C/man5/group.5:17
#, no-wrap
msgid "group_name:password:GID:user_list\n"
msgstr ""

#. type: Plain text
#: build/C/man5/group.5:21
msgid "The fields are as follows:"
msgstr ""

#. type: TP
#: build/C/man5/group.5:21
#, no-wrap
msgid "I<group_name>"
msgstr ""

#. type: Plain text
#: build/C/man5/group.5:24
msgid "the name of the group."
msgstr ""

#. type: TP
#: build/C/man5/group.5:24 build/C/man5/passwd.5:74
#, no-wrap
msgid "I<password>"
msgstr ""

#. type: Plain text
#: build/C/man5/group.5:28
msgid ""
"the (encrypted) group password.  If this field is empty, no password is "
"needed."
msgstr ""

#. type: TP
#: build/C/man5/group.5:28 build/C/man5/passwd.5:86
#, no-wrap
msgid "I<GID>"
msgstr ""

#. type: Plain text
#: build/C/man5/group.5:31
msgid "the numeric group ID."
msgstr ""

#. type: TP
#: build/C/man5/group.5:31
#, no-wrap
msgid "I<user_list>"
msgstr ""

#. type: Plain text
#: build/C/man5/group.5:34
msgid "a list of the usernames that are members of this group, separated by commas."
msgstr ""

#. type: Plain text
#: build/C/man5/group.5:42
msgid ""
"As the 4.2BSD B<initgroups>(3)  man page says: no one seems to keep "
"I</etc/group> up-to-date."
msgstr ""

#. type: Plain text
#: build/C/man5/group.5:53
msgid ""
"B<chgrp>(1), B<gpasswd>(1), B<groups>(1), B<login>(1), B<newgrp>(1), "
"B<sg>(1), B<getgrent>(3), B<getgrnam>(3), B<gshadow>(5), B<passwd>(5), "
"B<vigr>(8)"
msgstr ""

#. type: TH
#: build/C/man3/initgroups.3:7
#, no-wrap
msgid "initgroups"
msgstr ""

#. type: Plain text
#: build/C/man3/initgroups.3:10
msgid "initgroups - initialize the supplementary group access list"
msgstr ""

#. type: Plain text
#: build/C/man3/initgroups.3:19
#, no-wrap
msgid "B<int initgroups(const char *>I<user>B<, gid_t >I<group>B<);>\n"
msgstr ""

#. type: Plain text
#: build/C/man3/initgroups.3:27
msgid "B<initgroups>():"
msgstr ""

#. type: Plain text
#: build/C/man3/initgroups.3:47
msgid ""
"The B<initgroups>()  function initializes the group access list by reading "
"the group database I</etc/group> and using all groups of which I<user> is a "
"member.  The additional group I<group> is also added to the list."
msgstr ""

#. type: Plain text
#: build/C/man3/initgroups.3:51
msgid "The I<user> argument must be non-NULL."
msgstr ""

#. type: Plain text
#: build/C/man3/initgroups.3:58
msgid ""
"The B<initgroups>()  function returns 0 on success.  On error, -1 is "
"returned, and I<errno> is set to indicate the error."
msgstr ""

#. type: Plain text
#: build/C/man3/initgroups.3:62
