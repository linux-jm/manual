#. type: Plain text
#: build/C/man3/getpwent_r.3:219
#, no-wrap
msgid ""
"#define _GNU_SOURCE\n"
"#include E<lt>pwd.hE<gt>\n"
"#include E<lt>stdint.hE<gt>\n"
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
"\\&\n"
"#define BUFLEN 4096\n"
"\\&\n"
"int\n"
"main(void)\n"
"{\n"
"    struct passwd pw;\n"
"    struct passwd *pwp;\n"
"    char buf[BUFLEN];\n"
"    int i;\n"
"\\&\n"
"    setpwent();\n"
"    for (;;) {\n"
"        i = getpwent_r(&pw, buf, sizeof(buf), &pwp);\n"
"        if (i)\n"
"            break;\n"
"        printf(\"%s (%jd)\\[rs]tHOME %s\\[rs]tSHELL %s\\[rs]n\", "
"pwp-E<gt>pw_name,\n"
"               (intmax_t) pwp-E<gt>pw_uid, pwp-E<gt>pw_dir, "
"pwp-E<gt>pw_shell);\n"
"    }\n"
"    endpwent();\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"
msgstr ""

