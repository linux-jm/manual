#. type: Plain text
#: build/C/man3/getgrouplist.3:117
msgid ""
"The program below displays the group list for the user named in its first "
"command-line argument.  The second command-line argument specifies the "
"I<ngroups> value to be supplied to B<getgrouplist>().  The following shell "
"session shows examples of the use of this program:"
msgstr ""

#. type: Plain text
#: build/C/man3/getgrouplist.3:128
#, no-wrap
msgid ""
"$B< ./a.out cecilia 0>\n"
"getgrouplist() returned -1\n"
"ngroups = 3\n"
"$B< ./a.out cecilia 3>\n"
"ngroups = 3\n"
"16 (dialout)\n"
"33 (video)\n"
"100 (users)\n"
msgstr ""

#. type: SS
#: build/C/man3/getgrouplist.3:130
#, no-wrap
msgid "Program source"
msgstr ""

#. type: Plain text
#: build/C/man3/getgrouplist.3:194
#, no-wrap
msgid ""
"#include E<lt>errno.hE<gt>\n"
"#include E<lt>grp.hE<gt>\n"
"#include E<lt>pwd.hE<gt>\n"
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
"\\&\n"
"int\n"
"main(int argc, char *argv[])\n"
"{\n"
"    int            ngroups;\n"
"    gid_t          *groups;\n"
"    struct group   *gr;\n"
"    struct passwd  *pw;\n"
"\\&\n"
"    if (argc != 3) {\n"
"        fprintf(stderr, \"Usage: %s E<lt>userE<gt> "
"E<lt>ngroupsE<gt>\\[rs]n\", argv[0]);\n"
"        exit(EXIT_FAILURE);\n"
"    }\n"
"\\&\n"
"    ngroups = atoi(argv[2]);\n"
"\\&\n"
"    groups = malloc(sizeof(*groups) * ngroups);\n"
"    if (groups == NULL) {\n"
"        perror(\"malloc\");\n"
"        exit(EXIT_FAILURE);\n"
"    }\n"
"\\&\n"
"    /* Fetch passwd structure (contains first group ID for user).  */\n"
"\\&\n"
"    errno = 0;\n"
"    pw = getpwnam(argv[1]);\n"
"    if (pw == NULL) {\n"
"        if (errno)\n"
"            perror(\"getpwnam\");\n"
"        else\n"
"            fprintf(stderr, \"no such user\\[rs]n\");\n"
"        exit(EXIT_FAILURE);\n"
"    }\n"
"\\&\n"
"    /* Retrieve group list.  */\n"
"\\&\n"
"    if (getgrouplist(argv[1], pw-E<gt>pw_gid, groups, &ngroups) == -1) {\n"
"        fprintf(stderr, \"getgrouplist() returned -1\\[rs]n\");\n"
"        fprintf(stderr, \"ngroups = %d\\[rs]n\", ngroups);\n"
"        exit(EXIT_FAILURE);\n"
"    }\n"
"\\&\n"
"    /* Display list of retrieved groups, along with group names.  */\n"
"\\&\n"
"    fprintf(stderr, \"ngroups = %d\\[rs]n\", ngroups);\n"
"    for (int j = 0; j E<lt> ngroups; j++) {\n"
"        printf(\"%d\", groups[j]);\n"
"        gr = getgrgid(groups[j]);\n"
"        if (gr != NULL)\n"
"            printf(\" (%s)\", gr-E<gt>gr_name);\n"
"        printf(\"\\[rs]n\");\n"
"    }\n"
"\\&\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"
msgstr ""

