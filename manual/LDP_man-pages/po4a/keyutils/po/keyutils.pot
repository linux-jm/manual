"B<key_serial_t add_key(>size_t size;\n"
"B<                     const char *>I<type>B<, const char "
"*>I<description>B<,>\n"
"B<                     const void >I<payload>B<[>I<size>B<], size_t "
">I<size>B<,>\n"
"B<                     key_serial_t >I<keyring>B<);>\n"
msgstr ""

