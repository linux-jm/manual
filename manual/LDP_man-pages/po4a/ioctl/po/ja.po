#. type: TH
#: build/C/man2/ioctl_pipe.2:6
#, no-wrap
msgid "ioctl_pipe"
msgstr ""

#. type: Plain text
#: build/C/man2/ioctl_pipe.2:9
msgid "ioctl_pipe - ioctl() operations for general notification mechanism"
msgstr ""

#. type: Plain text
#: build/C/man2/ioctl_pipe.2:13
#, fuzzy, no-wrap
