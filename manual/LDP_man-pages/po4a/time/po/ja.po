"B<int futimens(int >I<fd>B<, const struct timespec >I<times>B<[_Nullable 2]);>\n"
msgstr ""
"B<int utimensat(int >I<dirfd>B<, const char *>I<path>B<,>\n"
"B<              const struct timespec >I<times>B<[_Nullable 2], int >I<flags>B<);>\n"
"B<int futimens(int >I<fd>B<, const struct timespec >I<times>B<[_Nullable 2]);>\n"

