msgstr "\\w'# Zone\\0\\0'u +\\w'Europe/Zurich\\0\\0'u +\\w'0:29:45.50\\0\\0'u +\\w'RULES\\0\\0'u +\\w'FORMAT\\0\\0'u"

#. type: Plain text
