msgstr ""

#. type: TP
#: build/C/man8/tzselect.8:100 build/C/man3/tzset.3:249
#, no-wrap
msgid "B<TZDIR>"
msgstr ""

#. type: Plain text
#: build/C/man8/tzselect.8:104
msgid ""
"Name of the directory containing timezone data files (default: "
"B</usr/share/zoneinfo>)."
msgstr ""

#. type: TP
#: build/C/man8/tzselect.8:105
#, no-wrap
msgid "I<TZDIR>B</iso3166.tab>"
msgstr ""

#. type: Plain text
#: build/C/man8/tzselect.8:108
msgid "Table of ISO 3166 2-letter country codes and country names."
msgstr ""

#. type: TP
#: build/C/man8/tzselect.8:108
#, no-wrap
msgid "I<TZDIR>B</zone1970.tab>"
msgstr ""

#. type: Plain text
#: build/C/man8/tzselect.8:112
msgid ""
"Table of country codes, latitude and longitude, timezones, and descriptive "
"comments."
msgstr ""

#. type: TP
#: build/C/man8/tzselect.8:112
#, no-wrap
msgid "I<TZDIR>B</>I<TZ>"
msgstr ""

#. type: Plain text
#: build/C/man8/tzselect.8:115
msgid "Timezone data file for timezone I<TZ>."
msgstr ""

#. type: Plain text
#: build/C/man8/tzselect.8:118
msgid ""
"The exit status is zero if a timezone was successfully obtained from the "
"user, nonzero otherwise."
msgstr ""

#. type: Plain text
#: build/C/man8/tzselect.8:120
msgid "newctime(3), tzfile(5), zdump(8), zic(8)"
msgstr ""

#. type: Plain text
#: build/C/man8/tzselect.8:123
