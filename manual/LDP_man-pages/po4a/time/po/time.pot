#. type: Plain text
#: build/C/man3/strftime.3:739
msgid "The program below can be used to experiment with B<strftime>()."
msgstr ""

#. type: Plain text
#: build/C/man3/strftime.3:743
msgid ""
"Some examples of the result string produced by the glibc implementation of "
"B<strftime>()  are as follows:"
msgstr ""

#. type: Plain text
#: build/C/man3/strftime.3:752
#, no-wrap
msgid ""
"$B< ./a.out \\[aq]%m\\[aq]>\n"
"Result string is \"11\"\n"
"$B< ./a.out \\[aq]%5m\\[aq]>\n"
"Result string is \"00011\"\n"
"$B< ./a.out \\[aq]%_5m\\[aq]>\n"
"Result string is \"   11\"\n"
msgstr ""

#. type: Plain text
#: build/C/man3/strftime.3:789
#, no-wrap
msgid ""
"#include E<lt>stdio.hE<gt>\n"
"#include E<lt>stdlib.hE<gt>\n"
"#include E<lt>time.hE<gt>\n"
"\\&\n"
"int\n"
"main(int argc, char *argv[])\n"
"{\n"
"    char outstr[200];\n"
"    time_t t;\n"
"    struct tm *tmp;\n"
"\\&\n"
"    if (argc != 2) {\n"
"        fprintf(stderr, \"Usage: %s: E<lt>format-stringE<gt>\\[rs]n\", "
"argv[0]);\n"
"        exit(EXIT_FAILURE);\n"
"    }\n"
"\\&\n"
"    t = time(NULL);\n"
"    tmp = localtime(&t);\n"
"    if (tmp == NULL) {\n"
"        perror(\"localtime\");\n"
"        exit(EXIT_FAILURE);\n"
"    }\n"
"\\&\n"
"    if (strftime(outstr, sizeof(outstr), argv[1], tmp) == 0) {\n"
"        fprintf(stderr, \"strftime returned 0\");\n"
"        exit(EXIT_FAILURE);\n"
"    }\n"
"\\&\n"
"    printf(\"Result string is \\[rs]\"%s\\[rs]\"\\[rs]n\", outstr);\n"
"    exit(EXIT_SUCCESS);\n"
"}\n"
msgstr ""

