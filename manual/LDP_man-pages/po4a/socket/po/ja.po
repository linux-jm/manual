#. type: Plain text
#: build/C/man7/bpf-helpers.7:2410 build/C/man7/bpf-helpers.7:2454
msgid "Look for an IPv6 socket."
msgstr ""

#. type: Plain text
#: build/C/man7/bpf-helpers.7:2420 build/C/man7/bpf-helpers.7:2464
