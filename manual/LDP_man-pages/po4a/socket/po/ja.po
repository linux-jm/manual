msgstr "I<stream_socket>B< = socket(AF_VSOCK, SOCK_STREAM, 0);>"

#. type: Plain text
#: build/C/man7/mctp.7:25
msgid ""
"Linux implements the Management Component Transport Protocol (MCTP), "
"specified by DMTF spec DSP0236, currently at version 1.  This is a "
"connectionless protocol, typically used between devices within a server "
"system.  Message reliability and ordering are not guaranteed, but message "
"boundaries are preserved."
msgstr ""

#. type: Plain text
#: build/C/man7/mctp.7:35
msgid ""
"The API for MCTP messaging uses a standard sockets interface, using the "
"B<sendto>(2)  and B<recvfrom>(2)  classes of system calls to transfer "
"messages.  Messages may be fragmented into packets before transmission, and "
"reassembled at the remote endpoint.  This fragmentation and reassembly is "
"transparent to user space."
msgstr ""

#. type: SS
#: build/C/man7/mctp.7:35 build/C/man7/vsock.7:63
#, no-wrap
msgid "Address format"
msgstr ""

#. type: Plain text
#: build/C/man7/mctp.7:45
msgid ""
"MCTP addresses (also referred to as EIDs, or Endpoint Identifiers)  are "
"single-byte values, typed as I<mctp_eid_t>.  Packets between a local and "
"remote endpoint are identified by the source and destination EIDs, plus a "
"three-bit tag value."
msgstr ""

#. type: Plain text
#: build/C/man7/mctp.7:50
msgid ""
"Addressing data is passed in socket system calls through a I<sockaddr_mctp> "
"structure, defined as:"
msgstr ""

#. type: Plain text
#: build/C/man7/mctp.7:68
#, no-wrap
msgid ""
"typedef uint8_t        mctp_eid_t;\n"
"\\&\n"
"struct mctp_addr {\n"
"    mctp_eid_t         s_addr;\n"
"};\n"
"\\&\n"
"struct sockaddr_mctp {\n"
"    unsigned short     smctp_family;  /* = AF_MCTP */\n"
"    uint16_t           __smctp_pad0;\n"
"    int                smctp_network; /* local network identifier */\n"
"    struct mctp_addr   smctp_addr;    /* EID */\n"
"    uint8_t            smctp_type;    /* message type byte */\n"
"    uint8_t            smctp_tag;     /* tag value & owner */\n"
"    uint8_t            __smctp_pad1;\n"
"};\n"
msgstr ""

#. type: SS
#: build/C/man7/mctp.7:70
#, no-wrap
msgid "Sending messages"
msgstr ""

#. type: Plain text
#: build/C/man7/mctp.7:80
msgid ""
"Messages can be transmitted using the B<sendto>(2)  and B<sendmsg>(2)  "
"system calls, by providing a I<sockaddr_mctp> structure describing the "
"addressing parameters."
msgstr ""

#. type: Plain text
#: build/C/man7/mctp.7:101
#, no-wrap
msgid ""
"ssize_t               n;\n"
"const char            *buf;\n"
"struct sockaddr_mctp  addr;\n"
"\\&\n"
"/* unused fields must be zero */\n"
"memset(&addr, 0, sizeof(addr));\n"
"\\&\n"
"/* set message destination */\n"
"addr.smctp_family = AF_MCTP;\n"
"addr.smctp_network = 0;\n"
"addr.smctp_addr.s_addr = 8;  /* remote EID */\n"
"addr.smctp_tag = MCTP_TAG_OWNER;\n"
"addr.smctp_type = MYPROGRAM_MCTP_TYPE_ECHO;  /* example type */\n"
"\\&\n"
"buf = \"hello, world!\"\n"
"\\&\n"
"n = sendto(sd, buf, 13, 0,\n"
"           (struct sockaddr *) &addr, sizeof(addr));\n"
msgstr ""

#. type: Plain text
#: build/C/man7/mctp.7:116
msgid ""
"Here, the sender owns the message tag; so B<MCTP_TAG_OWNER> is used as the "
"tag data.  The kernel will allocate a specific tag value for this message.  "
"If no tag is available, B<sendto>(2)  will return an error, with errno set "
"to B<EBUSY>.  This allocated tag remains associated with the socket, so that "
"any replies to the sent message will be received by the same socket."
msgstr ""

#. type: Plain text
#: build/C/man7/mctp.7:120
msgid "Sending a MCTP message requires the B<CAP_NET_RAW> capability."
msgstr ""

#. type: SS
#: build/C/man7/mctp.7:120
#, no-wrap
msgid "Receiving messages"
msgstr ""

#. type: Plain text
#: build/C/man7/mctp.7:126
msgid ""
"Messages can be received using the B<recvfrom>(2)  and B<recvmsg>(2)  system "
"calls."
msgstr ""

#. type: Plain text
#: build/C/man7/mctp.7:137
#, no-wrap
msgid ""
"char                  buf[13];\n"
"socklen_t             addrlen;\n"
"struct sockaddr_mctp  addr;\n"
"\\&\n"
"addrlen = sizeof(addr);\n"
"\\&\n"
"n = recvfrom(sd, buf, sizeof(buf), 0,\n"
"             (struct sockaddr *) &addr, &addrlen);\n"
msgstr ""

#. type: Plain text
#: build/C/man7/mctp.7:146
msgid ""
"In order to receive an incoming message, the receiver will need to either "
"have previously sent a message to the same endpoint, or performed a "
"B<bind>(2)  to receive all messages of a certain type:"
msgstr ""

#. type: Plain text
#: build/C/man7/mctp.7:157
#, no-wrap
msgid ""
"struct sockaddr_mctp  addr;\n"
"\\&\n"
"addr.smctp_family = AF_MCTP;\n"
"addr.smctp_network = MCTP_NET_ANY;\n"
"addr.smctp_addr.s_addr = MCTP_ADDR_ANY;\n"
"addr.smctp_type = MYPROGRAM_MCTP_TYPE_ECHO;  /* our 'echo' type */\n"
"\\&\n"
"int rc = bind(sd, (struct sockaddr *) &addr, sizeof(addr));\n"
msgstr ""

#. type: Plain text
#: build/C/man7/mctp.7:166
msgid ""
"This call requires the B<CAP_NET_BIND_SERVICE> capability, and will result "
"in the socket receiving all messages sent to locally-assigned EIDs, for the "
"specified message type."
msgstr ""

#. type: Plain text
#: build/C/man7/mctp.7:178
msgid ""
"After a B<recvfrom>(2)  or B<recvmsg>(2)  returns a success condition, the "
"provided address argument will be populated with the sender's network and "
"EID, as well as the tag value used for the message.  Any reply to this "
"message should pass the same address and tag value (with the TO bit "
"cleared)  to indicate that is is directed to the same remote endpoint."
msgstr ""

