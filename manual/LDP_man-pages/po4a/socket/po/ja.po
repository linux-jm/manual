#~ msgid ""
#~ "Enables nonblocking operation; if the operation would block, B<EAGAIN> or "
#~ "B<EWOULDBLOCK> is returned (this can also be enabled using the "
#~ "B<O_NONBLOCK> flag with the B<F_SETFL> B<fcntl>(2))."
