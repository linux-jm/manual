.TH sigset 3 2026\-02\-08 "Linux man\-pages (未リリース)" 
.SH 名前
sigset, sighold, sigrelse, sigignore \- System V 版シグナル API
.SH ライブラリ
標準 C ライブラリ (\fIlibc\fP,\~\fI\-lc\fP)
.SH 書式
.nf
\fB#include <signal.h>\fP
.P
\fBtypedef typeof(void (int))  *sighandler_t;\fP
.P
\fB[[deprecated]] sighandler_t sigset(int \fP\fIsig\fP\fB, sighandler_t \fP\fIdisp\fP\fB);\fP
.P
\fB[[deprecated]] int sighold(int \fP\fIsig\fP\fB);\fP
\fB[[deprecated]] int sigrelse(int \fP\fIsig\fP\fB);\fP
