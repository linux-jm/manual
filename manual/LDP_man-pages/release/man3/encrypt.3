.SH 歴史
Removed in glibc 2.28.
.P
Because they employ the DES block cipher, which is no longer considered
secure, these functions were removed from glibc.  Applications should switch
to a modern cryptography library, such as \fBlibgcrypt\fP.
.TP 
\fBencrypt\fP()
.TQ
\fBsetkey\fP()
POSIX.1\-2001, SUS, SVr4.
.SS "Availability in glibc"
\fBcrypt\fP(3) を参照。
.SS "Features in glibc"
glibc 2.2 では、これらの関数は DES アルゴリズムを使う。
.SH 例
.\" SRC BEGIN (encrypt.c)
.EX
#define _XOPEN_SOURCE
#include <crypt.h>
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
\&
int
main(void)
{
    char key[64];
    char orig[9] = "eggplant";
    char buf[64];
    char txt[9];
\&
    for (size_t i = 0; i < 64; i++) {
        key[i] = rand() & 1;
    }
\&
    for (size_t i = 0; i < 8; i++) {
        for (size_t j = 0; j < 8; j++) {
            buf[i * 8 + j] = orig[i] >> j & 1;
        }
        setkey(key);
    }
    printf("Before encrypting: %s\[rs]n", orig);
\&
    encrypt(buf, 0);
    for (size_t i = 0; i < 8; i++) {
        for (size_t j = 0, txt[i] = \[aq]\[rs]0\[aq]; j < 8; j++) {
            txt[i] |= buf[i * 8 + j] << j;
        }
        txt[8] = \[aq]\[rs]0\[aq];
    }
    printf("After encrypting:  %s\[rs]n", txt);
\&
    encrypt(buf, 1);
    for (size_t i = 0; i < 8; i++) {
        for (size_t j = 0, txt[i] = \[aq]\[rs]0\[aq]; j < 8; j++) {
            txt[i] |= buf[i * 8 + j] << j;
        }
        txt[8] = \[aq]\[rs]0\[aq];
    }
    printf("After decrypting:  %s\[rs]n", txt);
    exit(EXIT_SUCCESS);
}
.EE
