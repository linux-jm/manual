.SH 例
以下の例は \fIgcc example.c \-o example\fP でコンパイルできる。 これはエイリアスデータベースにある全ての名前をダンプする。
.P
.\" SRC BEGIN (setaliasent.c)
.EX
#include <aliases.h>
#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
\&
int
main(void)
{
    struct aliasent *al;
\&
    setaliasent();
    for (;;) {
        al = getaliasent();
        if (al == NULL)
            break;
        printf("Name: %s\[rs]n", al\->alias_name);
    }
    if (errno) {
        perror("reading alias");
        exit(EXIT_FAILURE);
    }
    endaliasent();
    exit(EXIT_SUCCESS);
}
.EE
.\" SRC END
