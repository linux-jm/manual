.SH 例
.\" SRC BEGIN (strncat.c)
.EX
#include <stdcountof.h>
#include <stdio.h>
#include <string.h>
#include <utmp.h>
\&
void print_ut_user(struct utmp *ut);
\&
void
print_ut_user(struct utmp *ut)
{
	char  buf[countof(ut\->ut_user) + 1];
\&
	strcpy(buf, "");
	strncat(buf, ut\->ut_user, countof(ut\->ut_user));
	puts(buf);
}
.EE
.\" SRC END
