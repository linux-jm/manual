.TH bswap 3 2026\-02\-16 "Linux man\-pages (未リリース)" 
.SH 名前
bswap_16, bswap_32, bswap_64 \- reverse order of bytes
.SH ライブラリ
標準 C ライブラリ (\fIlibc\fP,\~\fI\-lc\fP)
.SH 書式
.nf
\fB#include <byteswap.h>\fP
.P
\fBuint16_t bswap_16(uint16_t \fP\fIx\fP\fB);\fP
\fBuint32_t bswap_32(uint32_t \fP\fIx\fP\fB);\fP
\fBuint64_t bswap_64(uint64_t \fP\fIx\fP\fB);\fP
.fi
.SH 説明
These functions return a value in which the order of the bytes in their 2\-,
4\-, or 8\-byte arguments is reversed.
.SH 返り値
These functions return the value of their argument with the bytes reversed.
.SH エラー
これらの関数は常に成功する。
.SH 標準規格
GNU.
.SH 例
The program below swaps the bytes of the 8\-byte integer supplied as its
command\-line argument.  The following shell session demonstrates the use of
the program:
.P
.in +4n
.EX
$\fB ./a.out 0x0123456789abcdef\fP;
0x123456789abcdef ==> 0xefcdab8967452301
.EE
.in
.SS プログラムのソース
.\" SRC BEGIN (bswap.c)
\&
.EX
#include <byteswap.h>
#include <inttypes.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
\&
int
main(int argc, char *argv[])
{
    uint64_t x;
\&
    if (argc != 2) {
        fprintf(stderr, "Usage: %s <num>\[rs]n", argv[0]);
        exit(EXIT_FAILURE);
    }
\&
    x = strtoull(argv[1], NULL, 0);
    printf("%#w64x ==> %#w64x\[rs]n", x, bswap_64(x));
\&
    exit(EXIT_SUCCESS);
}
.EE
.\" SRC END
.SH 関連項目
